    })

    local function strafeRoot(plr)
        local char = plr and plr.Character
        if not char then return nil end
        return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    end

    local function strafeAlive(plr)
        local char = plr and plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        return hum and hum.Health > 0 and strafeRoot(plr) ~= nil
    end

    local function strafeNearestMouse()
        local mouse = UserInputService:GetMouseLocation()
        local best, bestD = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player and strafeAlive(plr) then
                local root = strafeRoot(plr)
                local screen, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local d = (Vector2.new(screen.X, screen.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                    if d < bestD then best, bestD = plr, d end
                end
            end
        end
        return best
    end

    local function strafeKeyUp()
        v.motionKeyUp(v.StrafeStates)
    end

    local function strafeKeyPump()
        v.motionKeyPump(v.StrafeStates, v.MOTION_KEY_GAP)
    end

    local warnedNoApi = false

    local function strafeDesyncOn()
        if v.StrafeDesyncOwned then return true end
        if not (v.DesyncApi and v.DesyncApi.start) or not v.DesyncApi.start() then
            if not warnedNoApi then
                warnedNoApi = true
                Library:Notify('ur executor cant run csync, turn it off to move for real', 6)
            end
            return false
        end
        warnedNoApi = false
        v.StrafeDesyncOwned = true
        return true
    end

    local function strafeDesyncOff()
        if not v.StrafeDesyncOwned then return end
        v.StrafeDesyncOwned = false
        if v.DesyncApi then
            pcall(function() v.DesyncApi.sync() end)

            if not (v.DesyncToggle and v.DesyncToggle.Value) then
                pcall(function() v.DesyncApi.stop() end)
            end
        end
    end

    local function strafeVisualOn(point)
        if not (Toggles.strafevisualize and Toggles.strafevisualize.Value) then
            return
        end
        v.StrafeVisualOwned = true
        v.desyncPosition = point
    end

    local function strafeVisualOff()
        if not v.StrafeVisualOwned then return end
        v.StrafeVisualOwned = false
        if not (v.DesyncToggle and v.DesyncToggle.Value) then
            pcall(function() v.visualizerDestroy() end)
            v.desyncPosition = nil
        end
    end

    local function strafeStop()
        v.StrafeStates.Target = nil
        v.StrafeStates.Point = nil
        strafeKeyUp()
        strafeVisualOff()
        strafeDesyncOff()

        if v.StrafeStickyOwned then
            v.StrafeStickyOwned = false
            if v.stickyRelease then v.stickyRelease() end
        end

        local back = v.StrafeStates.ReturnCF
        v.StrafeStates.ReturnCF = nil
        if back and Toggles.strafereturn and Toggles.strafereturn.Value then
            task.defer(function()
                local root = GetRootPart()
                if not root then return end
                pcall(function()
                    root.CFrame = back
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                end)
            end)
        end
    end
    v.strafeStop = strafeStop

    Toggles.strafetoggle:OnChanged(function(value)
        if not value then strafeStop() end
    end)

    local function strafePoint(tRoot)
        return v.motionSolve(v.StrafeStates, tRoot.Position, {
            mode = (Options.strafemode and Options.strafemode.Value) or "orbit",
            speed = (Options.strafespeed and Options.strafespeed.Value) or 50,
            height = (Options.strafeheight and Options.strafeheight.Value) or 3,
            distance = (Options.strafedistance and Options.strafedistance.Value) or 8,
            reroll = (Options.strafereroll and Options.strafereroll.Value) or 0.12,
        })
    end

    RunService.Heartbeat:Connect(function()
        if not (Toggles.strafetoggle and Toggles.strafetoggle.Value) then
            if v.StrafeStates.Target or v.StrafeDesyncOwned or v.StrafeVisualOwned
                or v.StrafeStickyOwned then
                strafeStop()
            end
            return
        end

        local myRoot = GetRootPart()
        if not myRoot then return end

        local target
        if v.StrafeLocked and v.StrafeLocked.Parent and strafeAlive(v.StrafeLocked) then
            target = v.StrafeLocked
        else
            if v.StrafeLocked and not v.StrafeLocked.Parent then
                v.StrafeLocked = nil
            end
            target = strafeNearestMouse()
        end
        if not target then
            v.StrafeStates.Target = nil
            strafeKeyUp()

            v.StrafeStates.ReturnCF = nil
            return
        end
        v.StrafeStates.Target = target

        local tRoot = strafeRoot(target)
        if not tRoot then return end

        local point, faceTarget = strafePoint(tRoot)
        v.StrafeStates.Point = point

        local cf
        if faceTarget then
            cf = CFrame.new(point, tRoot.Position)
        else
            cf = CFrame.new(point) * myRoot.CFrame.Rotation
        end

        local csync = Toggles.strafecsync and Toggles.strafecsync.Value
        local wroteFake = false

        if csync and strafeDesyncOn() then

            v.StrafeStates.ReturnCF = nil
            pcall(function() v.DesyncApi.move(cf) end)

            strafeKeyPump()
            wroteFake = true
        end

        if not wroteFake then

            if not v.StrafeStates.ReturnCF then
                v.StrafeStates.ReturnCF = myRoot.CFrame
            end
            strafeDesyncOff()

            strafeKeyUp()
            pcall(function()
                myRoot.CFrame = cf
                myRoot.AssemblyLinearVelocity = Vector3.zero
                myRoot.RotVelocity = Vector3.zero
            end)
        end


table.sort(EspMaterialValues)

_G.espMaterialChoice = "Neon"
_G.espMaterialColor = Color3.new(1, 1, 1)

local espCache = {}
local espStripped = Instance.new("Folder")
espStripped.Name = "_EspMaterialStripped"

local function EspOn()
    return Toggles.espmaterial and Toggles.espmaterial.Value
end

local function EspToMaterial(name)
    local ok, mat = pcall(function() return Enum.Material[name] end)
    if ok and mat then return mat end
    return Enum.Material.Plastic
end

local function EspIsHairAccessory(obj)
    if obj:IsA("Accessory") and obj.AccessoryType == Enum.AccessoryType.Hair then return true end
    return string.find(string.lower(obj.Name), "hair") ~= nil
end

local function EspIsHairPart(part)
    local acc = part:FindFirstAncestorWhichIsA("Accoutrement")
    if not acc then return false end
    return EspIsHairAccessory(acc)
end

local function EspStrip(char)
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Shirt") or obj:IsA("Pants") or obj:IsA("ShirtGraphic") or obj:IsA("CharacterMesh") then
            obj.Parent = espStripped
        elseif obj:IsA("Accoutrement") and not EspIsHairAccessory(obj) then
            obj.Parent = espStripped
        end
    end
end

local function EspColorFor(plr)
    local base = _G.espMaterialColor
    if not plr then return base end
    local ok, same = pcall(function() return IsOnSameTeam(plr) end)
    if not ok then return base end
    local pre
    if same and Toggles.teamcolorsenabled and Toggles.teamcolorsenabled.Value then pre = "team"
    elseif (not same) and Toggles.enemycolorsenabled and Toggles.enemycolorsenabled.Value then pre = "enemy" end
    local o = pre and Options[pre .. "espmaterialcolor"]
    return (o and o.Value) or base
end

local function EspApplyChar(char)
    if not char then return end
    EspStrip(char)
    local mat = EspToMaterial(_G.espMaterialChoice)
    local color = EspColorFor(Players:GetPlayerFromCharacter(char))
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") and not part:FindFirstAncestorWhichIsA("Tool") and not EspIsHairPart(part) then
            if not espCache[part] then
                espCache[part] = { part.Material, part.Color, part:IsA("MeshPart") and part.TextureID or nil }
            end
            if part.Material ~= mat then part.Material = mat end
            if part.Color ~= color then part.Color = color end
            if part:IsA("MeshPart") and part.TextureID ~= "" then part.TextureID = "" end
        end
    end
end

local function EspApplyAll()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then
            EspApplyChar(plr.Character)
        end
    end
end

local function EspRestore()
    for part, data in pairs(espCache) do
        if part and part.Parent then
            part.Material = data[1]
            part.Color = data[2]
            if data[3] and part:IsA("MeshPart") then part.TextureID = data[3] end
        end
    end
    table.clear(espCache)
    for _, obj in ipairs(espStripped:GetChildren()) do
        obj:Destroy()
    end
end

local function EspHook(plr)
    if plr == LocalPlayer then return end
    plr.CharacterAdded:Connect(function(char)
        char:WaitForChild("Humanoid", 10)
        task.wait(0.5)
        if EspOn() then EspApplyChar(char) end
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    EspHook(plr)
end
Players.PlayerAdded:Connect(EspHook)

Players.PlayerRemoving:Connect(function(plr)
    if plr.Character then
        for _, part in ipairs(plr.Character:GetDescendants()) do
            espCache[part] = nil
        end
    end
end)


    v.paintFilledLoop = function(pool, center, points, c1, c2, c3, gradient, alpha, spin, visible)
        local count = #points
        if count < 3 or not visible or alpha <= 0 then
            v.hideTriPool(pool, 1)
            return
        end
        for i = 1, count do
            local tri = v.getTriSegment(pool, i)
            tri.PointA = center
            tri.PointB = points[i]
            tri.PointC = points[(i % count) + 1]
            tri.Color = gradient and v.grad3(c1, c2, c3, (i - 1) / count + spin) or c1
            tri.Transparency = alpha
            tri.Visible = true
        end
        v.hideTriPool(pool, count + 1)
    end


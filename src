	local function new(class, props)
		local inst = Instance.new(class)
		local parent
		for k, val in pairs(props) do
			if k == 'Parent' then parent = val
			elseif k == 'Font' and typeof(val) == 'Font' then inst.FontFace = val
			else inst[k] = val end
		end
		if props.BorderSizePixel == nil and inst:IsA('GuiObject') then inst.BorderSizePixel = 0 end
		if parent then inst.Parent = parent end
		if (class == 'TextLabel' or class == 'TextButton') and type(props.Text) == 'string' then

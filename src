v.installSilentAim = function()
    if v.SilentHooked then return end
    if not (hookmetamethod and getnamecallmethod and checkcaller and newcclosure) then
        Library:Notify('ur executor cant do silent aim (no hookmetamethod/checkcaller)', 6)
        return
    end
    v.SilentHooked = true

    pcall(function() v.SilentMouse = Player:GetMouse() end)

    local IDX_KEYS = v.SilentIndexKeys
    local READY = v.silentReady
    local RAY_OK = v.silentRayAllowed
    local SHOT_ORIGIN = v.silentShotOrigin
    local STATES = v.SilentStates
    local INDEX_SELF = v.silentIndexSelf

    local RAY_METHODS = {
        Raycast = true, Spherecast = true, Blockcast = true,
        FindPartOnRay = true,
        FindPartOnRayWithIgnoreList = true,
        FindPartOnRayWithWhitelist = true,
    }

    v.oldSilentIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)

        if IDX_KEYS[key]
            and INDEX_SELF(self)
            and READY() and not checkcaller() then
            local pos = STATES.AimPos
            if key == "Hit" then
                return CFrame.new(pos)
            elseif key == "Target" then
                return STATES.Part3D
            else
                local origin = SHOT_ORIGIN(Camera.CFrame.Position, pos)
                local dir = pos - origin
                if dir.Magnitude > 0.05 then
                    return Ray.new(origin, dir.Unit)
                end
            end
        end
        return v.oldSilentIndex(self, key)
    end))

    v.oldSilentNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)

        if not (READY() and not checkcaller()) then
            return v.oldSilentNamecall(self, ...)
        end

        local method = getnamecallmethod()
        if RAY_METHODS[method] and RAY_OK() then
            local pos = STATES.AimPos
            local args = { ... }
            local n = select("#", ...)

            if method == "Raycast" then
                local origin, dir = args[1], args[2]
                if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
                    origin = SHOT_ORIGIN(origin, pos)
                    local newDir = pos - origin
                    if newDir.Magnitude > 0.05 then
                        args[1] = origin
                        args[2] = newDir.Unit * dir.Magnitude
                        return v.oldSilentNamecall(self, table.unpack(args, 1, n))
                    end
                end
            elseif method == "Spherecast" or method == "Blockcast" then

                local origin, dir = args[1], args[3]
                local wasCFrame = typeof(origin) == "CFrame"
                if wasCFrame then origin = origin.Position end
                if typeof(origin) == "Vector3" and typeof(dir) == "Vector3" then
                    local shifted = SHOT_ORIGIN(origin, pos)
                    local newDir = pos - shifted
                    if newDir.Magnitude > 0.05 then
                        if shifted ~= origin then

                            args[1] = wasCFrame and (args[1] + (shifted - origin)) or shifted
                        end
                        args[3] = newDir.Unit * dir.Magnitude
                        return v.oldSilentNamecall(self, table.unpack(args, 1, n))
                    end
                end
            else
                local ray = args[1]
                if typeof(ray) == "Ray" then
                    local origin = SHOT_ORIGIN(ray.Origin, pos)
                    local newDir = pos - origin
                    if newDir.Magnitude > 0.05 then
                        args[1] = Ray.new(origin, newDir.Unit * ray.Direction.Magnitude)
                        return v.oldSilentNamecall(self, table.unpack(args, 1, n))
                    end
                end
            end
        end

        return v.oldSilentNamecall(self, ...)
    end))

    Library:Notify('silent aim hooked', 4)
end


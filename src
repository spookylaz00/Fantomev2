        Default = false,
        Tooltip = "skips your own team"
    })

    local function flickRoot(plr)
        local char = plr and plr.Character
        if not char then return nil end
        return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    end

    local function flickPart(plr)
        local char = plr and plr.Character
        if not char then return nil end
        local want = (Options.flickbotpart and Options.flickbotpart.Value) or "Head"
        return char:FindFirstChild(want)
            or char:FindFirstChild("Head")
            or char:FindFirstChild("HumanoidRootPart")
            or char:FindFirstChild("Torso")
    end

    local function flickVisible(part)
        local myChar = Player.Character
        if not (part and myChar) then return false end
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { myChar, part.Parent }
        local origin = Camera.CFrame.Position
        local dir = part.Position - origin
        local hit = workspace:Raycast(origin, dir, params)
        return hit == nil
    end

    local function flickTarget()
        local mouse = UserInputService:GetMouseLocation()
        local fov = (Options.flickbotfov and Options.flickbotfov.Value) or 150
        local teamCheck = Toggles.flickbotteamcheck and Toggles.flickbotteamcheck.Value
        local wallCheck = Toggles.flickbotwallcheck and Toggles.flickbotwallcheck.Value

        local best, bestD, bestPart = nil, math.huge, nil
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player then
                local char = plr.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local root = flickRoot(plr)
                local aliveOk = hum ~= nil
                if aliveOk and Toggles.flickbotalivecheck and Toggles.flickbotalivecheck.Value then
                    aliveOk = hum.Health > 0
                end
                if aliveOk and root then
                    local skip = false
                    if teamCheck and plr.Team and Player.Team and plr.Team == Player.Team then
                        skip = true
                    end
                    if not skip then
                        local part = flickPart(plr)
                        if part then
                            local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
                            if onScreen then
                                local d = (Vector2.new(screen.X, screen.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                                if d <= fov and d < bestD then
                                    if not wallCheck or flickVisible(part) then
                                        best, bestD, bestPart = plr, d, part
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        return best, bestPart
    end

    local function flickFire()
        if not (Toggles.flickbotautoclick and Toggles.flickbotautoclick.Value) then return end

        local char = Player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")
        if tool then
            local fired = pcall(function() tool:Activate() end)
            if not fired and firesignal then

                pcall(firesignal, tool.Activated)
            end
            task.wait(0.01)
            pcall(function() tool:Deactivate() end)
            return
        end

        pcall(function()
            if mouse1click then mouse1click() end
        end)
    end

    local function flickAt(part)
        if not part then return end
        local saved = Camera.CFrame
        local aim = part.Position

        local lead = (Options.flickbotprediction and Options.flickbotprediction.Value) or 0
        if lead > 0 then
            local ok, vel = pcall(function() return part.AssemblyLinearVelocity end)
            if ok and typeof(vel) == "Vector3" then
                aim = aim + vel * lead
            end
        end

        pcall(function()
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, aim)
        end)

        flickFire()

        local hold = (Options.flickbothold and Options.flickbothold.Value) or 0.05
        if hold > 0 then task.wait(hold) end

        if Toggles.flickbotreturn == nil or Toggles.flickbotreturn.Value then
            pcall(function() Camera.CFrame = saved end)
        end
    end

    UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not (Toggles.flickbottoggle and Toggles.flickbottoggle.Value) then return end
        if v.FlickStates.Busy then return end

        local cd = (Options.flickbotcooldown and Options.flickbotcooldown.Value) or 0.1
        local now = os.clock()
        if now - v.FlickStates.Last < cd then return end

        local target, part = flickTarget()
        if not (target and part) then return end

        v.FlickStates.Last = now
        v.FlickStates.Busy = true
        task.spawn(function()
            local ok, err = pcall(flickAt, part)
            if not ok then warn("flickbot: " .. tostring(err)) end
            v.FlickStates.Busy = false
        end)
    end)
end)



v.ChamsBoxes = {}

v.chamsDrop = function(plr)
    local hl = v.ChamsHighlights[plr]
    if hl then pcall(function() hl:Destroy() end) end
    v.ChamsHighlights[plr] = nil

    local pool = v.ChamsBoxes[plr]
    if pool then
        for _, adorn in pairs(pool) do
            pcall(function() adorn:Destroy() end)
        end
    end
    v.ChamsBoxes[plr] = nil
end

v.chamsBoxPart = function(part)
    if not part:IsA("BasePart") then return false end
    if part.Name == "HumanoidRootPart" then return false end
    local a = part:FindFirstAncestorWhichIsA("Accessory")
    if a then return false end
    local t = part:FindFirstAncestorWhichIsA("Tool")
    if t then return false end
    return true
end

v.chamsApplyBoxes = function(plr, char, outline, trans)
    local pool = v.ChamsBoxes[plr]
    if not pool then
        pool = {}
        v.ChamsBoxes[plr] = pool
    end

    local seen = {}

    for _, part in ipairs(char:GetChildren()) do
        if v.chamsBoxPart(part) then
            seen[part] = true
            local adorn = pool[part]
            if not (adorn and adorn.Parent) then
                adorn = Instance.new("BoxHandleAdornment")
                adorn.Name = "esp_chams_box"
                adorn.ZIndex = 0
                adorn.AlwaysOnTop = true
                adorn.Adornee = part
                adorn.Parent = part
                pool[part] = adorn
            end
            adorn.Size = part.Size + Vector3.new(0.06, 0.06, 0.06)
            adorn.Color3 = outline
            adorn.Transparency = math.clamp(trans + 0.35, 0, 1)
        end
    end

    for part, adorn in pairs(pool) do
        if not seen[part] then
            pcall(function() adorn:Destroy() end)
            pool[part] = nil
        end
    end
end

v.chamsDropAll = function()
    for plr in pairs(v.ChamsHighlights) do v.chamsDrop(plr) end
    for plr in pairs(v.ChamsBoxes) do v.chamsDrop(plr) end
    table.clear(v.ChamsHighlights)
    table.clear(v.ChamsBoxes)
end

v.chamsColors = function()
    local fill = (Options.espchamscolor and Options.espchamscolor.Value) or Color3.fromRGB(120, 200, 255)
    local outline = (Options.espchamsoutlinecolor and Options.espchamsoutlinecolor.Value) or Color3.new(1, 1, 1)
    if Toggles.rainbowesp and Toggles.rainbowesp.Value then
        local rgb = Color3.fromHSV(tick() % 5 / 5, 1, 1)
        fill, outline = rgb, rgb
    end
    local trans = (Options.espchamstransparency and Options.espchamstransparency.Value) or 0.45
    return fill, outline, trans
end


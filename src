task.spawn(function()
    v.KillAuraDone = {}
    v.KillAuraTarget = nil
    v.KillAuraHl = nil
    v.KillAuraRange = nil
    v.KillAuraSonar = nil
    v.KillAuraSweep = nil
    v.KillAuraBeam = nil

    v.AURA_RANGE_SEGS = 72
    v.AURA_SWEEP_SEGS = 14
    v.AURA_PULSES = 2
    v.AURA_BEAM_STEPS = 18

    local AURA_POOLS = { "KillAuraRange", "KillAuraSonar", "KillAuraSweep" }

    local function auraPool(store, count, thickness, zindex)
        local pool = v[store]
        if not pool then
            pool = {}
            v[store] = pool
        end
        for i = 1, count do
            if not pool[i] then
                local seg = Drawing.new("Line")
                seg.Thickness = thickness
                seg.Transparency = 1
                seg.ZIndex = zindex
                seg.Visible = false
                pool[i] = seg
            end
        end
        return pool
    end

    function v.auraRangeInit()
        auraPool("KillAuraRange", v.AURA_RANGE_SEGS, 2, 1)
        auraPool("KillAuraSonar", v.AURA_PULSES * v.AURA_RANGE_SEGS, 2, 1)
        auraPool("KillAuraSweep", v.AURA_SWEEP_SEGS + 1, 2, 1)
    end

    function v.auraRangeOff()
        for _, store in ipairs(AURA_POOLS) do
            local pool = v[store]
            if pool then
                for _, seg in ipairs(pool) do seg.Visible = false end
            end
        end
    end

    local function auraGroundLoop(centre, radius, segs)
        local pts, vis = {}, {}
        for i = 1, segs do
            local a = ((i - 1) / segs) * math.pi * 2
            local w = centre + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
            local sp, on = Camera:WorldToViewportPoint(w)
            pts[i] = Vector2.new(sp.X, sp.Y)
            vis[i] = on and sp.Z > 0
        end
        return pts, vis
    end

    local function auraPaintRing(pool, base, pts, vis, col, alpha)
        local n = #pts
        for i = 1, n do
            local nxt = (i % n) + 1
            local seg = pool[base + i]
            if seg then
                if vis[i] and vis[nxt] then
                    seg.From = pts[i]
                    seg.To = pts[nxt]
                    seg.Color = col
                    seg.Transparency = alpha
                    seg.Visible = true
                else
                    seg.Visible = false
                end
            end
        end
    end

    local function auraHideRange(pool, base, count)
        for i = 1, count do
            local seg = pool[base + i]
            if seg then seg.Visible = false end
        end
    end

    function v.auraRangeDraw(root, radius)
        v.auraRangeInit()

        local col = (Options.killauracirclecolor and Options.killauracirclecolor.Value)
            or Color3.new(1, 1, 1)
        local speed = tonumber(Options.killaurasonarspeed and Options.killaurasonarspeed.Value) or 1.2
        if speed <= 0 then speed = 0.1 end

        local char = root.Parent
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local drop = root.Size.Y * 0.5 + ((hum and hum.HipHeight) or 2)
        local centre = root.Position - Vector3.new(0, drop, 0)

        local segs = v.AURA_RANGE_SEGS
        local t = os.clock() * speed

        local pts, vis = auraGroundLoop(centre, radius, segs)
        auraPaintRing(v.KillAuraRange, 0, pts, vis, col, 0.3)

        for p = 1, v.AURA_PULSES do
            local phase = (t + (p - 1) / v.AURA_PULSES) % 1
            local pr = radius * phase
            local base = (p - 1) * segs
            if pr > 0.5 then
                local ppts, pvis = auraGroundLoop(centre, pr, segs)
                auraPaintRing(v.KillAuraSonar, base, ppts, pvis, col, 1 - phase)
            else
                auraHideRange(v.KillAuraSonar, base, segs)
            end
        end

        local sweep = v.AURA_SWEEP_SEGS
        local head = (t * math.pi * 2) % (math.pi * 2)
        local hubSp, hubOn = Camera:WorldToViewportPoint(centre)
        local hub = Vector2.new(hubSp.X, hubSp.Y)
        local hubVis = hubOn and hubSp.Z > 0

        local prev, prevVis = hub, hubVis
        for i = 0, sweep do
            local a = head - (i / sweep) * (math.pi / 3)
            local w = centre + Vector3.new(math.cos(a) * radius, 0, math.sin(a) * radius)
            local sp, on = Camera:WorldToViewportPoint(w)
            local flat = Vector2.new(sp.X, sp.Y)
            local ok = on and sp.Z > 0
            local seg = v.KillAuraSweep[i + 1]

            if seg then
                if prevVis and ok then
                    seg.From = prev
                    seg.To = flat
                    seg.Color = col
                    seg.Transparency = (i == 0) and 1 or math.max(0.05, 1 - (i / sweep))
                    seg.Visible = true
                else
                    seg.Visible = false
                end
            end

            prev, prevVis = flat, ok
        end
    end

    local function auraTorso()
        local char = Player and Player.Character
        if not char then return nil end
        return char:FindFirstChild("UpperTorso")
            or char:FindFirstChild("Torso")
            or char:FindFirstChild("HumanoidRootPart")
    end

    function v.auraBeamOff()
        local pool = v.KillAuraBeam
        if not pool then return end
        for _, seg in ipairs(pool) do seg.Visible = false end
    end

    function v.auraBeamDraw(targetPos, col)
        local torso = auraTorso()
        if not torso then
            v.auraBeamOff()
            return
        end

        local steps = v.AURA_BEAM_STEPS
        local pool = auraPool("KillAuraBeam", steps, 2, 2)
        local thickness = tonumber(Options.killaurabeamthickness and Options.killaurabeamthickness.Value) or 2
        local from = torso.Position
        local span = targetPos - from

        local prev, prevVis = nil, false
        for i = 0, steps do
            local sp, on = Camera:WorldToViewportPoint(from + span * (i / steps))
            local flat = Vector2.new(sp.X, sp.Y)
            local ok = on and sp.Z > 0

            if i > 0 then
                local seg = pool[i]
                if seg then
                    if prevVis and ok then
                        seg.From = prev
                        seg.To = flat
                        seg.Color = col
                        seg.Thickness = thickness
                        seg.Visible = true
                    else
                        seg.Visible = false
                    end
                end
            end

            prev, prevVis = flat, ok
        end
    end
    v.KillAuraHeld = false

    function v.getEquippedTools()
        local out, n = {}, 0
        local char = Player and Player.Character
        if not char then return out end
        for _, inst in ipairs(char:GetChildren()) do

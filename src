		local function isSelected(name)
			if multi then return type(obj.Value) == 'table' and obj.Value[name] == true end
			return obj.Value == name
		end

		local function paintOption(o)
			local on = isSelected(o.name)
			o.btn.TextColor3 = on and T.Text or T.Dim
			if o.hover then o.btn.TextColor3 = Color3.fromRGB(14, 14, 16) end
			o.btn.BackgroundColor3 = Color3.new(1, 1, 1)
			Library:Anim(o.btn, 0.12, { BackgroundTransparency = o.hover and 0 or 1 })

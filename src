	function addColorPicker(owner, flag, info)
		info = info or {}
		local parent = owner._comp
		if not parent then return owner end

		local start = typeof(info.Default) == 'Color3' and info.Default or Color3.new(1, 1, 1)
		local cH, cS, cV = start:ToHSV()
		local hasAlpha = type(info.Transparency) == 'number'
		local obj = newFlag('ColorPicker', {
			Value = start,
			Transparency = hasAlpha and math.clamp(info.Transparency, 0, 1) or 0,
			Title = info.Title or flag,
		})
		Options[flag] = obj

		local swatch = new('TextButton', {
			AutoButtonColor = false,
			Text = '',
			BackgroundColor3 = start,
			Size = UDim2.fromOffset(26, 13),
			LayoutOrder = #parent:GetChildren() + 1,
			Parent = parent,
		})
		round(swatch, 0.45)
		local swStroke = outline(swatch)
		local rbOn = false
		local rbConn
		rbConn = game:GetService('RunService').RenderStepped:Connect(function()
			if not obj.Value then return end
			if rbOn then obj:SetValueRGB(Color3.fromHSV(tick() % 5 / 5, 1, 1)) end
		end)

		local PW = hasAlpha and 222 or 200
		local PH = 196
		local pop, sv, svCursor, hueCursor, alphaFill, alphaCursor, hexBox, rgbLabel

		local function refresh(fire)
			obj.Value = Color3.fromHSV(cH, cS, cV)
			swatch.BackgroundColor3 = obj.Value
			if pop then
				sv.BackgroundColor3 = Color3.fromHSV(cH, 1, 1)
				svCursor.Position = UDim2.fromScale(cS, 1 - cV)
				hueCursor.Position = UDim2.fromScale(0.5, cH)
				if alphaFill then
					alphaFill.BackgroundColor3 = obj.Value
					alphaCursor.Position = UDim2.fromScale(0.5, obj.Transparency)
				end
				if not hexBox:IsFocused() then hexBox.Text = '#' .. obj.Value:ToHex() end
				rgbLabel.Text = string.format('%d, %d, %d',
					math.floor(obj.Value.R * 255 + 0.5), math.floor(obj.Value.G * 255 + 0.5), math.floor(obj.Value.B * 255 + 0.5))
			end
			if fire then
				if info.Callback then safeCall(info.Callback, obj.Value, obj.Transparency) end
				obj:_emit(obj.Value)
			end
		end

		function obj:SetValueRGB(color, transparency)
			if typeof(color) ~= 'Color3' then return self end
			cH, cS, cV = color:ToHSV()
			if type(transparency) == 'number' then self.Transparency = math.clamp(transparency, 0, 1) end
			refresh(true)
			return self
		end

		function obj:SetValue(val, transparency)
			if typeof(val) == 'Color3' then return self:SetValueRGB(val, transparency) end
			if type(val) == 'table' then
				cH = tonumber(val[1]) or cH
				cS = tonumber(val[2]) or cS
				cV = tonumber(val[3]) or cV
				if type(transparency) == 'number' then self.Transparency = math.clamp(transparency, 0, 1) end
				refresh(true)
			end
			return self
		end


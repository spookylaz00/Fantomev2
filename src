    v.triggerbotPartAllowed = function(part)
        if not part then return false end
        local name = part.Name

        local black = Options.triggerbotpartblacklist and Options.triggerbotpartblacklist.Value
        if type(black) == "table" and black[name] == true then return false end

        local allow = Options.triggerbotparts and Options.triggerbotparts.Value
        if type(allow) == "table" then
            local anyPicked = false
            for _, on in pairs(allow) do
                if on == true then anyPicked = true break end
            end
            if anyPicked and allow[name] ~= true then return false end
        end

        return true
    end

    local function GetPlayerUnderMouse()
        local mouse = game.Players.LocalPlayer:GetMouse()
        local target = mouse.Target

        if target then
            local character = target:FindFirstAncestorOfClass("Model")
            if character then
                local player = game.Players:GetPlayerFromCharacter(character)
                if player and player ~= game.Players.LocalPlayer then
                    if not v.triggerbotPartAllowed(target) then return nil end
                    return player
                end
            end
        end
        return nil
    end


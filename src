end
local function copyJson(dir, target)
pcall(function()
for _, f in ipairs(listfiles(dir)) do
local name = tostring(f):match('([^/\\]+%.json)$')
if name then copyFile(dir .. '/' .. name, target .. '/' .. name) end
end
end)
end

    -- "random part" / "closest part": both completely override the body part dropdown (camlock and silent aim)
    v.AimPartCache = setmetatable({}, { __mode = "k" })
    v.AimPartPool = function(char)
        local pool = {}
        if not char then return pool end
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then pool[#pool + 1] = child end
        end
        return pool
    end
    v.PickRandomPart = function(char)
        local entry = v.AimPartCache[char]
        local now = os.clock()
        if entry and entry.part and entry.part.Parent and now - entry.at < 0.35 then return entry.part end
        local pool = v.AimPartPool(char)
        if #pool == 0 then return nil end
        local part = pool[math.random(#pool)]
        v.AimPartCache[char] = { part = part, at = now }
        return part
    end
    v.PickClosestPart = function(char, center)
        local cam = workspace.CurrentCamera
        if not cam then return nil end
        local best, bestDist
        for _, part in ipairs(v.AimPartPool(char)) do
            local screen, onScreen = cam:WorldToViewportPoint(part.Position)
            if onScreen then
                local dist = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                if not bestDist or dist < bestDist then best, bestDist = part, dist end
            end
        end
        return best
    end
    v.AimPartOverride = function(char, fallback, kind)
        local rnd = Toggles[kind .. "randompart"]
        if rnd and rnd.Value then return v.PickRandomPart(char) or fallback end
        local cls = Toggles[kind .. "closestpart"]
        if cls and cls.Value then
            local center = (kind == "silent" and v.silentFovCenter and v.silentFovCenter()) or UserInputService:GetMouseLocation()
            return v.PickClosestPart(char, center) or fallback
        end
        return fallback
    end


v.autoHopSample = function(count, gap)
    local reads = {}
    for _ = 1, (count or 7) do
        local ms = v.autoHopPing()
        if ms then table.insert(reads, ms) end
        task.wait(gap or 0.3)
    end
    if #reads == 0 then return nil end
    table.sort(reads)
    return reads[math.ceil(#reads / 2)]
end

v.serverListCache = nil
v.serverListAt = nil

v.serverList = function(force, pages)
    if not force and v.serverListCache and v.serverListAt
        and (os.clock() - v.serverListAt) < 20 then
        return v.serverListCache
    end
    if type(v.request) ~= "function" then return {} end

    local out, cursor = {}, nil
    for _ = 1, (pages or 6) do
        local url = "https://games.roblox.com/v1/games/" .. tostring(game.PlaceId)
            .. "/servers/Public?sortOrder=Asc&limit=100"
            .. (cursor and ("&cursor=" .. tostring(cursor)) or "")
        local ok, res = pcall(v.request, { Url = url, Method = "GET" })
        if not (ok and type(res) == "table" and res.Body) then break end
        local good, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
        if not (good and type(data) == "table" and type(data.data) == "table") then break end
        for _, s in ipairs(data.data) do
            if type(s) == "table" and type(s.id) == "string" then
                table.insert(out, {
                    id      = s.id,
                    playing = tonumber(s.playing) or 0,
                    max     = tonumber(s.maxPlayers) or 0,
                    ping    = tonumber(s.ping) or 0,
                    fps     = tonumber(s.fps) or 0,
                    here    = s.id == game.JobId,
                })
            end
        end
        cursor = data.nextPageCursor
        if not cursor then break end
    end

    table.sort(out, function(a, b) return a.ping < b.ping end)
    v.serverListCache = out
    v.serverListAt = os.clock()
    return out
end

v.autoHopJoinable = function(s)
    return (not s.here) and s.playing < math.max(s.max - 1, 1)
end

v.autoHopPick = function(target)
    local list = v.serverList(true)
    local pool = {}
    for _, s in ipairs(list) do
        if v.autoHopJoinable(s) and (s.ping <= 0 or s.ping <= target + v.AutoHopGrace) then
            table.insert(pool, s)
        end
    end

    if #pool == 0 then
        for i = 1, math.min(#list, 12) do
            if v.autoHopJoinable(list[i]) then table.insert(pool, list[i]) end
        end
    end
    if #pool == 0 then return nil end

    return pool[math.random(1, math.min(#pool, 10))]
end

v.autoHopDisarm = function()
    v.clearTeleportQueue()
    if type(isfile) == "function" and isfile(v.autoHopFlag) and type(delfile) == "function" then
        pcall(delfile, v.autoHopFlag)
    end

    if Toggles.autoloadscript and Toggles.autoloadscript.Value then
        v.armAutoLoad(true)
    end
end

v.autoHopArm = function()
    if type(writefile) == "function" then
        pcall(writefile, v.autoHopFlag, tostring(v.autoHopTargetMs()))
    end
    return v.queueTeleport(v.autoLoadPayload)
end

v.autoHopStop = function(msg, dur)
    v.AutoHopBusy = false
    v.autoHopDisarm()
    if Toggles.autohoptoggle and Toggles.autohoptoggle.Value then
        v.AutoHopQuiet = true
        pcall(function() Toggles.autohoptoggle:SetValue(false) end)
        v.AutoHopQuiet = false
    end
    if msg then Library:Notify(msg, dur or 5) end
end

v.autoHopOn = function()
    return Toggles.autohoptoggle and Toggles.autohoptoggle.Value == true
end

v.autoHopRun = function()
    if v.AutoHopBusy then return end
    v.AutoHopBusy = true

    task.spawn(function()
        local target = v.autoHopTargetMs()

        local waited = 0
        while waited < 6 do
            if not v.autoHopOn() then v.AutoHopBusy = false return end
            task.wait(0.5)
            waited = waited + 0.5
        end

        local ms = v.autoHopSample(7, 0.3)
        if not v.autoHopOn() then v.AutoHopBusy = false return end

        if ms and ms <= target + v.AutoHopGrace then
            v.autoHopStop(string.format("auto hop done - %d ms, wanted %d", ms, target), 6)
            return
        end

        if not v.autoHopArm() then
            v.autoHopStop("this executor has no teleport queue, auto hop needs one", 6)
            return
        end

        local pick = v.autoHopPick(target)
        if not pick then
            v.AutoHopBusy = false
            Library:Notify("no server to hop to, retrying", 4)
            task.wait(5)
            if v.autoHopOn() then v.autoHopRun() end
            return
        end

        Library:Notify(string.format("%d ms here, hopping to %d ms / %d players",
            ms or -1, pick.ping, pick.playing), 4)
        task.wait(0.5)
        if not v.autoHopOn() then
            v.AutoHopBusy = false
            v.autoHopDisarm()
            return
        end
        pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, Player)
        end)
    end)
end



        local char = plr and plr.Character
        if not char then return v.visualDropHighlight() end
        if v.VisualHighlightOn ~= char or not v.VisualHighlight then
            v.visualDropHighlight()
            local hl = Instance.new("Highlight")
            hl.Name = "ReathVisual"
            hl.Adornee = char
            hl.FillTransparency = 0.5
            hl.OutlineTransparency = 0
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = char
            v.VisualHighlight = hl
            v.VisualHighlightOn = char
        end
        v.VisualHighlight.FillColor = v.visualColor('visualhighlightcolor')
        v.VisualHighlight.OutlineColor = v.visualColor('visualhighlightoutline')
    end

    RunService.RenderStepped:Connect(function()
        local plr = v.visualTarget()
        local hlOn = Toggles.visualhighlight and Toggles.visualhighlight.Value
        local trOn = Toggles.visualtracer and Toggles.visualtracer.Value
        local nmOn = Toggles.visualname and Toggles.visualname.Value

        if plr and hlOn then
            v.visualPaintHighlight(plr)
        else
            v.visualDropHighlight()
        end

        local head = nil
        if plr and plr.Character then
            head = plr.Character:FindFirstChild("Head") or plr.Character:FindFirstChild("HumanoidRootPart")
        end

        local sp, onScreen
        if head then sp, onScreen = Camera:WorldToViewportPoint(head.Position) end

        if head and onScreen and trOn then
            if not v.VisualTracerLine then
                v.VisualTracerLine = Drawing.new("Line")
                v.VisualTracerLine.Thickness = 2
            end
            local inset = game:GetService("GuiService"):GetGuiInset().Y
            local mouse = Player:GetMouse()
            v.VisualTracerLine.From = Vector2.new(mouse.X, mouse.Y + inset)
            v.VisualTracerLine.To = Vector2.new(sp.X, sp.Y)
            v.VisualTracerLine.Color = v.visualColor('visualtracercolor')
            v.VisualTracerLine.Visible = true
        elseif v.VisualTracerLine then
            v.VisualTracerLine.Visible = false
        end

        if head and onScreen and nmOn then
            if not v.VisualNameText then
                v.VisualNameText = Drawing.new("Text")
                v.VisualNameText.Size = 14
                v.VisualNameText.Center = true
                v.VisualNameText.Outline = true
            end
            v.VisualNameText.Text = plr.Name
            v.VisualNameText.Position = Vector2.new(sp.X, sp.Y - 22)
            v.VisualNameText.Color = v.visualColor('visualnamecolor')

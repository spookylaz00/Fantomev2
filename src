				o.grad.Color = ColorSequence.new(Color3.new(1, 1, 1), T.Accent)
				o.grad.Enabled = o.hover
			end
			o.mark.Visible = on
		end

		local function display()
			if multi then
				local parts = {}
				for _, name in ipairs(obj.Values) do
					if obj.Value[name] then parts[#parts + 1] = tostring(name) end
				end
				for name, on in pairs(obj.Value) do
					if on and not table.find(obj.Values, name) then parts[#parts + 1] = tostring(name) end
				end
				sel.Text = #parts > 0 and string.lower(table.concat(parts, ', ')) or 'none'
			else
				sel.Text = obj.Value ~= nil and string.lower(tostring(obj.Value)) or 'none'

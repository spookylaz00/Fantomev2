                    local clean = typed:gsub('[%c\\/:*?"<>|]', ''):gsub('%.json$', '')
                    local name
                    if typed ~= '' then
                        if clean == '' then
                            Library:Notify('that name doesnt work', 3, 'error')
                            return
                        end
                        if isfile(CONFIG_DIR .. '/' .. clean .. '.json') then
                            Library:Notify('name already taken', 3, 'error')
                            return
                        end
                        name = clean
                    else
                        name = 'Imported'
                        local i = 1
                        while isfile(CONFIG_DIR .. '/' .. name .. '.json') do
                            i = i + 1
                            name = 'Imported' .. i
                        end
                    end

                    pcall(function()
                        ensureFolder(CONFIG_DIR)
                        writefile(CONFIG_DIR .. '/' .. name .. '.json', text)
                    end)
                    pcall(function() applyConfig(text) end)
                    refresh()

                    if typed ~= '' then
                        Library:Notify('Done importing. saved as ' .. name .. ' in the list.', 4, 'success')
                    else
                        Library:Notify('Done importing. saved as ' .. name .. '.json', 4, 'success')
                    end
                end,
            })

            Localization.buildSettings(tab, 'left')
		end,
	}

	syncLegacy()
    end


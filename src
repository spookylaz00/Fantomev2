	local hasBuilder = pcall(function() return Enum.Font.BuilderSansExtraBold end)
	local DEFAULT_FONT = hasBuilder and 'BuilderSansExtraBold' or 'Arimo'
	if hasBuilder then T.Font, T.FontBold = Enum.Font.BuilderSansExtraBold, Enum.Font.BuilderSansExtraBold else T.Font, T.FontBold = Enum.Font.Arimo, Enum.Font.Arimo end
	local fontName = DEFAULT_FONT
	local FontApi = { names = FONT_NAMES, custom = {} }
	FontApi.apply = function(name, face)
		if face and not FONTS[name] then
			FONTS[name] = { face, face }
			FONT_NAMES[#FONT_NAMES + 1] = name
			table.sort(FONT_NAMES)
			FontApi.custom[name] = true
		end
		local f = FONTS[name]
		if not f then return false end
		fontName = name
		T.Font, T.FontBold = f[1], f[2]
		if FontApi.theme then FontApi.theme() end
		return true
	end
	FontApi.remove = function(name)
		if not FontApi.custom[name] then return end
		FONTS[name] = nil
		FontApi.custom[name] = nil
		for i = #FONT_NAMES, 1, -1 do
			if FONT_NAMES[i] == name then table.remove(FONT_NAMES, i) end
		end

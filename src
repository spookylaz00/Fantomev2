	function addKeyPicker(owner, flag, info)
		info = info or {}
		local parent = owner._comp
		if not parent then return owner end

		local mode = info.Mode
		if mode ~= 'Hold' and mode ~= 'Always' then mode = 'Toggle' end
		local obj = newFlag('KeyPicker', {
			Mode = mode,
			Active = false,
			Text = info.Text or owner.Text or flag,
			SyncToggleState = info.SyncToggleState == true,
			NoUI = info.NoUI == true,
			Value = 'NONE',
		})
		owner._keypicker = obj
		Options[flag] = obj
		bindKey(obj, normalizeKey(info.Default))

		local keyBtn = new('TextButton', {
			AutoButtonColor = false,
			Text = '',
			TextSize = 11,
			Size = UDim2.fromOffset(0, 16),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = #parent:GetChildren() + 1,
			Parent = parent,
		})
		paint(keyBtn, 'BackgroundColor3', 'Element')
		typeface(keyBtn)
		round(keyBtn, 0.5)
		local keyStroke = outline(keyBtn)
		new('UIPadding', { PaddingLeft = UDim.new(0, 6), PaddingRight = UDim.new(0, 6), Parent = keyBtn })
		obj._keyBtn = keyBtn

		local function display()
			keyBtn.Text = (listening == obj) and '...' or keyDisplay(obj.Value)
			keyBtn.TextColor3 = obj.Active and T.Accent or T.Dim
			keyStroke.Color = (listening == obj) and T.Accent or T.Stroke
			refreshRow(obj)
		end
		obj._display = display

		function obj._setActive(state, fromOwner)
			state = state and true or false
			if obj.Mode == 'Always' then state = true end
			local changed = obj.Active ~= state
			obj.Active = state
			display()
			if fromOwner or not changed then return end
			if obj.SyncToggleState and owner._isToggle and owner.Value ~= state then
				owner:SetValue(state)
			end
			if info.Callback then safeCall(info.Callback, state) end
		end

		function obj._bind(key)
			bindKey(obj, normalizeKey(key))
			display()
			obj:_emit(obj.Value)
			if info.ChangedCallback then safeCall(info.ChangedCallback, obj.Value) end
		end

		function obj._setMode(newMode)
			if newMode ~= 'Toggle' and newMode ~= 'Hold' and newMode ~= 'Always' then return end
			obj.Mode = newMode
			if newMode == 'Always' then
				obj._setActive(true)
			elseif newMode == 'Hold' then
				obj._setActive(false)
			end
			display()
			if Library.KbRefresh then Library.KbRefresh(obj) end
		end

		function obj:SetValue(val)
			if type(val) == 'table' then
				if val[1] ~= nil then obj._bind(val[1]) end
				if val[2] ~= nil then obj._setMode(val[2]) end
			else
				obj._bind(val)
			end
			return self
		end

		if owner._isToggle and obj.SyncToggleState then
			obj.Active = owner.Value == true
			owner._sync[#owner._sync + 1] = function(val) obj._setActive(val, true) end
		end
		if obj.Mode == 'Always' then obj.Active = true end

		local NEXT_MODE = { Toggle = 'Hold', Hold = 'Always', Always = 'Toggle' }
		local function swapMode()
			obj._setMode(NEXT_MODE[obj.Mode] or 'Toggle')
			Library:Notify(string.lower(tostring(obj.Text)) .. ' mode: ' .. string.lower(obj.Mode), 2)
		end

		local touchStart, skipClick = nil, false
		keyBtn.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then touchStart = os.clock() end
		end)
		keyBtn.InputEnded:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Touch or not touchStart then return end
			local held = os.clock() - touchStart
			touchStart = nil
			if held >= 0.45 and not pressBlocked then
				skipClick = true
				swapMode()
			end
		end)

		keyBtn.MouseButton1Click:Connect(guardClick(function()
			if skipClick then
				skipClick = false
				return
			end
			if listening == obj then
				listening = nil
			else
				local prev = listening
				listening = obj
				if prev and prev._display then prev._display() end
			end
			display()
		end))

		keyBtn.MouseButton2Click:Connect(guardClick(function()
			if obj._menu then
				obj._menu:Destroy()
				obj._menu = nil
				return
			end
			local ap = keyBtn.AbsolutePosition
			local menu = new('Frame', {
				BackgroundColor3 = T.Panel,
				Position = UDim2.fromOffset(ap.X + keyBtn.AbsoluteSize.X + 6, ap.Y),
				Size = UDim2.fromOffset(120, 4 * 24 + 10),
				ZIndex = 300,
				Parent = Library.ScreenGui,
			})
			paint(menu, 'BackgroundColor3', 'Panel')
			round(menu)
			outline(menu)
			new('UIListLayout', { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = menu })
			new('UIPadding', { PaddingTop = UDim.new(0, 5), PaddingLeft = UDim.new(0, 5), PaddingRight = UDim.new(0, 5), Parent = menu })
			local function item(text, order, fn)
				local b = new('TextButton', {
					AutoButtonColor = false,
					Text = text,
					TextSize = 12,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 22),
					LayoutOrder = order,
					ZIndex = 301,
					Parent = menu,
				})
				typeface(b)
				paint(b, 'TextColor3', 'Text')
				b.MouseEnter:Connect(function()
					b.BackgroundColor3 = T.Element
					b.BackgroundTransparency = 0.2
				end)
				b.MouseLeave:Connect(function()
					b.BackgroundTransparency = 1
				end)
				b.MouseButton1Click:Connect(function()
					if obj._menu then obj._menu:Destroy() obj._menu = nil end
					fn()
				end)
			end
			item('Hold', 1, function() obj._setMode('Hold') end)
			item('Toggle', 2, function() obj._setMode('Toggle') end)
			item('Always', 3, function() obj._setMode('Always') end)
			item('Unbind key', 4, function() obj._bind('NONE') end)
			obj._menu = menu
			local startTab = Library.ActiveTabName
			local menuConn, clickConn
			local function closeMenu()
				if menuConn then menuConn:Disconnect() end
				if clickConn then clickConn:Disconnect() end
				if obj._menu == menu then obj._menu = nil end
				if menu.Parent then menu:Destroy() end
			end
			menuConn = game:GetService('RunService').RenderStepped:Connect(function()
				if not menu.Parent or Library.ActiveTabName ~= startTab or not keyBtn.Parent then closeMenu() end
			end)
			clickConn = game:GetService('UserInputService').InputBegan:Connect(function(input)
				if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
				local pos = Vector2.new(input.Position.X, input.Position.Y)
				if over(menu, pos) or over(keyBtn, pos) then return end
				closeMenu()
			end)
		end))
		attachTip(keyBtn, function()
			return 'tap to rebind, right click or hold to swap mode (' .. string.lower(obj.Mode) .. ')'
		end)

		onTheme(display)
		if not obj.NoUI then addKeybindRow(obj) end
		refreshRow(obj)
		fitLabel(owner, 48)
		return owner
	end

	track(uis.InputBegan:Connect(function(input, gp)
		if Library.Unloaded then return end
		local itype = input.UserInputType
		local isPointer = itype == Enum.UserInputType.MouseButton1 or itype == Enum.UserInputType.MouseButton2
			or itype == Enum.UserInputType.MouseButton3 or itype == Enum.UserInputType.Touch
		local pos = isPointer and pointer(input) or nil
		if isPointer then pressBlocked = blockedAt(pos) end

		if listening then
			local p = listening
			local k = keyOf(input)
			if k then
				if k == 'MouseButton1' and over(p._keyBtn, pos) then return end
				listening = nil
				if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then k = 'NONE' end
				p._bind(k)
				return
			end
		end

		if popup and isPointer then
			if not over(popup.frame, pos) and not over(popup.anchor, pos) then closePopup() end
		end
		if openDrop and isPointer and not over(openDrop.frame, pos) then
			openDrop.close()
		end

		local k = keyOf(input)
		if not k then return end
		if itype == Enum.UserInputType.Keyboard then
			if gp or uis:GetFocusedTextBox() then return end
		elseif menuOpen and windowFrame and over(windowFrame, pos) then
			return
		elseif pressBlocked then
			return
		end

		local tk = Library.ToggleKeybind
		if type(tk) == 'table' and tk.Value == k and k ~= 'NONE' then
			Library:ToggleMenu()
		end

		local list = pickersByKey[k]
		if list then
			for i = 1, #list do pressPicker(list[i], true) end
		end
	end))

	track(uis.InputEnded:Connect(function(input)
		local itype = input.UserInputType
		if drag and (itype == Enum.UserInputType.MouseButton1 or itype == Enum.UserInputType.Touch) then
			local d = drag
			drag = nil
			if d.stop then safeCall(d.stop) end
		end
		local k = keyOf(input)
		if not k then return end
		local list = pickersByKey[k]
		if not list then return end
		for i = 1, #list do
			if list[i].Mode == 'Hold' then pressPicker(list[i], false) end
		end
	end))

	track(uis.InputChanged:Connect(function(input)
		local d = drag
		if not d then return end
		local itype = input.UserInputType
		if itype == Enum.UserInputType.MouseMovement or itype == Enum.UserInputType.Touch then
			d.move(input)
		end
	end))

	local toolInst = nil

	local function removeTool()
		if toolInst then
			pcall(function() toolInst:Destroy() end)
			toolInst = nil
		end
	end

	local function giveTool()
		removeTool()
		if not toolEnabled or Library.Unloaded then return end
		local backpack = localPlayer:FindFirstChildOfClass('Backpack')
		if not backpack then return end
		local tool = Instance.new('Tool')
		tool.Name = 'Toggle Ui'
		tool.RequiresHandle = false
		tool.CanBeDropped = false
		tool.ToolTip = 'open or close the menu'
		tool.Equipped:Connect(function()
			Library:ToggleMenu()
			task.defer(function()
				local char = localPlayer.Character
				local hum = char and char:FindFirstChildOfClass('Humanoid')
				if hum then hum:UnequipTools() end
			end)
		end)
		tool.Parent = backpack
		toolInst = tool
	end

	track(localPlayer.CharacterAdded:Connect(function()
		task.wait(0.5)
		giveTool()
	end))
	task.defer(giveTool)

	function Library:Unload()
		if Library.Unloaded then return end
		for i = 1, #unloadCbs do safeCall(unloadCbs[i]) end
		Library.Unloaded = true
		for i = 1, #conns do
			local c = conns[i]
			pcall(function() c:Disconnect() end)
		end
		removeTool()
		closePopup()
		pcall(function() gui:Destroy() end)
	end


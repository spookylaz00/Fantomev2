        end
    end

    v.circlePoints = function(center, radius, sides)
        local pts = {}
        for i = 1, sides do
            local a = (i / sides) * math.pi * 2
            pts[i] = Vector2.new(center.X + math.cos(a) * radius, center.Y + math.sin(a) * radius)
        end
        return pts
    end

    v.resampleLoop = function(points, sides)
        local n = #points
        if n < 3 then return points end
        local segLen, total = {}, 0
        for i = 1, n do
            local d = (points[(i % n) + 1] - points[i]).Magnitude
            segLen[i] = d
            total = total + d
        end
        if total <= 0 then return points end

        local out, idx, acc = {}, 1, 0
        for k = 0, sides - 1 do
            local mark = (k / sides) * total
            while idx < n and acc + segLen[idx] < mark do
                acc = acc + segLen[idx]
                idx = idx + 1
            end
            local t = 0
            if segLen[idx] and segLen[idx] > 0 then
                t = math.clamp((mark - acc) / segLen[idx], 0, 1)
            end
            local a = points[idx]
            local b = points[(idx % n) + 1]
            out[k + 1] = a + (b - a) * t
        end
        return out
    end

    v.shapePoints = function(center, radius, sides, shape)
        if shape == nil or shape == 'circle' then
            return v.circlePoints(center, radius, sides)
        end

        local pts = {}

        if shape == 'pentagon' then
            for i = 1, 5 do
                local a = (i / 5) * math.pi * 2 - math.pi / 2
                pts[i] = Vector2.new(center.X + math.cos(a) * radius, center.Y + math.sin(a) * radius)
            end
        elseif shape == 'star' then
            for i = 1, 10 do
                local a = (i / 10) * math.pi * 2 - math.pi / 2
                local r = (i % 2 == 1) and radius or (radius * 0.4)
                pts[i] = Vector2.new(center.X + math.cos(a) * r, center.Y + math.sin(a) * r)
            end
        elseif shape == 'ds' then

            local inner = radius / math.sqrt(3)
            for i = 1, 12 do
                local a = (i / 12) * math.pi * 2 - math.pi / 2
                local r = (i % 2 == 1) and radius or inner
                pts[i] = Vector2.new(center.X + math.cos(a) * r, center.Y + math.sin(a) * r)
            end
        elseif shape == 'heart' then
            for i = 1, 24 do
                local t = (i / 24) * math.pi * 2
                local x = 16 * math.sin(t) ^ 3
                local y = -(13 * math.cos(t) - 5 * math.cos(2 * t) - 2 * math.cos(3 * t) - math.cos(4 * t))
                local scale = radius / 17
                pts[i] = Vector2.new(center.X + x * scale, center.Y + y * scale)
            end
        else
            return v.circlePoints(center, radius, sides)
        end

        return v.resampleLoop(pts, math.max(sides, #pts))
    end

    v.dsTriangles = function(center, radius)
        local tri1, tri2 = {}, {}
        for i = 0, 2 do
            local a = math.rad(120 * i - 90)
            tri1[i + 1] = Vector2.new(center.X + math.cos(a) * radius, center.Y + math.sin(a) * radius)
            local b = math.rad(120 * i + 90)
            tri2[i + 1] = Vector2.new(center.X + math.cos(b) * radius, center.Y + math.sin(b) * radius)
        end
        return tri1, tri2
    end

    v.paintGradientLoop = function(pool, points, c1, c2, c3, thickness, spin, visible, base, hideTail)
        local count = #points
        base = base or 0
        if count < 2 then
            if hideTail ~= false then v.hideGradPool(pool, base + 1) end
            return base
        end
        for i = 1, count do
            local seg = v.getGradSegment(pool, base + i)
            seg.From = points[i]
            seg.To = points[(i % count) + 1]
            seg.Thickness = thickness
            seg.Color = v.grad3(c1, c2, c3, (i - 1) / count + spin)
            seg.Transparency = 1
            seg.Visible = visible
        end
        if hideTail ~= false then v.hideGradPool(pool, base + count + 1) end
        return base + count
    end

    v.CameraRestoreCF = nil

    -- pack off puts back exactly what that rig (R6 or R15) was using
    local animOriginal = setmetatable({}, { __mode = "k" })

    local function animNodes(char)
        local animate = char and char:FindFirstChild("Animate")
        if not animate then return nil end
        local function node(group, name)
            local g = animate:FindFirstChild(group)
            return g and g:FindFirstChild(name)
        end
        return animate, {
            idle1 = node("idle", "Animation1"), idle2 = node("idle", "Animation2"),
            walk = node("walk", "WalkAnim"), run = node("run", "RunAnim"),
            jump = node("jump", "JumpAnim"), climb = node("climb", "ClimbAnim"),

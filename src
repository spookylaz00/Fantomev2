    v.TCS = game:GetService("TextChatService")
    local VERIFIED_BADGE = utf8.char(0xE000)

    local function applyTitleHook()
        if v.TCS.ChatVersion == Enum.ChatVersion.TextChatService then
            local channel = v.TCS:FindFirstChild("TextChannels") and v.TCS.TextChannels:FindFirstChild("RBXGeneral")
            if channel then
                channel.OnIncomingMessage = function(msg)
                    if not (msg.TextSource and msg.TextSource.UserId == Player.UserId) then return end
                    local titleOn = Toggles.customtitletoggle and Toggles.customtitletoggle.Value
                    local badgeOn = Toggles.verifiedbadge and Toggles.verifiedbadge.Value
                    if not titleOn and not badgeOn then return end
                    local prefix = msg.PrefixText
                    if badgeOn then
                        -- the badge goes right after the name, before the colon
                        local colon = string.find(prefix, ":[^:]*$")
                        if colon then
                            prefix = string.sub(prefix, 1, colon - 1) .. VERIFIED_BADGE .. string.sub(prefix, colon)
                        else
                            prefix = prefix .. VERIFIED_BADGE
                        end
                    end
                    local title = titleOn and (Options.customtitletext and Options.customtitletext.Value or "") or ""
                    if title ~= "" then
                        local color = Options.customtitlecolor and Options.customtitlecolor.Value or Color3.new(1, 0.4, 0.4)
                        local hex = string.format("%02X%02X%02X", math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255))
                        prefix = string.format('<font color="#%s">[%s]</font> %s', hex, title, prefix)
                    end
                    if prefix == msg.PrefixText then return end
                    local props = Instance.new("TextChatMessageProperties")
                    props.PrefixText = prefix
                    return props
                end
            end
        end
    end

    -- leaderboard: the badge glyph is added to our own name in the core player list (client only)
    local badgeUnloaded = false
    local function refreshLeaderboardBadge()
        local on = (not badgeUnloaded) and Toggles.verifiedbadge and Toggles.verifiedbadge.Value
        local list = v.CoreGui:FindFirstChild("PlayerList")
        if not list then return end
        for _, entry in ipairs(list:GetDescendants()) do
            if entry:IsA("TextLabel") and entry.Name == "PlayerName" then
                local base = string.gsub(entry.Text, VERIFIED_BADGE, "")
                if base == Player.DisplayName or base == Player.Name then
                    local has = string.find(entry.Text, VERIFIED_BADGE, 1, true) ~= nil
                    if on and not has then
                        entry.Text = entry.Text .. VERIFIED_BADGE
                    elseif (not on) and has then
                        entry.Text = base
                    end
                end
            end
        end
    end
    task.spawn(function()
        while not badgeUnloaded do
            pcall(refreshLeaderboardBadge)
            task.wait(0.5)
        end
    end)

v.silentCallerIsCamera = function(caller)
    local node, hops = caller, 0

    while node ~= nil and hops < 14 do
        local name
        if not pcall(function() name = node.Name end) then return false end
        if type(name) ~= 'string' then return false end

        if v.SilentCamCallers[name] then return true end

        local lower = string.lower(name)
        for _, word in ipairs(v.SilentCamWords) do
            if string.find(lower, word, 1, true) then return true end
        end

        local parent
        if not pcall(function() parent = node.Parent end) then return false end
        node = parent
        hops = hops + 1
    end

    return false
end

v.silentShotWindow = function()
    local shot = v.SilentShotAt
    if shot == nil then return false end
    return (os.clock() - shot) <= 0.35
end

v.silentRayAllowed = function()
    if type(getcallingscript) ~= 'function' then
        return v.silentShotWindow()
    end

    local ok, caller = pcall(getcallingscript)
    if not ok or caller == nil then
        return v.silentShotWindow()
    end

    local cached = v.SilentRayVerdict[caller]
    if cached ~= nil then return cached end

    local allowed = not v.silentCallerIsCamera(caller)
    v.SilentRayVerdict[caller] = allowed
    return allowed
end


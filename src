                if key == Enum.KeyCode.W then CONTROL.F = speed
                elseif key == Enum.KeyCode.S then CONTROL.B = -speed
                elseif key == Enum.KeyCode.A then CONTROL.L = -speed
                elseif key == Enum.KeyCode.D then CONTROL.R = speed
                elseif (key == Enum.KeyCode.E and qeFly) or key == Enum.KeyCode.Space then CONTROL.Q = speed * 2
                elseif (key == Enum.KeyCode.Q and qeFly) or key == Enum.KeyCode.LeftControl then CONTROL.E = -speed * 2 end
            end)
            keyUp = UserInputService.InputEnded:Connect(function(input)

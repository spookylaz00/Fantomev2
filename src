		local obj = newFlag('Button', { Button = btn })
		obj.Holder = btn
		local group = self
		function obj:AddButton(a2, b2) return group:AddButton(a2, b2) end
		return obj
	end

	local function makeLabel(group, text, doesWrap, color)

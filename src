do

    v.motionRandDir = function()
        local dir = Vector3.new(
            math.random(-100, 100) / 100,
            math.random(-100, 100) / 100,
            math.random(-100, 100) / 100
        )
        if dir.Magnitude < 0.05 then dir = Vector3.new(1, 0.3, 0) end
        return dir.Unit
    end

    v.motionSolve = function(st, targetPos, cfg)
        local dist = cfg.distance or 12
        local hgt = cfg.height or 8
        local spd = cfg.speed or 50

        local now = tick()
        local dt = now - (st.LastMove or 0)
        if dt <= 0 or dt > 0.2 then dt = 1 / 60 end
        st.LastMove = now

        if cfg.mode == "strafe" then
            local every = cfg.reroll or 0.12
            st.Dir = st.Dir or Vector3.zero
            st.Goal = st.Goal or Vector3.zero

            if st.Dir.Magnitude < 0.01 then st.Dir = v.motionRandDir() end
            if st.Goal.Magnitude < 0.01 or now - (st.LastRoll or 0) > every then
                st.LastRoll = now
                st.Goal = v.motionRandDir()
            end

            local cur, goal = st.Dir, st.Goal
            local ang = math.acos(math.clamp(cur:Dot(goal), -1, 1))
            local rate = math.max(spd, 1) * 0.15 * dt
            if ang <= rate or ang < 0.005 then
                cur = goal
                st.Goal = v.motionRandDir()
                st.LastRoll = now
            else
                local blended = cur + (goal - cur) * (rate / ang)
                cur = blended.Magnitude > 0.001 and blended.Unit or goal
            end
            st.Dir = cur

            return targetPos + cur * dist + Vector3.new(0, hgt, 0), false
        end

        st.Angle = ((st.Angle or 0) + (spd / 100) * (dt * 60)) % (math.pi * 2)
        local x = math.cos(st.Angle) * dist
        local z = math.sin(st.Angle) * dist
        return targetPos + Vector3.new(x, hgt, z), true
    end

    v.numInput = function(flag, fallback)
        local o = Options[flag]
        local n = o and tonumber(o.Value)
        return n or fallback
    end

    local Q_KEY, D_KEY = 0x51, 0x44

    v.motionKeyUp = function(st)
        local held = st.KeyDown
        if not held then return end
        st.KeyDown = nil
        pcall(function()
            if type(keyrelease) == "function" then keyrelease(held) end
        end)
    end

    v.MOTION_KEY_GAP = 0.06

    v.motionKeyPump = function(st, gap)

        if type(isrbxactive) == "function" then
            local ok, active = pcall(isrbxactive)
            if ok and not active then
                v.motionKeyUp(st)
                return
            end
        end

        gap = math.max(0.01, gap or 0.06)
        local now = os.clock()
        if now - (st.LastKey or 0) < gap then return end
        st.LastKey = now

        local nextKey = (st.KeyDown == Q_KEY) and D_KEY or Q_KEY
        v.motionKeyUp(st)
        if type(keypress) == "function" then
            pcall(function() keypress(nextKey) end)
            st.KeyDown = nextKey
        else

            local hum = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local side = (nextKey == D_KEY) and 1 or -1
                pcall(function() hum:Move(Camera.CFrame.RightVector * side, false) end)
            end
        end
    end
end


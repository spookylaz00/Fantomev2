        "debug.setupvalue", "debug.setconstant", "debug.setstack",
        "messagebox", "getcustomasset", "syn", "crypt",
    }

    v.execScan = function(src)
        if not v.Exec.Patch then return nil end
        for name in pairs(v.Exec.Patched) do
            local pattern
            if name:find("%.") then
                pattern = name:gsub("%.", "%%.")
                pattern = "%f[%w_]" .. pattern
            else
                pattern = "%f[%w_]" .. name .. "%f[^%w_]"
            end
            if src:find(pattern) then return name end
        end
        return nil
    end

    v.execRun = function(src, label)
        src = tostring(src or "")
        if src:gsub("%s", "") == "" then
            Library:Notify("nothing to execute", 3)
            return false, "empty"
        end

        local blocked = v.execScan(src)
        if blocked then
            Library:Notify("found " .. blocked .. " in the executed script", 5, "error")
            return false, blocked
        end

        if type(loadstring) ~= "function" then
            Library:Notify("ur executor has no loadstring", 4, "error")
            return false, "no loadstring"
        end

        local fn, compileErr = loadstring(src, "@" .. (label or "menu"))
        if not fn then
            Library:Notify("compile error: " .. tostring(compileErr), 6, "error")
            return false, compileErr
        end

        task.spawn(function()
            local ok, err = pcall(fn)
            if not ok then
                Library:Notify("runtime error: " .. tostring(err), 6, "error")
            end
        end)
        return true

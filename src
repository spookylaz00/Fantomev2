			AutoButtonColor = false,
			Text = '',
			BackgroundTransparency = 1,
			Position = UDim2.fromOffset(0, 12),
			Size = UDim2.new(1, 0, 0, 22),
			ZIndex = 3,
			Parent = holder,
		})

		local mult = 10 ^ rounding
		local function snap(val)
			val = math.floor(val * mult + 0.5) / mult
			return math.clamp(val, min, max)
		end
		local function fmt(val)
			if rounding == 0 then return tostring(math.floor(val + 0.5)) end
			return string.format('%.' .. rounding .. 'f', val)
		end
		local function display()
			local pct = (obj.Value - min) / (max - min)
			Library:Anim(fill, 0.1, { Size = UDim2.fromScale(pct, 1) })
			knob.Position = UDim2.fromScale(pct, 0.5)
			valL.Text = fmt(obj.Value) .. suffix
		end

		function obj:SetValue(val)
			val = tonumber(val)
			if not val then return self end
			val = snap(val)
			self.Value = val
			display()
			if info.Callback then safeCall(info.Callback, val) end
			self:_emit(val)
			return self
		end

		obj.Value = snap(obj.Value)
		display()

		local function fromPointer(pos)
			local x0, w = bar.AbsolutePosition.X, bar.AbsoluteSize.X
			if w <= 0 then return end
			local val = snap(min + (max - min) * math.clamp((pos.X - x0) / w, 0, 1))
			if val ~= obj.Value then obj:SetValue(val) end
		end

		hit.InputBegan:Connect(function(input)
			if not isPointerInput(input) then return end
			local pos = pointer(input)
			if blockedAt(pos) then return end
			closePopup()
			fromPointer(pos)
			local col = columnOf(holder)
			if col then col.ScrollingEnabled = false end
			nameL.TextColor3 = T.Text
			drag = {
				move = function(i) fromPointer(pointer(i)) end,
				stop = function()
					if col and not popup then col.ScrollingEnabled = true end
					nameL.TextColor3 = T.Dim
				end,
			}
		end)
		attachTip(hit, info.Tooltip)
		return obj
	end


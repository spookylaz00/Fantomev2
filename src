	local function pressPicker(p, down)
		if p.Mode == 'Toggle' then
			if down then p._setActive(not p.Active) end
		elseif p.Mode == 'Hold' then
			p._setActive(down)
		else
			if down then p._setActive(true) end
		end
		if down then
			local clicks = p._click
			for i = 1, #clicks do safeCall(clicks[i]) end
		end
	end


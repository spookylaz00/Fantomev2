    -- fly from infinite yield: normal = body gyro + body velocity fly, cframe = cframe fly
    do
        local keyDown, keyUp, mobileA, mobileB, cfLoop
        local flySession = 0
        local qeFly = true
        local velocityName = "FV" .. tostring(math.random(100000, 999999))
        local gyroName = "FG" .. tostring(math.random(100000, 999999))
        local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

        local function rootOf(char)
            return char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))
        end
        -- 50 on the fly speed slider = infinite yield speed 1
        local function iySpeed()
            return math.max((tonumber(Options.flightspeed.Value) or 50) / 50, 0.02)
        end

        local function stopNormal()
            if keyDown then keyDown:Disconnect() keyDown = nil end
            if keyUp then keyUp:Disconnect() keyUp = nil end
            local char = Player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            if hum then hum.PlatformStand = false end
        end

        local function startNormal()
            local char = Player.Character or Player.CharacterAdded:Wait()
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local T = rootOf(char)
            if not (humanoid and T) then return end
            local session = flySession
            local CONTROL = { F = 0, B = 0, L = 0, R = 0, Q = 0, E = 0 }
            local BG = Instance.new("BodyGyro")
            local BV = Instance.new("BodyVelocity")
            BG.P = 9e4
            BG.Parent = T
            BV.Parent = T
            BG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            BG.CFrame = T.CFrame
            BV.Velocity = Vector3.new(0, 0, 0)
            BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            task.spawn(function()
                repeat
                    task.wait()
                    local camera = workspace.CurrentCamera
                    humanoid.PlatformStand = true
                    local moving = CONTROL.L + CONTROL.R ~= 0 or CONTROL.F + CONTROL.B ~= 0 or CONTROL.Q + CONTROL.E ~= 0
                    if moving then
                        BV.Velocity = ((camera.CFrame.LookVector * (CONTROL.F + CONTROL.B)) + ((camera.CFrame * CFrame.new(CONTROL.L + CONTROL.R, (CONTROL.F + CONTROL.B + CONTROL.Q + CONTROL.E) * 0.2, 0).p) - camera.CFrame.p)) * 50
                    else
                        BV.Velocity = Vector3.new(0, 0, 0)
                    end
                    BG.CFrame = camera.CFrame
                until session ~= flySession or not BV.Parent
                BG:Destroy()
                BV:Destroy()
                if humanoid then humanoid.PlatformStand = false end
            end)

            keyDown = UserInputService.InputBegan:Connect(function(input, processed)

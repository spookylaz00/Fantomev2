			blackGrad.Transparency = NumberSequence.new(1, 0)
			blackGrad.Parent = black
			svCursor = new('Frame', {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(9, 9),
				BackgroundTransparency = 1,
				ZIndex = 204,
				Parent = sv,
			})
			cornerOf(svCursor, 5)
			local cs = Instance.new('UIStroke')
			cs.Color = Color3.new(1, 1, 1)
			cs.Thickness = 1.5
			cs.Parent = svCursor

			local hueBar = new('TextButton', {
				AutoButtonColor = false,
				Text = '',
				Position = UDim2.fromOffset(170, 30),
				Size = UDim2.fromOffset(16, 124),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 201,
				Parent = pop,
			})
			cornerOf(hueBar, 4)
			local hueGrad = Instance.new('UIGradient')
			hueGrad.Color = RAINBOW
			hueGrad.Rotation = 90
			hueGrad.Parent = hueBar
			hueCursor = new('Frame', {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.new(1, 4, 0, 3),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 203,
				Parent = hueBar,
			})
			cornerOf(hueCursor, 1)

			if hasAlpha then
				local alphaBar = new('TextButton', {
					AutoButtonColor = false,
					Text = '',
					Position = UDim2.fromOffset(194, 30),
					Size = UDim2.fromOffset(16, 124),
					BackgroundColor3 = Color3.fromRGB(60, 60, 66),

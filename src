    end
    return v.npcSilentReadyBase()
end

function v.npcGrad(c1, c2, c3, t)
    t = t % 1
    if t < 0 then t = t + 1 end
    if t < 0.5 then return c1:Lerp(c2, t / 0.5) end
    return c2:Lerp(c3, (t - 0.5) / 0.5)
end

function v.npcBox2D(model)
    local ok, cf, size = pcall(function() return model:GetBoundingBox() end)
    if not ok or typeof(cf) ~= "CFrame" or typeof(size) ~= "Vector3" then return nil end

    local minx, miny, maxx, maxy = math.huge, math.huge, -math.huge, -math.huge
    local seen = false

    for sx = -1, 1, 2 do
        for sy = -1, 1, 2 do
            for sz = -1, 1, 2 do
                local corner = (cf * CFrame.new(size.X * 0.5 * sx, size.Y * 0.5 * sy, size.Z * 0.5 * sz)).Position
                local sp = Camera:WorldToViewportPoint(corner)
                if sp.Z > 0 then
                    seen = true
                    if sp.X < minx then minx = sp.X end
                    if sp.Y < miny then miny = sp.Y end
                    if sp.X > maxx then maxx = sp.X end
                    if sp.Y > maxy then maxy = sp.Y end
                end
            end
        end
    end

    if not seen then return nil end
    return minx, miny, maxx, maxy
end

function v.npcEspSet()
    local set = { Outline = {}, Fill = {} }

    for i = 1, 32 do
        local l = Drawing.new("Line")
        l.Visible = false
        l.Thickness = 1
        l.Transparency = 1
        set.Outline[i] = l
    end

    for i = 1, 24 do
        local t = Drawing.new("Triangle")
        t.Visible = false
        t.Filled = true
        t.Thickness = 1
        set.Fill[i] = t
    end

    set.Name = Drawing.new("Text")
    set.Name.Visible = false
    set.Name.Center = true
    set.Name.Outline = true
    set.Name.Font = 2
    set.Name.Size = 13

    set.Dist = Drawing.new("Text")
    set.Dist.Visible = false
    set.Dist.Center = true
    set.Dist.Outline = true
    set.Dist.Font = 2
    set.Dist.Size = 12

    set.HpBg = Drawing.new("Line")
    set.HpBg.Visible = false
    set.HpBg.Thickness = 3
    set.HpBg.Color = Color3.new(0, 0, 0)

    set.HpFg = Drawing.new("Line")
    set.HpFg.Visible = false
    set.HpFg.Thickness = 1

    set.Tracer = Drawing.new("Line")
    set.Tracer.Visible = false
    set.Tracer.Thickness = 1

    return set
end

function v.npcEspHide(set)
    if not set then return end
    for i = 1, #set.Outline do set.Outline[i].Visible = false end
    for i = 1, #set.Fill do set.Fill[i].Visible = false end
    set.Name.Visible = false
    set.Dist.Visible = false
    set.HpBg.Visible = false
    set.HpFg.Visible = false
    set.Tracer.Visible = false
end

v.NpcEspSets = {}

function v.npcEspHideAll(from)
    for i = from or 1, #v.NpcEspSets do
        v.npcEspHide(v.NpcEspSets[i])
    end
end

task.spawn(function()
    local ESP_MAX = 20

    local function opt(tabKey, ownKey, fallback)
        return v.npcOpt(v.Npc.UseEsp == true, tabKey, ownKey, fallback)
    end

    local function drawOne(set, model, spin)
        local minx, miny, maxx, maxy = v.npcBox2D(model)
        if not minx then
            v.npcEspHide(set)
            return
        end

        local w = maxx - minx
        local h = maxy - miny
        if w < 1 or h < 1 then
            v.npcEspHide(set)
            return
        end

        local wantBox   = opt("espbox", "espbox", true) == true
        local wantFill  = opt("espboxfill", "espboxfill", true) == true
        local wantGrad  = opt("espboxgradient", "espboxgrad", true) == true
        local wantName  = opt("espname", "espname", true) == true
        local wantDist  = opt("espdistance", "espdist", true) == true
        local wantHp    = opt("esphealth", "esphealth", true) == true
        local wantTrace = opt("esptracers", "esptracer", false) == true

        local boxCol  = opt("boxcolor", "boxcolor", Color3.new(1, 1, 1))
        local c1      = opt("boxfillcolor", "fill1", Color3.new(1, 1, 1))
        local c2      = opt("boxfillcolor2", "fill2", Color3.new(1, 1, 1))
        local c3      = opt("boxfillcolor3", "fill3", Color3.new(1, 1, 1))
        local trans   = opt("espfilltransparency", "espfilltrans", 70) / 100
        local tsize   = opt("esptextsize", "esptextsize", 13)

        if wantBox then
            local per = #set.Outline
            local function pt(uu)
                local seg = uu * 4
                if seg < 1 then return Vector2.new(minx + w * seg, miny) end
                if seg < 2 then return Vector2.new(maxx, miny + h * (seg - 1)) end
                if seg < 3 then return Vector2.new(maxx - w * (seg - 2), maxy) end
                return Vector2.new(minx, maxy - h * (seg - 3))
            end
            for i = 1, per do
                local l = set.Outline[i]
                local u = (i - 1) / per
                l.From = pt(u)
                l.To = pt(i / per)
                l.Color = wantGrad and v.npcGrad(c1, c2, c3, u + spin) or boxCol
                l.Visible = true
            end
        else
            for i = 1, #set.Outline do set.Outline[i].Visible = false end
        end

        if wantFill then
            local bands = #set.Fill / 2
            for b = 1, bands do
                local ya = miny + h * ((b - 1) / bands)
                local yb = miny + h * (b / bands)
                local col = wantGrad and v.npcGrad(c1, c2, c3, (b - 1) / bands + spin) or c1
                local t1 = set.Fill[b * 2 - 1]
                local t2 = set.Fill[b * 2]
                t1.PointA = Vector2.new(minx, ya)
                t1.PointB = Vector2.new(maxx, ya)
                t1.PointC = Vector2.new(minx, yb)
                t2.PointA = Vector2.new(maxx, ya)
                t2.PointB = Vector2.new(maxx, yb)
                t2.PointC = Vector2.new(minx, yb)
                t1.Color = col
                t2.Color = col
                t1.Transparency = 1 - math.clamp(trans, 0, 1)
                t2.Transparency = 1 - math.clamp(trans, 0, 1)
                t1.Visible = true
                t2.Visible = true
            end
        else
            for i = 1, #set.Fill do set.Fill[i].Visible = false end
        end

        if wantName then
            set.Name.Text = v.npcLabel(model)
            set.Name.Size = tsize
            set.Name.Color = opt("namecolor", "namecolor", Color3.new(1, 1, 1))
            set.Name.Position = Vector2.new((minx + maxx) * 0.5, miny - tsize - 2)
            set.Name.Visible = true
        else
            set.Name.Visible = false
        end

        local root = v.npcRoot(model)

        if wantDist and root then
            local mag = (Camera.CFrame.Position - root.Position).Magnitude
            set.Dist.Text = string.format("%dm", math.floor(mag))
            set.Dist.Size = math.max(8, tsize - 1)
            set.Dist.Color = opt("distancecolor", "distcolor", Color3.new(1, 1, 1))
            set.Dist.Position = Vector2.new((minx + maxx) * 0.5, maxy + 2)
            set.Dist.Visible = true
        else
            set.Dist.Visible = false
        end

        local hum = model:FindFirstChildOfClass("Humanoid")
        if wantHp and hum and hum.MaxHealth > 0 then
            local frac = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local bx = minx - 5
            set.HpBg.From = Vector2.new(bx, miny)
            set.HpBg.To = Vector2.new(bx, maxy)
            set.HpBg.Visible = true
            set.HpFg.From = Vector2.new(bx, maxy)
            set.HpFg.To = Vector2.new(bx, maxy - h * frac)
            set.HpFg.Color = opt("healthbarcolor", "healthcolor", Color3.new(0, 1, 0))
            set.HpFg.Visible = true
        else
            set.HpBg.Visible = false
            set.HpFg.Visible = false
        end

        if wantTrace then
            local vp = Camera.ViewportSize
            set.Tracer.From = Vector2.new(vp.X * 0.5, vp.Y)
            set.Tracer.To = Vector2.new((minx + maxx) * 0.5, maxy)
            set.Tracer.Color = opt("tracercolor", "tracercolor", Color3.new(1, 1, 1))
            set.Tracer.Visible = true
        else
            set.Tracer.Visible = false
        end
    end

    RunService.RenderStepped:Connect(function()
        if not (v.Npc and v.Npc.Feat and v.Npc.Feat.esp) then
            if v.NpcEspDrew then
                v.npcEspHideAll(1)
                v.NpcEspDrew = false
            end
            return
        end

        local spinOn = v.npcOpt(v.Npc.UseEsp == true, "espgradspin", "espgradspin", false) == true
        local spinSpd = v.npcOpt(v.Npc.UseEsp == true, "espgradspinspeed", "espgradspeed", 90) or 90
        local spin = spinOn and ((os.clock() * (spinSpd / 360)) % 1) or 0

        local list = v.Npc.Matches or {}
        local used = 0

        for i = 1, math.min(#list, ESP_MAX) do
            local model = list[i]
            if typeof(model) == "Instance" and model.Parent and v.npcAlive(model) then
                used = used + 1
                if not v.NpcEspSets[used] then
                    v.NpcEspSets[used] = v.npcEspSet()
                end
                drawOne(v.NpcEspSets[used], model, spin)
            end
        end

        v.npcEspHideAll(used + 1)
        v.NpcEspDrew = true
    end)
end)

task.spawn(function()

    local function camOpt(tabKey, ownKey, fallback)
        return v.npcOpt(v.Npc.UseAimbotCam == true, tabKey, ownKey, fallback)
    end

    local function silOpt(tabKey, ownKey, fallback)
        return v.npcOpt(v.Npc.UseAimbotSilent == true, tabKey, ownKey, fallback)
    end

    local function aimTarget(fovKey, ownFovKey, mirror)
        local model = v.Npc.Selected
        if not (typeof(model) == "Instance" and model.Parent and v.npcAlive(model)) then
            local list = v.Npc.Matches or {}
            model = nil
            for i = 1, #list do
                if list[i].Parent and v.npcAlive(list[i]) then
                    model = list[i]
                    break
                end
            end
            if not model then return nil end
        end

        local fov = v.npcOpt(mirror, fovKey, ownFovKey, 250) or 250
        local root = v.npcRoot(model)
        if not root then return nil end

        local sp = Camera:WorldToViewportPoint(root.Position)
        if sp.Z <= 0 then return nil end

        local mouse = UserInputService:GetMouseLocation()
        local flat = (Vector2.new(sp.X, sp.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
        if flat > fov then return nil end

        return model
    end

    v.NpcCamlockWas = false

    local function camFovCentre()
        if v.Npc.UseAimbotCam == true then
            if v.CamlockStates and v.CamlockStates.FovMouseFollow then
                return GetMousePosition()
            end
            return GetScreenCenter()
        end
        if v.Npc.Set.camlockfovmouse == true then return GetMousePosition() end
        return GetScreenCenter()
    end

    local function camFovArmed()
        if v.Npc.UseAimbotCam == true then
            local t = Toggles.camlockFov
            return t ~= nil and t.Value == true
        end
        return v.Npc.Set.camlockfovcheck == true
    end

    local function camTarget(prefer)
        local model = v.Npc.Selected
        if not (typeof(model) == "Instance" and model.Parent and v.npcAlive(model)) then
            model = nil
            local list = v.Npc.Matches or {}
            for i = 1, #list do
                if list[i].Parent and v.npcAlive(list[i]) then
                    model = list[i]
                    break
                end
            end
            if not model then return nil end
        end

        local part = v.npcHead(model, prefer)
        part = v.AimPartOverride(model, part, "camlock")
        if not part then return nil end
        if not camFovArmed() then return part end

        local cam = workspace.CurrentCamera or Camera
        local sp, onScreen = cam:WorldToViewportPoint(part.Position)
        if not onScreen or sp.Z <= 0 then return nil end

        local radius = camOpt("camlockFovSize", "camlockfov", 250) or 250
        if (Vector2.new(sp.X, sp.Y) - camFovCentre()).Magnitude > radius then return nil end

        return part
    end

    RunService.RenderStepped:Connect(function(dt)
        local on = v.Npc and v.Npc.Feat and v.Npc.Feat.camlock

        if not on then
            if v.NpcCamlockWas then
                v.NpcCamlockWas = false
                v.restoreCamera(0.35)
            end
            return
        end

        local part = camTarget(camOpt("camlockTargetPart", "camlockpart", "Head"))

        if not part then return end

        if not v.NpcCamlockWas then
            v.NpcCamlockWas = true
            v.saveCamera()
        end

        local aim = part.Position

        if camOpt("camlockPrediction", "camlockpred", false) == true then
            local amt = camOpt("camlockPredictionAmount", "camlockpredamt", 0.12) or 0.12

            local vel = part.AssemblyLinearVelocity
            if not vel or vel.Magnitude < 0.001 then
                local root = v.npcRoot(part.Parent)
                vel = (root and root.AssemblyLinearVelocity) or Vector3.zero
            end
            aim = aim + vel * amt
        end

        local cam = workspace.CurrentCamera or Camera
        local pos = cam.CFrame.Position

        local want = v.safeLookCF(pos, aim - pos)

        if camOpt("camlockSmoothing", "camlocksmooth", false) == true then
            local a = math.clamp(camOpt("camlockSmoothAmount", "camlocksmoothamt", 0.25) or 0.25, 0.01, 1)

            a = 1 - (1 - a) ^ math.clamp((dt or 1 / 60) * 60, 0.1, 8)
            cam.CFrame = cam.CFrame:Lerp(want, a)
        else
            cam.CFrame = want
        end
    end)

    RunService.RenderStepped:Connect(function()
        local on = v.Npc and v.Npc.Feat and v.Npc.Feat.silent

        if not on then
            if v.NpcSilentActive then
                v.NpcSilentActive = false
                v.SilentStates.Part3D = nil
                v.SilentStates.AimPos = nil
            end
            return
        end

        local model = aimTarget("silentaimfovsize", "silentfov", v.Npc.UseAimbotSilent == true)
        if not model then
            v.NpcSilentActive = false
            return
        end

        local prefer = silOpt("silentaimpart", "silentpart", "Head")
        local part = v.npcHead(model, prefer)
        part = v.AimPartOverride(model, part, "silent")
        if not part then
            v.NpcSilentActive = false
            return
        end

        if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
            and os.clock() - (v.SilentStates.LastRoll or 0) > 0.08 then
            v.SilentStates.LastRoll = os.clock()
            local chance = silOpt("silentaimhitchance", "silentchance", 100) or 100
            v.SilentStates.Roll = math.random(1, 100) <= chance
        end

        local aim = part.Position
        local pred = silOpt("silentaimprediction", "silentpred", 0) or 0
        if pred > 0 then
            aim = aim + (part.AssemblyLinearVelocity or Vector3.zero) * pred
        end

        v.NpcSilentActive = true
        v.SilentStates.Part3D = part
        v.SilentStates.AimPos = aim
    end)
end)

task.spawn(function()
    v.NpcTrigLast = 0

    local function trigOpt(ownKey, fallback)
        local own = v.Npc.Set[ownKey]
        if own ~= nil then return own end
        return fallback
    end

    local function underCursor()
        local hit = v.NpcMouse and v.NpcMouse.Target
        if not hit then return nil end

        local list = v.Npc.Matches or {}
        local node = hit

        while node and node ~= workspace do
            for i = 1, #list do
                if list[i] == node then return node end
            end
            node = node.Parent
        end

        return nil
    end

    RunService.Heartbeat:Connect(function()
        if not (v.Npc and v.Npc.Feat and v.Npc.Feat.trigger) then return end

        local wait = trigOpt("trigdelay", 0.05) or 0.05
        if os.clock() - v.NpcTrigLast < wait then return end

        if not v.NpcMouse then
            local ok, m = pcall(function() return Player:GetMouse() end)
            if ok then v.NpcMouse = m end
            if not v.NpcMouse then return end
        end

        local model = underCursor()
        if not model or not v.npcAlive(model) then return end

        local char = Player.Character
        local tool = char and char:FindFirstChildOfClass("Tool")

        if trigOpt("trigtoolonly", true) == true and not tool then return end

        if trigOpt("trigvisible", false) == true then
            local root = v.npcRoot(model)
            local head = GetRootPart()
            if root and head then
                local par = RaycastParams.new()
                par.FilterType = Enum.RaycastFilterType.Exclude
                par.FilterDescendantsInstances = { char, model }
                local res = workspace:Raycast(head.Position, root.Position - head.Position, par)
                if res then return end
            end
        end

        local chance = trigOpt("trigchance", 100) or 100
        if math.random(1, 100) > chance then
            v.NpcTrigLast = os.clock()
            return
        end

        v.NpcTrigLast = os.clock()

        if tool then pcall(function() tool:Activate() end) end
        if mouse1click then pcall(mouse1click) end
    end)
end)


	local function normalizeKey(k)
		if typeof(k) == 'EnumItem' then return k.Name end
		if type(k) ~= 'string' or k == '' or k == '...' or k == 'None' or k == 'NONE' then return 'NONE' end
		if k == 'MB1' then return 'MouseButton1' end
		if k == 'MB2' then return 'MouseButton2' end
		if k == 'MB3' then return 'MouseButton3' end
		local okKey, keyEnum = pcall(function() return Enum.KeyCode[k] end)
		if okKey and keyEnum then return k end
		local okType, typeEnum = pcall(function() return Enum.UserInputType[k] end)
		if okType and typeEnum then return k end
		return 'NONE'
	end

	local function keyOf(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.Keyboard then return input.KeyCode.Name end
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2
			or t == Enum.UserInputType.MouseButton3 then
			return t.Name
		end
		return nil
	end

	local function keyDisplay(k)
		if k == nil or k == 'NONE' then return 'none' end
		return SHORT[k] or string.lower(k)
	end


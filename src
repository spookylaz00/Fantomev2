    local function IYMakeAdornment(root, size)
        local adorn = Instance.new("BoxHandleAdornment")
        adorn.Adornee   = root
        adorn.AlwaysOnTop = true
        adorn.ZIndex    = 5
        adorn.Size      = Vector3.new(size, size, size)
        adorn.Color3    = IYHitboxColor()
        adorn.Transparency = IYHitboxTrans()
        adorn.Parent    = workspace.CurrentCamera
        return adorn
    end

    local function IYRemoveAdornment(plr)
        local a = v.IYHitboxAdornments[plr]
        if a then pcall(function() a:Destroy() end) end
        v.IYHitboxAdornments[plr] = nil
    end

    local function IYRemoveAllAdornments()
        for plr in pairs(v.IYHitboxAdornments) do
            IYRemoveAdornment(plr)
        end
    end

    local function IYApplyHitbox(plr, size, transparency)
        if plr == Player then return end
        if IsHitboxWhitelisted(plr) then return end
        local char = plr.Character
        if not char then return end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root or not root:IsA("BasePart") then return end

        if not v.IYHitboxOriginals[plr] then
            v.IYHitboxOriginals[plr] = {
                Size        = root.Size,
                Transparency = root.Transparency,
                CanCollide  = root.CanCollide,
            }
        end

        root.CanCollide  = (Toggles.iyhitboxcollide and Toggles.iyhitboxcollide.Value) == true
        root.Size        = Vector3.new(size, size, size)
        root.Transparency = transparency

        local existing = v.IYHitboxAdornments[plr]
        if existing and existing.Parent then
            existing.Size = Vector3.new(size, size, size)
            existing.Color3 = IYHitboxColor()
            existing.Transparency = IYHitboxTrans()
        else
            IYRemoveAdornment(plr)
            v.IYHitboxAdornments[plr] = IYMakeAdornment(root, size)
        end
    end

    local function IYRestoreHitbox(plr)
        local char = plr and plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local orig = v.IYHitboxOriginals[plr]
        if root and orig then
            root.Size        = orig.Size
            root.Transparency = orig.Transparency
            root.CanCollide  = (orig.CanCollide ~= nil) and orig.CanCollide or true
        end
        v.IYHitboxOriginals[plr] = nil
        IYRemoveAdornment(plr)
    end

    local function IYRestoreAllHitboxes()
        for plr in pairs(v.IYHitboxOriginals) do
            IYRestoreHitbox(plr)
        end
        table.clear(v.IYHitboxOriginals)
        IYRemoveAllAdornments()
        if v.IYHitboxRenderConn then
            v.IYHitboxRenderConn:Disconnect()
            v.IYHitboxRenderConn = nil
        end
    end

    local function IYRefreshAllHitboxes()
        if not Toggles.iyhitboxtoggle or not Toggles.iyhitboxtoggle.Value then return end
        local size         = Options.iyhitboxsize and Options.iyhitboxsize.Value or 10
        local transparency = IYHitboxTrans()
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player then
                if IsHitboxWhitelisted(plr) then
                    if v.IYHitboxOriginals[plr] then IYRestoreHitbox(plr) end
                else
                    IYApplyHitbox(plr, size, transparency)
                end
            end
        end
    end

    v.IYSyncHitboxes = IYRefreshAllHitboxes

    local function IYStartRenderLoop()
        if v.IYHitboxRenderConn then return end
        v.IYHitboxRenderConn = RunService.RenderStepped:Connect(function()
            if not Toggles.iyhitboxtoggle or not Toggles.iyhitboxtoggle.Value then return end
            for plr, adorn in pairs(v.IYHitboxAdornments) do
                local char = plr and plr.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root or not root.Parent then


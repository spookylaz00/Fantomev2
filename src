                local p = cf.Position
                local flat = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
                flat = flat.Magnitude < 0.05 and Vector3.new(0, 0, -1) or flat.Unit
                -- only re-center when the camera moved or turned enough, so the flakes don't swim
                if lastPos and lastLook and (p - lastPos).Magnitude < 10 and flat:Dot(lastLook) > 0.95 then return end
                lastPos, lastLook = p, flat
                part.CFrame = CFrame.new(p + flat * (SPAN * 0.22) + Vector3.new(0, TALL * 0.5 - 26, 0))
            end)
            burst()
        end
        return fx
    end


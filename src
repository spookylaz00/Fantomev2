    v.grad3 = function(c1, c2, c3, t)
        t = t % 1
        if t < 1 / 3 then
            return c1:Lerp(c2, t * 3)
        elseif t < 2 / 3 then
            return c2:Lerp(c3, (t - 1 / 3) * 3)
        end
        return c3:Lerp(c1, (t - 2 / 3) * 3)
    end

    v.gradPools = {}

    v.getGradSegment = function(pool, i)
        local p = v.gradPools[pool]
        if not p then
            p = {}
            v.gradPools[pool] = p
        end
        local seg = p[i]
        if not seg then
            seg = Drawing.new("Line")
            seg.Thickness = 2
            seg.Transparency = 1
            seg.Visible = false
            p[i] = seg
        end
        return seg
    end

    v.hideGradPool = function(pool, from)

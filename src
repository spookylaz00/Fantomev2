    v.WeldState = { Applied = false, LastTarget = nil, LastMode = nil, Constraint = nil, Root = nil, Hum = nil, Anchor = nil }

    v.WeldAnchor = function(char, mode)
        local root = char:FindFirstChild("HumanoidRootPart")
        if mode == "head" then
            local head = char:FindFirstChild("Head")
            if head then return head, CFrame.new(0, 2.2, 0) end
            return root, CFrame.new(0, 5, 0)
        elseif mode == "hand" then
            local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
                or char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
            if hand then
                return hand, CFrame.new(0, -1.6, 0) * CFrame.Angles(math.rad(-90), 0, 0)
            end
            return root, CFrame.new(1.8, 0, 0) * CFrame.Angles(math.rad(-90), 0, 0)
        elseif mode == "front" then
            return root, CFrame.new(0, 0, -3.2)
        elseif mode == "under" then
            return root, CFrame.new(0, -4.5, 0)
        end
        return root, CFrame.new(0, 0, 3.2)
    end

    v.WeldDrop = function()
        local wc = v.WeldState.Constraint
        if wc then
            pcall(function() wc:Destroy() end)
        end
        v.WeldState.Constraint = nil
        v.WeldState.Anchor = nil
    end

    v.WeldJitter = false
    v.weldFollow = function(root, anchor, offset)
        if not (root and root.Parent and anchor and anchor.Parent) then return end
        v.WeldJitter = not v.WeldJitter
        local want = anchor.CFrame * offset
        pcall(function()
            root.CFrame = want + Vector3.new(0, v.WeldJitter and 0.001 or -0.001, 0)
            root.AssemblyLinearVelocity = Vector3.zero
            root.RotVelocity = Vector3.zero
        end)
    end

    v.WeldBuild = function(root, anchor, offset)
        v.WeldDrop()

        local hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
        v.WeldState.Hum = hum

        if hum then
            pcall(function() hum.PlatformStand = true end)
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
        end

        if sethiddenproperty then
            pcall(sethiddenproperty, root, "PhysicsRepRootPart", root)
        end

        v.WeldState.Anchor = anchor
        v.WeldState.Root = root
        v.WeldState.Applied = true
        v.weldFollow(root, anchor, offset)
    end

    v.WeldRelease = function()
        v.WeldDrop()
        if not v.WeldState.Applied then return end
        v.WeldState.Applied = false
        v.WeldState.LastTarget = nil
        v.WeldState.LastMode = nil

        local root = v.WeldState.Root or GetRootPart()
        if root and sethiddenproperty then
            pcall(sethiddenproperty, root, "PhysicsRepRootPart", root)
        end

        local hum = v.WeldState.Hum
        if not hum and root then
            hum = root.Parent and root.Parent:FindFirstChildOfClass("Humanoid")
        end
        if hum then
            pcall(function() hum.PlatformStand = false end)
            pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        end

        v.WeldState.Root = nil
        v.WeldState.Hum = nil
        v.WeldState.Anchor = nil
    end

    RunService.Heartbeat:Connect(function()

        if v.RageWeldOwned then return end

        if not Toggles.weldtoggle or not Toggles.weldtoggle.Value then
            v.WeldRelease()
            return
        end

        local target = States.TargetPlayer
        local char = target and target.Character
        local root = GetRootPart()
        if not (char and root) then
            v.WeldRelease()
            return
        end

        local mode = (Options.weldmode and Options.weldmode.Value) or "back"
        local anchor, offset = v.WeldAnchor(char, mode)
        if not anchor or not anchor.Parent then
            v.WeldRelease()
            return
        end

        local stale = (not v.WeldState.Applied) or v.WeldState.Anchor ~= anchor
            or v.WeldState.Root ~= root
            or v.WeldState.LastTarget ~= target or v.WeldState.LastMode ~= mode

        if stale then
            v.WeldState.LastTarget = target
            v.WeldState.LastMode = mode
            v.WeldBuild(root, anchor, offset)
            return
        end

        v.weldFollow(root, anchor, offset)
    end)


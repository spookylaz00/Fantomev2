			Parent = group.frame,
		})
		local props = {
			Text = tostring(text or ''),
			TextWrapped = wrap,
			Size = UDim2.new(1, 0, 0, wrap and 0 or 18),
			AutomaticSize = wrap and Enum.AutomaticSize.Y or Enum.AutomaticSize.None,
			TextTruncate = wrap and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,

        local o = Options[flag]
        local n = o and tonumber(o.Value)
        return n or fallback
    end

    local function col(flag, fallback)
        local o = Options[flag]
        return (o and o.Value) or fallback
    end

    RunService.Heartbeat:Connect(function()
        local aimbotOn = Toggles.iyhitboxtoggle2 and Toggles.iyhitboxtoggle2.Value
        local playerOn = Toggles.playerhitboxtoggle2 and Toggles.playerhitboxtoggle2.Value

        if not (aimbotOn or playerOn) then
            if next(v.HbV2.Saved) or next(v.HbV2.Adorns) then restoreAll() end
            return
        end

        pushRadius()

        local wanted = {}

        if aimbotOn then
            local size = num("iyhitboxsize", 10)
            local trans = num("iyhitboxtransparency", 0.4)
            local collide = Toggles.iyhitboxcollide and Toggles.iyhitboxcollide.Value
            local color = col("iyhitboxcolor", Color3.fromRGB(255, 50, 50))
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= Player and not (v.hitboxWhitelisted and v.hitboxWhitelisted(plr)) then
                    wanted[plr] = { size, trans, collide, color }
                end
            end
        end

        if playerOn then
            local target = States.TargetPlayer
            if target and target ~= Player then
                wanted[target] = {
                    num("playerhitboxsize", 10),
                    num("playerhitboxtransparency", 0.4),
                    Toggles.playerhitboxcollide and Toggles.playerhitboxcollide.Value,
                    col("playerhitboxcolor", Color3.fromRGB(255, 60, 60)),
                }
            end
        end

        for plr in pairs(v.HbV2.Saved) do
            if not wanted[plr] then restore(plr) end
        end

        for plr, cfg in pairs(wanted) do
            apply(plr, cfg[1], cfg[2], cfg[3], cfg[4])
        end
    end)

    Players.PlayerRemoving:Connect(function(plr)
        restore(plr)
    end)

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= Player then
            plr.CharacterAdded:Connect(function()
                v.HbV2.Saved[plr] = nil
                dropAdorn(plr)
            end)
        end
    end

    Players.PlayerAdded:Connect(function(plr)
        plr.CharacterAdded:Connect(function()
            v.HbV2.Saved[plr] = nil
            dropAdorn(plr)
        end)
    end)
end)


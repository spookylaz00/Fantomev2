    v.crosshairArms = {
        ["cross"] = { 0, 90, 180, 270 },
        ["x"] = { 45, 135, 225, 315 },
        ["star"] = { 0, 45, 90, 135, 180, 225, 270, 315 },
        ["horizontal"] = { 90, 270 },
        ["vertical"] = { 0, 180 },
        ["three prong"] = { 0, 120, 240 },
        ["sixteen point"] = { 0, 22.5, 45, 67.5, 90, 112.5, 135, 157.5,
                              180, 202.5, 225, 247.5, 270, 292.5, 315, 337.5 },
    }

    v.crosshairPolys = {
        ["triangle"] = 3,
        ["square"] = 4,
        ["diamond"] = 4,
        ["pentagon"] = 5,
        ["hexagon"] = 6,
        ["octagon"] = 8,
        ["circle"] = 24,
    }

    function v.crosshairDir(deg)
        local r = math.rad(deg)
        return Vector2.new(math.sin(r), -math.cos(r))
    end

    function v.crosshairSegments(style, origin, gap, len, spin, subdiv)
        local out, n = {}, 0
        local function push(a, b)
            for s = 1, subdiv do
                n = n + 1
                out[n] = {
                    from = a + (b - a) * ((s - 1) / subdiv),
                    to = a + (b - a) * (s / subdiv)
                }
            end
        end

        if style == "dot only" then
            return out, 0
        end

        local sides = v.crosshairPolys[style]
        if sides then
            local r = gap + len

            local offset = 0
            if style == "square" then offset = 45 end

            local tips = {}
            for i = 0, sides - 1 do
                tips[i + 1] = origin + v.crosshairDir(spin + offset + i * (360 / sides)) * r
            end
            for i = 1, sides do
                push(tips[i], tips[(i % sides) + 1])
            end
            return out, n
        end

        if style == "chevron" then

            local r = gap + len
            local apex = origin + Vector2.new(0, gap)
            push(apex, apex + v.crosshairDir(spin + 135) * r)
            push(apex, apex + v.crosshairDir(spin + 225) * r)
            return out, n
        end

        if style == "arrow" then

            local tip = origin + Vector2.new(0, gap)
            local tail = origin + Vector2.new(0, gap + len)
            push(tip, tail)
            local barb = math.max(3, len * 0.45)
            push(tip, tip + v.crosshairDir(spin + 135) * barb)
            push(tip, tip + v.crosshairDir(spin + 225) * barb)
            return out, n
        end

        if style == "brackets" then
            local r = gap + len
            local arm = math.max(2, len * 0.55)
            local corners = {}
            for i = 0, 3 do
                corners[i + 1] = origin + v.crosshairDir(spin + 45 + i * 90) * r
            end
            for i = 1, 4 do
                local c = corners[i]
                local prev = corners[((i + 2) % 4) + 1]
                local nxt = corners[(i % 4) + 1]
                local dp, dn = prev - c, nxt - c
                if dp.Magnitude > 0.01 then push(c, c + dp.Unit * arm) end
                if dn.Magnitude > 0.01 then push(c, c + dn.Unit * arm) end
            end
            return out, n
        end

        local arms = v.crosshairArms[style] or v.crosshairArms["cross"]
        for _, deg in ipairs(arms) do
            local d = v.crosshairDir(spin + deg)
            push(origin + d * gap, origin + d * (gap + len))
        end
        return out, n
    end

    local function UpdateCrosshair()
        if not Toggles.crosshairenabled or not Toggles.crosshairenabled.Value then

            if v.crosshairHidden then return end
            for _, v1 in ipairs(v.chFill) do v1.Visible = false end
            for _, v1 in ipairs(v.chOut) do v1.Visible = false end
            if v.crosshairDot then v.crosshairDot.Visible = false end
            v.scriptNameOff()
            v.crosshairHidden = true
            return
        end
        v.crosshairHidden = false

        local targetPos

        if Toggles.crosshairontarget and Toggles.crosshairontarget.Value then
            local aimTarget = nil

            if States.StickyAimEnabled and States.StickyAimTarget and States.StickyAimTarget.Character then
                aimTarget = States.StickyAimTarget
            elseif States.SilentAimEnabled and States.SilentAimTarget and States.SilentAimTarget.Character then
                aimTarget = States.SilentAimTarget
            end

            if aimTarget then
                local head = aimTarget.Character:FindFirstChild("Head")
                if head then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                    if onScreen then
                        targetPos = Vector2.new(screenPos.X, screenPos.Y)
                    end
                end
            end
        end

        if not targetPos then
            if Toggles.crosshairfollowmouse and Toggles.crosshairfollowmouse.Value then
                targetPos = UserInputService:GetMouseLocation()
            else
                local screenSize = Camera.ViewportSize
                targetPos = Vector2.new(screenSize.X / 2, screenSize.Y / 2)
            end
        end

        local lerpSpeed = Options.crosshairlerp and Options.crosshairlerp.Value or 1
        v.crosshairCurrentPos = v.crosshairCurrentPos:Lerp(targetPos, lerpSpeed)

        local v1 = v.crosshairCurrentPos
        local v2 = Options.crosshairlength.Value
        local v28 = Options.crosshairgap and Options.crosshairgap.Value or 5
        local v3 = Color3.new(1, 1, 1)

        local rainbowOn = (Toggles.crosshairrainbow and Toggles.crosshairrainbow.Value) == true
        if rainbowOn then
            v3 = Color3.fromHSV(tick() % 5 / 5, 1, 1)
        end

        if Toggles.crosshairrotate and Toggles.crosshairrotate.Value then
            v.chSpin = (v.chSpin + (Options.crosshairrotatespeed.Value * 0.1)) % 360
        end

        local pulseGap = v28
        if Toggles.crosshairpulse and Toggles.crosshairpulse.Value then
            v.crosshairPulseTime = v.crosshairPulseTime + (Options.crosshairpulsespeed.Value * 0.01)
            local bounce = math.sin(v.crosshairPulseTime) * 4
            pulseGap = v28 + bounce
        end
        if pulseGap < 0 then pulseGap = 0 end

        local style = (Options.crosshairstyle and Options.crosshairstyle.Value) or "cross"
        local gradOn = (Toggles.crosshairgradient and Toggles.crosshairgradient.Value) == true
        local outlineOn = (Toggles.crosshairoutline == nil) or (Toggles.crosshairoutline.Value == true)
        local thick = Options.crosshairthickness.Value

        local g1 = (Options.crosshairgrad1 and Options.crosshairgrad1.Value) or Color3.fromRGB(0, 200, 255)
        local g2 = (Options.crosshairgrad2 and Options.crosshairgrad2.Value) or Color3.fromRGB(160, 60, 255)
        local g3 = (Options.crosshairgrad3 and Options.crosshairgrad3.Value) or Color3.fromRGB(255, 70, 140)
        local gspd = (Options.crosshairgradspin and Options.crosshairgradspin.Value) or 120
        local phase = gspd > 0 and ((tick() * (gspd / 360)) % 1) or 0

        local lineColors = {
            Options.crosshairline1color and Options.crosshairline1color.Value or Color3.new(1, 1, 1),
            Options.crosshairline2color and Options.crosshairline2color.Value or Color3.new(1, 1, 1),
            Options.crosshairline3color and Options.crosshairline3color.Value or Color3.new(1, 1, 1),
            Options.crosshairline4color and Options.crosshairline4color.Value or Color3.new(1, 1, 1)
        }

        local outlineColors = {
            Options.crosshairline1outline and Options.crosshairline1outline.Value or Color3.new(0, 0, 0),
            Options.crosshairline2outline and Options.crosshairline2outline.Value or Color3.new(0, 0, 0),
            Options.crosshairline3outline and Options.crosshairline3outline.Value or Color3.new(0, 0, 0),
            Options.crosshairline4outline and Options.crosshairline4outline.Value or Color3.new(0, 0, 0)
        }

        local subdiv = gradOn and 6 or 1
        local segs, segCount = v.crosshairSegments(style, v1, pulseGap, v2, v.chSpin, subdiv)
        local pool = #v.chFill
        if segCount > pool then segCount = pool end

        for i = 1, segCount do
            local seg = segs[i]

            local armIndex = math.floor((i - 1) / subdiv) % 4 + 1

            local col
            if rainbowOn then
                col = v3
            elseif gradOn then
                col = v.Grad3W((i - 0.5) / segCount + phase, g1, g2, g3)
            else
                col = lineColors[armIndex]
            end

            local out = v.chOut[i]
            if outlineOn then
                out.From = seg.from
                out.To = seg.to
                out.Color = outlineColors[armIndex]
                out.Thickness = thick + ((Options.crosshairoutlinesize and Options.crosshairoutlinesize.Value) or 1)
                out.Visible = true
            else
                out.Visible = false
            end

            local fill = v.chFill[i]
            fill.From = seg.from
            fill.To = seg.to
            fill.Color = col
            fill.Thickness = thick
            fill.Visible = true
        end

        for i = segCount + 1, pool do
            v.chFill[i].Visible = false
            if v.chOut[i] then v.chOut[i].Visible = false end
        end

        if v.crosshairDot then
            if Toggles.crosshairdot and Toggles.crosshairdot.Value then
                v.crosshairDot.Position = v1
                v.crosshairDot.Radius = (Options.crosshairdotsize and Options.crosshairdotsize.Value) or 2
                v.crosshairDot.Visible = true
                if rainbowOn then
                    v.crosshairDot.Color = v3
                elseif gradOn then
                    v.crosshairDot.Color = v.Grad3W(phase, g1, g2, g3)
                else
                    v.crosshairDot.Color = Options.crosshairdotcolor and Options.crosshairdotcolor.Value or Color3.new(1, 1, 1)
                end
            else
                v.crosshairDot.Visible = false
            end
        end

        if v.scriptNameChars then
            if Toggles.crosshairscriptname and Toggles.crosshairscriptname.Value then
                local label = (Options.crosshairscriptnametext and Options.crosshairscriptnametext.Value) or ""
                if label == "" then label = "Illusion" end

                local size = (Options.crosshairscriptnamesize and Options.crosshairscriptnamesize.Value) or 14
                local y = v1.Y + 20
                local nameGrad = (Toggles.crosshairscriptnamegradient
                    and Toggles.crosshairscriptnamegradient.Value) == true

                if rainbowOn then
                    v.DrawGradText(v.scriptNameChars, label, v1.X, y, size, v3, v3, v3, 0)
                elseif nameGrad then
                    local n1 = (Options.crosshairnamegrad1 and Options.crosshairnamegrad1.Value) or Color3.new(1, 1, 1)
                    local n2 = (Options.crosshairnamegrad2 and Options.crosshairnamegrad2.Value) or Color3.new(1, 1, 1)

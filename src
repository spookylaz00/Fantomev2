    local lastId, nextAt = nil, 0
    RunService.Heartbeat:Connect(function()
        local on = (Toggles.hudtoggle and Toggles.hudtoggle.Value) == true
        if panel.Frame.Visible ~= on then panel:SetVisible(on) end
        if not on then return end
        local now = tick()
        if now < nextAt then return end
        nextAt = now + 0.1

        local sticky = States.StickyAimEnabled and States.StickyAimTarget or nil
        if sticky and not sticky.Parent then sticky = nil end
        if sticky then
            hudTarget = sticky
        elseif not frozen then
            hudTarget = nearestToMouse()
        end
        if hudTarget and not hudTarget.Parent then hudTarget = nil end


        if not hudTarget then
            panel:SetTitle("hud")
            dispL.Text = "no player"
            userL.Text = "hover someone"
            idL.Text = ""
            distL.Text = ""
            hpL.Text = "health: ?"
            hpFill.Size = UDim2.fromScale(0, 1)
            toolV.Text = "?"
            if lastId ~= nil then
                headImg.Image = ""
                lastId = nil
            end
            return
        end
        if lastId ~= hudTarget.UserId then
            lastId = hudTarget.UserId
            headImg.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(lastId) .. "&w=150&h=150"
        end
        local char = hudTarget.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local myHrp = GetRootPart()
        local tag = sticky and " [sticky]" or (frozen and " [locked]" or "")
        panel:SetTitle("hud - " .. hudTarget.Name .. tag)
        dispL.Text = hudTarget.DisplayName
        userL.Text = "@" .. hudTarget.Name
        idL.Text = "id " .. tostring(hudTarget.UserId) .. "  |  " .. tostring(hudTarget.AccountAge) .. "d old"
        local teamName = hudTarget.Team and hudTarget.Team.Name or "no team"
        if hrp and myHrp then
            distL.Text = string.format("%.0f studs  |  %s", (myHrp.Position - hrp.Position).Magnitude, string.lower(teamName))
        else
            distL.Text = "-- studs  |  " .. string.lower(teamName)
        end
        if hum then
            local hp, maxHp = hum.Health, math.max(hum.MaxHealth, 1)
            local ratio = math.clamp(hp / maxHp, 0, 1)
            hpL.Text = string.format("health: %.0f / %.0f", hp, maxHp)
            hpFill.Size = UDim2.fromScale(ratio, 1)
            hpFill.BackgroundColor3 = Color3.fromRGB(255, 60, 60):Lerp(Color3.fromRGB(80, 255, 120), ratio)
        else
            hpL.Text = "health: dead"
            hpFill.Size = UDim2.fromScale(0, 1)
        end
        local tool = char and char:FindFirstChildOfClass("Tool")
        toolV.Text = tool and tool.Name or "nothing"
    end)
end)

_G.__FL.finish()
v.ScriptLoaded = true
Library:Notify(string.format("loaded in %.2fs", os.clock() - (v.ScriptLoadStart or os.clock())), 6)

if v.IsMobile then
    task.delay(1, function()
        Library:Notify("you are mobile so some features may not work!", 8)
    end)
end

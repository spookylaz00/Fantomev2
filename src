RunService.RenderStepped:Connect(function()
    if v.SilentStates.FovEnabled then
        local rawCenter = v.silentFovCenter()
        local rawRadius = v.SilentStates.FovSize

        local now = os.clock()
        local tick = math.clamp(now - (v.SilentFovTick or now), 0, 0.25)
        v.SilentFovTick = now
        local ease = math.clamp((Options.silentaimfovlerp and Options.silentaimfovlerp.Value) or 1, 0.01, 1)
        ease = 1 - (1 - ease) ^ math.clamp(tick * 60, 0.1, 8)
        v.SilentFovPos = (v.SilentFovPos or rawCenter):Lerp(rawCenter, ease)
        v.SilentFovRadius = (v.SilentFovRadius or rawRadius)
            + (rawRadius - (v.SilentFovRadius or rawRadius)) * ease
        local center = v.SilentFovPos
        local radius = v.SilentFovRadius
        local sides = math.clamp(math.floor(v.SilentStates.FovSegments or 64), 8, 128)
        local thickness = math.max(1, v.SilentStates.FovThickness or 2)
        local fillSpin = os.clock() * (v.SilentStates.FovSpin or 0) * 0.1
        local shape = v.SilentStates.FovShape or 'circle'

        local tri1, tri2 = nil, nil
        if shape == 'ds' and v.dsTriangles then
            tri1, tri2 = v.dsTriangles(center, radius)
        end

        local pts = (v.shapePoints and v.shapePoints(center, radius, sides, shape))
            or v.circlePoints(center, radius, sides)

		if v.SilentStates.FovFilled and v.paintShapeFill then
            local f1 = (Options.silentfillgrad1 and Options.silentfillgrad1.Value) or Color3.new(1, 1, 1)
            local f2 = (Options.silentfillgrad2 and Options.silentfillgrad2.Value) or f1
            local f3 = (Options.silentfillgrad3 and Options.silentfillgrad3.Value) or f2
            local falpha = 1 - ((Options.silentFillTransparency and Options.silentFillTransparency.Value) or 75) / 100
            local fillAngle = math.rad((Options.silentaimfillrotation and Options.silentaimfillrotation.Value) or 0)
            local fillPhase = os.clock() * ((Options.silentaimfillspeed and Options.silentaimfillspeed.Value) or 0)
            if shape == 'circle' then
                v.paintCircleBands("silentband", center, radius, v.bandCount(radius), fillAngle, fillPhase, f1, f2, f3, falpha, true)
                if v.hideTriPool then v.hideTriPool("silentfill", 1) v.hideTriPool("silentfill2", 1) end
            elseif tri1 then
                v.hideBandPool("silentband", 1)
                v.paintShapeFill("silentfill", center, tri1, radius, fillAngle, fillPhase, f1, f2, f3, falpha, true)
                v.paintShapeFill("silentfill2", center, tri2, radius, fillAngle, fillPhase, f1, f2, f3, falpha, true)
            else
                v.hideBandPool("silentband", 1)
                v.paintShapeFill("silentfill", center, pts, radius, fillAngle, fillPhase, f1, f2, f3, falpha, true)
                if v.hideTriPool then v.hideTriPool("silentfill2", 1) end
            end
		elseif v.hideTriPool then
			v.hideBandPool("silentband", 1)
			if v.SilentFovFillCircle then v.SilentFovFillCircle.Visible = false end
            v.hideTriPool("silentfill", 1)
            v.hideTriPool("silentfill2", 1)
        end

		if v.paintGradientLoop then
            local outlineOn = (Toggles.silentfovoutline and Toggles.silentfovoutline.Value) == true
            if outlineOn then
                local s1 = (Options.silentoutlinecolor1 and Options.silentoutlinecolor1.Value) or Color3.new(1, 1, 1)
                local s2 = (Options.silentoutlinecolor2 and Options.silentoutlinecolor2.Value) or s1
                local s3 = (Options.silentoutlinecolor3 and Options.silentoutlinecolor3.Value) or s2
                v.paintGradientLoop("silentoutline", pts, s1, s2, s3, thickness, os.clock() * (v.SilentStates.FovSpin or 0) * 0.1, true)
            elseif v.hideGradPool then
                v.hideGradPool("silentoutline", 1)
            end
        end
		if (v.SilentStates.FovGradient or shape ~= 'circle') and v.paintGradientLoop then
            local spin = os.clock() * (v.SilentStates.FovSpin or 0) * 0.1
            local g1 = (Options.silentgrad1 and Options.silentgrad1.Value) or Color3.new(1, 1, 1)
            local g2 = (Options.silentgrad2 and Options.silentgrad2.Value) or g1
            local g3 = (Options.silentgrad3 and Options.silentgrad3.Value) or g1

			if not v.SilentStates.FovGradient then g2, g3 = g1, g1 end
            if tri1 then

                v.paintGradientLoop("silent", tri1, g1, g2, g3, thickness, spin, true, 0, false)
                v.paintGradientLoop("silent", tri2, g1, g2, g3, thickness, spin + 0.5, true, 3, true)
            else
                v.paintGradientLoop("silent", pts, g1, g2, g3, thickness, spin, true)
            end
            if v.SilentFovCircle then v.SilentFovCircle.Visible = false end
        else
            if not v.SilentFovCircle then
                v.SilentFovCircle = Drawing.new("Circle")
                v.SilentFovCircle.Filled = false
                v.SilentFovCircle.Transparency = 1
            end
            v.SilentFovCircle.Position = center
            v.SilentFovCircle.Radius = radius
            v.SilentFovCircle.NumSides = sides
            v.SilentFovCircle.Thickness = thickness
            v.SilentFovCircle.Color = (Options.silentgrad1 and Options.silentgrad1.Value) or Color3.new(1, 1, 1)
            v.SilentFovCircle.Visible = true
            if v.hideGradPool then v.hideGradPool("silent", 1) end
            if v.hideTriPool then v.hideTriPool("silentfill2", 1) end
        end
    else
        if v.SilentFovCircle then v.SilentFovCircle.Visible = false end
		if v.SilentFovFillCircle then v.SilentFovFillCircle.Visible = false end
        if v.hideGradPool then v.hideGradPool("silent", 1) v.hideGradPool("silentoutline", 1) end
        if v.hideTriPool then v.hideTriPool("silentfill", 1) end
        if v.hideTriPool then v.hideTriPool("silentfill2", 1) end
    end

    if not (v.SilentStates.Enabled or v.SilentForceTarget) then
        v.SilentStates.Target = nil
        v.SilentStates.Part3D = nil
        v.SilentStates.AimPos = nil
        States.SilentAimTarget = nil
        return
    end

    if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
        and os.clock() - (v.SilentStates.LastRoll or 0) > 0.08 then
        v.rollSilentChance()
    end

    local plr, part
    local forced = v.SilentForceTarget
    if forced and forced.Parent and forced.Character then
        part = v.silentPart(forced.Character)
        if part then plr = forced end
    end
    if not plr and v.SilentStates.Enabled then
        plr, part = v.resolveSilentTarget()
    end

    v.SilentStates.Target = plr
    v.SilentStates.Part3D = part
    v.SilentStates.AimPos = part and v.silentAimPoint(part) or nil
    States.SilentAimTarget = plr
end)

v.stopSilentOrbit = function()
    local so = v.SilentOrbit
    if not so then return end

    local saved = so.OriginalPosition
    so.OriginalPosition = nil
    so.Active = false
    v.orbitAngleSilent = 0

    task.spawn(function()
        if saved then
            local myRoot = GetRootPart()
            if myRoot then
                myRoot.Anchored = true
                myRoot.CFrame = saved
                pcall(function() myRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
                pcall(function() myRoot.Velocity = Vector3.new(0, 0, 0) end)
                task.wait(0.2)
                myRoot.Anchored = false
            end
        end
        if not v.CamlockStates.Enabled then
            v.restoreCamera(0.35)
        end
    end)
end


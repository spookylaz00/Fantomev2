			local target = isOpen and (CLOSED_H + 4 + drawerH) or CLOSED_H
			local dh = isOpen and drawerH or 0
			if animate then
				local ti = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
				tweenService:Create(holder, ti, { Size = UDim2.new(1, 0, 0, target) }):Play()
				tweenService:Create(drawer, ti, { Size = UDim2.new(1, 0, 0, dh) }):Play()
				tweenService:Create(chev, ti, { Rotation = isOpen and 180 or 0 }):Play()
			else
				holder.Size = UDim2.new(1, 0, 0, target)
				drawer.Size = UDim2.new(1, 0, 0, dh)
				chev.Rotation = isOpen and 180 or 0

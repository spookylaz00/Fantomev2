		local function toSet(val)
			local set = {}
			if type(val) == 'table' then
				for k, x in pairs(val) do
					if type(k) == 'number' then
						local name = x
						if type(x) == 'number' and obj.Values[x] ~= nil then name = obj.Values[x] end
						if name ~= nil then set[name] = true end
					elseif x == true then
						set[k] = true
					end
				end
			elseif type(val) == 'number' and obj.Values[val] ~= nil then
				set[obj.Values[val]] = true
			elseif val ~= nil then
				set[val] = true
			end
			return set
		end

		if multi then
			obj.Value = toSet(info.Default)
		else
			local d = info.Default
			if type(d) == 'number' then d = obj.Values[d] end
			obj.Value = d
		end


    local function rageRoot(plr)
        local char = plr and plr.Character
        if not char then return nil end
        return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    end

    local function rageAlive(plr)
        local char = plr and plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        return hum and hum.Health > 0 and rageRoot(plr) ~= nil
    end

    local function rageNearestWhitelisted(plr)
        local wl = Options.ragenearestwhitelist and Options.ragenearestwhitelist.Value
        if type(wl) ~= "table" then return false end
        return wl[plr.Name] == true
    end

    local function rageStickyPush(target)
        if not (Toggles.rageneareststicky and Toggles.rageneareststicky.Value) then
            if v.RageStickyOwned then
                v.RageStickyOwned = false
                if v.stickyRelease then v.stickyRelease() end
            end
            return
        end
        if not target then return end
        v.RageStickyOwned = true
        if v.stickySetTarget then v.stickySetTarget(target) end
    end

    local function rageNearestMouse()
        local mouse = UserInputService:GetMouseLocation()
        local best, bestD = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player and rageAlive(plr) and not rageNearestWhitelisted(plr) then
                local root = rageRoot(plr)
                local screen, onScreen = Camera:WorldToViewportPoint(root.Position)
                if onScreen then
                    local d = (Vector2.new(screen.X, screen.Y) - Vector2.new(mouse.X, mouse.Y)).Magnitude
                    if d < bestD then best, bestD = plr, d end
                end
            end
        end
        return best
    end

    local function rageNearestMe()
        local myRoot = GetRootPart()
        if not myRoot then return nil end
        local best, bestD = nil, math.huge
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= Player and rageAlive(plr) and not rageNearestWhitelisted(plr) then
                local d = (rageRoot(plr).Position - myRoot.Position).Magnitude
                if d < bestD then best, bestD = plr, d end
            end
        end
        return best
    end

    local function rageResolve()
        if Toggles.ragenearest and Toggles.ragenearest.Value then
            local mode = (Options.ragenearestmode and Options.ragenearestmode.Value) or "mouse"
            return (mode == "nearest me") and rageNearestMe() or rageNearestMouse()
        end

        local list = {}
        for _, plr in ipairs(v.multiPlayerList("ragebottargets")) do
            if rageAlive(plr) then table.insert(list, plr) end
        end
        if #list == 0 then return nil end

        local cur = v.RageStates.Target
        local interval = (Options.ragebotswitch and Options.ragebotswitch.Value) or 3
        local now = tick()

        local stillValid = false
        for _, plr in ipairs(list) do
            if plr == cur then stillValid = true break end
        end

        if stillValid and now - v.RageStates.LastSwitch < interval then
            return cur
        end

        v.RageStates.LastSwitch = now
        v.RageStates.Index = (v.RageStates.Index % #list) + 1
        return list[v.RageStates.Index]
    end

    local function rageClip(char)
        if not (Toggles.ragebotclipwall and Toggles.ragebotclipwall.Value) then return end
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") and part.CanCollide then
                v.RageStates.Clipped[part] = true
                part.CanCollide = false
            end
        end
    end

    local function rageUnclip()
        if not next(v.RageStates.Clipped) then return end
        for part in pairs(v.RageStates.Clipped) do
            if part and part.Parent then
                pcall(function() part.CanCollide = true end)
            end
        end
        table.clear(v.RageStates.Clipped)
    end

    local function rageWeldOn(root, char)
        local mode = (Options.rageweldmode and Options.rageweldmode.Value) or "back"
        local anchor, offset = v.WeldAnchor(char, mode)
        if not (anchor and anchor.Parent) then return end

        v.RageWeldOwned = true
        local stale = (not v.WeldState.Applied) or v.WeldState.Anchor ~= anchor
            or v.WeldState.Root ~= root
        if stale then
            v.WeldBuild(root, anchor, offset)
            return
        end

        v.weldFollow(root, anchor, offset)
    end

    local function rageWeldOff()
        if not v.RageWeldOwned then return end
        v.RageWeldOwned = false

        if not (Toggles.weldtoggle and Toggles.weldtoggle.Value) then
            v.WeldRelease()
        end
    end

    local warnedNoRageApi = false

    local function rageCsync()
        return (Toggles.ragecsync and Toggles.ragecsync.Value) == true
    end

    local function rageDesyncOn()
        if v.RageDesyncOwned then return true end
        if not (v.DesyncApi and v.DesyncApi.start) or not v.DesyncApi.start() then
            if not warnedNoRageApi then
                warnedNoRageApi = true
                Library:Notify('ur executor cant run csync, turn it off to move for real', 6)
            end
            return false
        end
        warnedNoRageApi = false
        v.RageDesyncOwned = true
        return true
    end

    local function rageDesyncOff()
        if not v.RageDesyncOwned then return end
        v.RageDesyncOwned = false
        if v.DesyncApi then
            pcall(function() v.DesyncApi.sync() end)
            if not (v.DesyncToggle and v.DesyncToggle.Value) then
                pcall(function() v.DesyncApi.stop() end)
            end
        end
    end

    local function rageWrite(root, point, lookAt)
        local cf
        if lookAt then
            cf = CFrame.new(point, lookAt)
        else
            cf = CFrame.new(point) * root.CFrame.Rotation
        end

        if rageCsync() then
            if rageDesyncOn() then
                pcall(function() v.DesyncApi.move(cf) end)
                if Toggles.ragebotvisualize and Toggles.ragebotvisualize.Value then
                    v.RageVisualOwned = true
                    v.desyncPosition = point
                elseif v.RageVisualOwned then

                    v.RageVisualOwned = false
                    if not (v.DesyncToggle and v.DesyncToggle.Value) then
                        pcall(function() v.visualizerDestroy() end)
                        v.desyncPosition = nil
                    end
                end
                v.rageKeyPump()
                return
            end

        end

        rageDesyncOff()
        v.rageKeyUp()
        pcall(function()
            root.CFrame = cf
            root.AssemblyLinearVelocity = Vector3.zero
            root.RotVelocity = Vector3.zero
        end)
    end

    local function rageMove(root, target)
        local char = target.Character
        local tRoot = rageRoot(target)
        if not (char and tRoot) then return end

        local method = (Options.ragebotmethod and Options.ragebotmethod.Value) or "orbit"

        if method == "weld" then
            rageWeldOn(root, char)
            return
        end

        rageWeldOff()

        if rageCsync() then
            v.RageStates.ReturnCF = nil
        elseif not v.RageStates.ReturnCF then

            v.RageStates.ReturnCF = root.CFrame
        end

        local cfg
        if method == "strafe" then
            cfg = {
                mode = "strafe",
                speed = (Options.ragestrafespeed and Options.ragestrafespeed.Value) or 200,
                height = (Options.ragestrafeheight and Options.ragestrafeheight.Value) or 8,
                distance = (Options.ragestrafedistance and Options.ragestrafedistance.Value) or 12,
                reroll = (Options.ragestrafereroll and Options.ragestrafereroll.Value) or 0.12,
            }
        else
            cfg = {
                mode = "orbit",
                speed = (Options.rageorbitspeed and Options.rageorbitspeed.Value) or 50,
                height = (Options.rageorbitheight and Options.rageorbitheight.Value) or 10,
                distance = (Options.rageorbitdistance and Options.rageorbitdistance.Value) or 15,
            }
        end

        local point, faceTarget = v.motionSolve(v.RageStates, tRoot.Position, cfg)
        rageWrite(root, point, faceTarget and tRoot.Position or nil)
    end

    local function rageVerdict(target)
        local myChar = Player.Character
        local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
        local tChar = target and target.Character
        local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")

        local safeAt = v.numInput('ragebotsafemodevalue', 25)
        local stopAt = v.numInput('ragebotstophealthvalue', 5)
        local reappearOn = Toggles.ragebotreappear and Toggles.ragebotreappear.Value
        local reappearAt = v.numInput('ragebotreappearvalue', safeAt)

        if v.RageStates.SkyReason == "self" then
            local need = reappearOn and reappearAt or safeAt
            if myHum and myHum.Health > need then
                v.RageStates.SkyReason = nil
            else
                return "sky"
            end
        elseif v.RageStates.SkyReason == "target" then
            if tHum and tHum.Health > stopAt then
                v.RageStates.SkyReason = nil
            else
                return "sky"
            end
        end

        if Toggles.ragebotsafemode and Toggles.ragebotsafemode.Value and myHum then
            if myHum.Health < safeAt then
                v.RageStates.SkyReason = "self"
                return "sky"
            end
        end

        if Toggles.ragebotstophealth and Toggles.ragebotstophealth.Value and tHum then
            if tHum.Health < stopAt then
                if Toggles.ragebotskywait and Toggles.ragebotskywait.Value then
                    v.RageStates.SkyReason = "target"
                    return "sky"
                end
                return "stop"
            end
        end

        return "go"
    end

    local function rageSky(root)
        if not v.RageStates.SkyAnchor then
            v.RageStates.SkyAnchor = root.Position
        end

        local h = v.numInput('ragebotskyheight', 400)
        local a = v.RageStates.SkyAnchor
        local base = Vector3.new(a.X, a.Y + h, a.Z)

        if Toggles.ragebotskymove and Toggles.ragebotskymove.Value then
            local now = tick()
            local dt = now - (v.RageStates.SkyLast or 0)
            if dt <= 0 or dt > 0.2 then dt = 1 / 60 end
            v.RageStates.SkyLast = now

            local spd = (Options.ragebotskymovespeed and Options.ragebotskymovespeed.Value) or 400
            local rad = (Options.ragebotskymoveradius and Options.ragebotskymoveradius.Value) or 60

            v.RageStates.SkyAngle = ((v.RageStates.SkyAngle or 0) + (spd / 100) * (dt * 60)) % (math.pi * 2)

            base = base + Vector3.new(
                math.cos(v.RageStates.SkyAngle) * rad,
                math.sin(v.RageStates.SkyAngle * 2.3) * (rad * 0.35),
                math.sin(v.RageStates.SkyAngle) * rad
            )
        end

        rageWrite(root, base, nil)
    end

    local function rageEquip()
        if not (Toggles.ragebotautotool and Toggles.ragebotautotool.Value) then return end

        local sel = Options.ragebottools and Options.ragebottools.Value
        if type(sel) ~= "table" then return end

        local char = Player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        local bp = Player:FindFirstChildOfClass("Backpack")
        if not bp then return end

        local anyHeld = char:FindFirstChildOfClass("Tool") ~= nil

        for _, tool in ipairs(bp:GetChildren()) do
            if tool:IsA("Tool") and sel[tool.Name] == true then
                if not anyHeld then
                    pcall(function() hum:EquipTool(tool) end)
                    anyHeld = true
                else
                    pcall(function() tool.Parent = char end)
                end
            end
        end
    end

    local function rageViewOn(target)
        if not v.RageStates.Viewing then
            v.RageStates.SavedSubject = Camera.CameraSubject
            v.RageStates.Viewing = true
        end
        local char = target.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        pcall(function() Camera.CameraSubject = hum or char end)
    end

    local function rageViewOff()
        if not v.RageStates.Viewing then return end
        v.RageStates.Viewing = false
        local fallback = Player.Character and Player.Character:FindFirstChildOfClass("Humanoid")
        pcall(function()
            Camera.CameraSubject = v.RageStates.SavedSubject or fallback
        end)
        v.RageStates.SavedSubject = nil
    end

    local function rageStop()
        v.RageStates.Target = nil
        v.RageStates.SkyReason = nil
        v.RageStates.SkyAnchor = nil
        table.clear(v.RageStates.DeadNotified)
        rageWeldOff()
        rageUnclip()
        rageViewOff()
        rageDesyncOff()
        v.rageKeyUp()

        if v.RageVisualOwned then
            v.RageVisualOwned = false
            if not (v.DesyncToggle and v.DesyncToggle.Value) then
                pcall(function() v.visualizerDestroy() end)
                v.desyncPosition = nil
            end
        end

        if v.RageStickyOwned then
            v.RageStickyOwned = false
            if v.stickyRelease then v.stickyRelease() end
        end

        v.silentForce(nil)
        if v.RageStates.Held then
            v.RageStates.Held = false
            pcall(function() if mouse1release then mouse1release() end end)
        end
        v.deactivateTool()

        local back = v.RageStates.ReturnCF
        v.RageStates.ReturnCF = nil
        if back and (Toggles.ragebotreturn == nil or Toggles.ragebotreturn.Value) then
            task.defer(function()
                local root = GetRootPart()
                if not root then return end
                pcall(function()
                    root.CFrame = back
                    root.AssemblyLinearVelocity = Vector3.zero
                    root.RotVelocity = Vector3.zero
                end)
            end)
        end
    end
    v.rageStop = rageStop

    local function rageRelease()
        if v.RageStates.Held then
            v.RageStates.Held = false
            pcall(function() if mouse1release then mouse1release() end end)
        end
        v.deactivateTool()
    end

    local function rageClickOnce()
        if not v.activateTool() then return end
        task.wait(0.01)
        v.deactivateTool()
    end

    local function rageWantsClick()
        return (Toggles.ragebottoggle and Toggles.ragebottoggle.Value
            and Toggles.ragebotautoclick and Toggles.ragebotautoclick.Value
            and v.RageStates.Target ~= nil
            and v.RageStates.SkyReason == nil) == true
    end

    task.spawn(function()
        while true do
            if not rageWantsClick() then
                rageRelease()
                task.wait(0.05)
            else
                local burst = math.max(1, math.floor((Options.ragebotclicks and Options.ragebotclicks.Value) or 1))
                local gap = math.max(0.01, (Options.ragebotclickgap and Options.ragebotclickgap.Value) or 0.1)
                for i = 1, burst do
                    if not rageWantsClick() then break end
                    rageClickOnce()
                    if i < burst then task.wait(0.015) end
                end
                task.wait(gap)
            end
        end
    end)

    local function rageDeathWatch(target)
        if not (Toggles.ragebotdeathnotify and Toggles.ragebotdeathnotify.Value) then return end
        local char = target and target.Character
        if not char then return end
        local hum = char:FindFirstChildOfClass("Humanoid")
        if not hum then return end

        if hum.Health > 0 then
            v.RageStates.DeadNotified[char] = nil
            return
        end

        if v.RageStates.DeadNotified[char] then return end
        v.RageStates.DeadNotified[char] = true
        Library:Notify(target.Name .. " died!", 5)
    end

    RunService.Heartbeat:Connect(function()
        if not (Toggles.ragebottoggle and Toggles.ragebottoggle.Value) then
            if v.RageStates.Target or v.RageStates.Viewing or v.RageWeldOwned
                or v.RageDesyncOwned or v.RageVisualOwned or v.RageStickyOwned then
                rageStop()
            end
            return
        end

        local myRoot = GetRootPart()
        if not myRoot then return end

        local target = rageResolve()
        if not target then
            v.RageStates.Target = nil
            rageWeldOff()
            rageViewOff()
            rageDesyncOff()
            v.rageKeyUp()
            v.silentForce(nil)

            v.RageStates.ReturnCF = nil
            return
        end

        if v.RageStates.Target ~= target then
            rageWeldOff()
            v.RageStates.Target = target
        end

        rageDeathWatch(target)
        if Toggles.ragenearest and Toggles.ragenearest.Value then
            rageStickyPush(target)
        end

        local verdict = rageVerdict(target)

        if verdict == "stop" then
            rageWeldOff()
            rageViewOff()
            v.silentForce(nil)
            return
        end

        if verdict == "sky" then
            rageWeldOff()
            v.silentForce(nil)
            rageClip(Player.Character or myRoot.Parent)
            rageSky(myRoot)
            return
        end

        v.RageStates.SkyAnchor = nil

        local aim = (Options.ragebotaim and Options.ragebotaim.Value) or "silent"
        if aim == "silent" then
            v.silentForce(target)
        else
            v.silentForce(nil)
        end

        rageClip(Player.Character or myRoot.Parent)
        rageEquip()
        rageMove(myRoot, target)

        if Toggles.ragebotview and Toggles.ragebotview.Value then
            rageViewOn(target)
        else
            rageViewOff()
        end
    end)

    RunService.RenderStepped:Connect(function()
        if not (Toggles.ragebottoggle and Toggles.ragebottoggle.Value) then return end
        if (Options.ragebotaim and Options.ragebotaim.Value) ~= "camlock" then return end
        if v.RageStates.SkyReason ~= nil then return end

        local target = v.RageStates.Target
        local char = target and target.Character
        if not char then return end

        local part = char:FindFirstChild(v.CamlockStates and v.CamlockStates.TargetPart or "Head")
            or char:FindFirstChild("Head")
            or char:FindFirstChild("HumanoidRootPart")
        if not part then return end

        Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
    end)

    Player.CharacterAdded:Connect(function()
        v.RageWeldOwned = false
        table.clear(v.RageStates.Clipped)
        v.RageStates.SkyAnchor = nil
    end)

    Players.PlayerRemoving:Connect(function(plr)
        if v.RageStates.Target == plr then
            v.RageStates.Target = nil
            rageWeldOff()
            rageViewOff()
            v.silentForce(nil)
        end
    end)
end)

task.spawn(function()
    v.StrafeStates = {

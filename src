    v.gripSync = function()
        local posOn = Toggles.grippostoggle and Toggles.grippostoggle.Value
        local rotOn = Toggles.griprottoggle and Toggles.griprottoggle.Value

        if not (posOn or rotOn) then
            if v.GripPosConn then
                v.GripPosConn:Disconnect()
                v.GripPosConn = nil
            end
            return
        end

        if v.GripPosConn then return end

        v.GripPosConn = RunService.RenderStepped:Connect(function()
            local char = Player.Character
            if not char then return end

            local wantPos = Toggles.grippostoggle and Toggles.grippostoggle.Value

            local wantRot = Toggles.griprottoggle and Toggles.griprottoggle.Value
                and not _G.RandomGripConnection

            if not (wantPos or wantRot) then return end

            local p = Vector3.new(
                (Options.gripposx and Options.gripposx.Value) or 0,
                (Options.gripposy and Options.gripposy.Value) or 0,
                (Options.gripposz and Options.gripposz.Value) or 0
            )

            local rot
            if wantRot then
                rot = CFrame.Angles(
                    math.rad((Options.griprotx and Options.griprotx.Value) or 0),
                    math.rad((Options.griproty and Options.griproty.Value) or 0),
                    math.rad((Options.griprotz and Options.griprotz.Value) or 0)
                )
            end

            for _, tool in ipairs(char:GetChildren()) do
                if tool:IsA("Tool") then
                    local grip = tool.Grip

                    local target = CFrame.new(wantPos and p or grip.Position)
                        * (rot or (grip - grip.Position))
                    if not v.cframeClose(grip, target) then
                        pcall(function() tool.Grip = target end)
                    end
                end
            end
        end)
    end


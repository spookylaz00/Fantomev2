v.silentPart = function(char)
    local overridden = v.AimPartOverride(char, nil, "silent")
    if overridden then return overridden end

    if v.SilentStates.Part == "Closest" then
        local center = v.silentFovCenter()
        local best, bestD = nil, math.huge
        for _, part in ipairs(v.silentBodyParts(char)) do
            local screen, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local d = (Vector2.new(screen.X, screen.Y) - center).Magnitude
                if d < bestD then best, bestD = part, d end
            end
        end
        if best then return best end
    end

    return char:FindFirstChild(v.SilentStates.Part)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char:FindFirstChild("Torso")
        or char:FindFirstChild("HumanoidRootPart")
end

v.silentAimPoint = function(part)
    local amount = v.SilentStates.Prediction or 0
    if amount <= 0 then return part.Position end

    if v.SilentStates.PingPrediction then
        local ping = 100
        pcall(function()
            ping = game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue()
        end)
        amount = amount * (ping / 100)
    end

    local vel = part.AssemblyLinearVelocity or part.Velocity or Vector3.zero
    return part.Position + vel * amount
end

v.silentFovCenter = function()
    if Toggles.silentaimfovfollow and Toggles.silentaimfovfollow.Value == false then
        local vp = Camera.ViewportSize
        return Vector2.new(vp.X / 2, vp.Y / 2)
    end
    return UserInputService:GetMouseLocation()
end

v.resolveSilentTarget = function()
    if States.StickyAimEnabled and States.StickyAimTarget and States.StickyAimTarget.Character then
        local skip = (Options.skipexploit and Options.skipexploit.Value) or {}
        if not skip["silent aim"] then
            local char = States.StickyAimTarget.Character
            if v.SilentStates.AliveCheck and not v.silentAlive(char) then
                return nil, nil
            end
            local part = v.silentPart(char)
            if part then
                return States.StickyAimTarget, part
            end
            return nil, nil
        end
    end

    local best, bestPart, bestScore = nil, nil, math.huge
    local center = v.silentFovCenter()
    local myRoot = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == Player then continue end

        local char = plr.Character
        if not char then continue end
        if v.silentWhitelisted(plr) then continue end
        if v.SilentStates.AliveCheck and not v.silentAlive(char) then continue end
        if v.SilentStates.TeamCheck and Player.Team and plr.Team and Player.Team == plr.Team then continue end

        local part = v.silentPart(char)
        if not part then continue end

        local aimPos = v.silentAimPoint(part)
        local screenPos, onScreen = Camera:WorldToViewportPoint(aimPos)
        if not onScreen then continue end

        local screenDist = (Vector2.new(screenPos.X, screenPos.Y) - center).Magnitude
        if v.SilentStates.FovOnly and screenDist > v.SilentStates.FovSize then continue end
        if v.SilentStates.WallCheck and not v.silentVisible(char, aimPos) then continue end

        local score
        if v.SilentStates.Mode == 'nearest you' then
            score = myRoot and (myRoot.Position - part.Position).Magnitude or screenDist
        elseif v.SilentStates.Mode == 'lowest health' then
            local hum = char:FindFirstChildOfClass("Humanoid")
            score = hum and hum.Health or math.huge
        else
            score = screenDist
        end

        if score < bestScore then
            bestScore, best, bestPart = score, plr, part
        end
    end

    return best, bestPart
end


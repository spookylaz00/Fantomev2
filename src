task.spawn(function()
    v.HbV2 = {
        Aimbot = false,
        Player = false,
        Saved = {},
        Adorns = {},
        Warned = false,
        LastPush = 0,
    }

    local function pushRadius()
        local now = os.clock()
        if now - v.HbV2.LastPush < 1 then return true end
        v.HbV2.LastPush = now

        local ok = false
        if type(setsimulationradius) == "function" then
            ok = pcall(setsimulationradius, math.huge, math.huge)
        end
        if not ok and type(sethiddenproperty) == "function" then
            ok = pcall(function()
                sethiddenproperty(Player, "SimulationRadius", math.huge)
                sethiddenproperty(Player, "MaxSimulationRadius", math.huge)
            end) and true or false
        end

        if not ok and not v.HbV2.Warned then
            v.HbV2.Warned = true
            Library:Notify("ur executor cant do hitbox v2, use v1", 7)
        end
        return ok
    end

    local function makeAdorn(root, size, color, trans)
        local adorn = Instance.new("BoxHandleAdornment")
        adorn.AlwaysOnTop = true
        adorn.ZIndex = 5
        adorn.Adornee = root
        adorn.Size = Vector3.new(size, size, size)
        adorn.Color3 = color
        adorn.Transparency = trans
        adorn.Parent = workspace.CurrentCamera
        return adorn
    end

    local function dropAdorn(plr)
        local a = v.HbV2.Adorns[plr]
        if a then pcall(function() a:Destroy() end) end
        v.HbV2.Adorns[plr] = nil
    end

    local function apply(plr, size, trans, collide, color)
        local char = plr and plr.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if not (root and root:IsA("BasePart")) then return end

        if not v.HbV2.Saved[plr] then
            v.HbV2.Saved[plr] = {
                Size = root.Size,
                Transparency = root.Transparency,
                CanCollide = root.CanCollide,
                Massless = root.Massless,
                Props = root.CustomPhysicalProperties,
                Root = root,
            }
        end

        pcall(function()
            root.Size = Vector3.new(size, size, size)
            root.Transparency = trans
            root.CanCollide = collide == true

            root.Massless = true
            root.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0, 0, 0, 0)
        end)

        local adorn = v.HbV2.Adorns[plr]
        if adorn and adorn.Parent then
            adorn.Adornee = root
            adorn.Size = Vector3.new(size, size, size)
            adorn.Color3 = color
            adorn.Transparency = trans
        else
            dropAdorn(plr)
            v.HbV2.Adorns[plr] = makeAdorn(root, size, color, trans)
        end
    end

    local function restore(plr)
        local saved = v.HbV2.Saved[plr]
        if saved then
            local root = saved.Root
            if root and root.Parent then
                pcall(function()
                    root.Size = saved.Size
                    root.Transparency = saved.Transparency
                    root.CanCollide = saved.CanCollide
                    root.Massless = saved.Massless
                    root.CustomPhysicalProperties = saved.Props
                end)
            end
            v.HbV2.Saved[plr] = nil
        end
        dropAdorn(plr)
    end

    local function restoreAll()
        for plr in pairs(v.HbV2.Saved) do restore(plr) end
        table.clear(v.HbV2.Saved)
        for plr in pairs(v.HbV2.Adorns) do dropAdorn(plr) end
        table.clear(v.HbV2.Adorns)
    end


    do -- scoped block
local function createVisualizer(position)
        v.visualizerDestroy()

        local char = Player and Player.Character
        if not char then return end

        local color = (Options.visualizercolor and Options.visualizercolor.Value)
            or Color3.fromRGB(255, 0, 0)

        local wasArchivable = char.Archivable
        pcall(function() char.Archivable = true end)
        local okClone, clone = pcall(function() return char:Clone() end)
        pcall(function() char.Archivable = wasArchivable end)
        if not okClone or not clone then return end

        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("BasePart") then
                d.Anchored = true
                d.CanCollide = false
                d.Material = Enum.Material.Neon
                d.Color = color
                d.Transparency = 0.3

                pcall(function()
                    d.CanQuery = false
                    d.CanTouch = false
                    d.Massless = true
                end)
                v.visualizerParts[#v.visualizerParts + 1] = d
            elseif d:IsA("Humanoid") or d:IsA("LuaSourceContainer") then

                pcall(function() d:Destroy() end)
            elseif d:IsA("Decal") or d:IsA("Texture") or d:IsA("Clothing") or d:IsA("ShirtGraphic") then

                pcall(function() d:Destroy() end)
            end
        end

        clone.Name = "DesyncVisualizer"
        pcall(function()
            clone.PrimaryPart = clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart
        end)
        clone.Parent = workspace

        v.visualizerPart = clone
        v.visualizerChar = char
        v.visualizerRoot = char:FindFirstChild("HumanoidRootPart")
        for _, source in ipairs(char:GetDescendants()) do
            if source:IsA('BasePart') then
                local copy = clone:FindFirstChild(source.Name, true)
                if copy and copy:IsA('BasePart') then
                    v.visualizerPairs[#v.visualizerPairs + 1] = {source, copy}
                end
            end
        end
        v.visualizerColorNow = color
        v.visualizerAlphaNow = 0.3
        pcall(function() v.visualizerRot = clone:GetPivot().Rotation end)

        v.visualizerMove(position)
        v.visualizerMaterial()
        v.visualizerFade((v.StrafeVisualOwned or v.RageVisualOwned or v.VisualizerToggle.Value) and 0.3 or 1)
    end


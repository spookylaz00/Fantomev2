    do
        local toolPfxOn      = false
        local toolPfxColor   = Color3.fromRGB(255, 255, 255)
        local toolPfxMode    = "stars"
        local toolPfxTracked = {}
        local toolPfxCharConn, toolPfxAddConn, toolPfxRemConn

        local STARS_NAME  = "IllusionStars"
        local SPECKS_NAME = "IllusionSpecks"

        local function toolPfxParts(tool)
            local parts, handle = {}, nil
            for _, part in ipairs(tool:GetDescendants()) do
                if part:IsA("BasePart") then
                    if part.Name == "Handle" then
                        handle = part
                    else
                        table.insert(parts, part)
                    end
                end
            end
            if #parts == 0 and handle then table.insert(parts, handle) end
            return parts
        end

        local function toolPfxStrip(tool)
            if not tool then return end
            for _, part in ipairs(tool:GetDescendants()) do
                if part:IsA("BasePart") then
                    local a = part:FindFirstChild(STARS_NAME)
                    local b = part:FindFirstChild(SPECKS_NAME)
                    if a then pcall(function() a:Destroy() end) end
                    if b then pcall(function() b:Destroy() end) end
                end
            end
        end

        local function toolPfxStars(tool)
            if not tool then return end
            for _, part in ipairs(toolPfxParts(tool)) do
                local existing = part:FindFirstChild(STARS_NAME)
                if existing then existing:Destroy() end
                pcall(function()
                    local e = Instance.new("ParticleEmitter")
                    e.Name = STARS_NAME
                    e.Lifetime = NumberRange.new(0.45, 0.9)
                    e.LockedToPart = true
                    e.LightEmission = 1
                    e.Drag = 5
                    e.Squash = NumberSequence.new(-0.1)
                    e.Speed = NumberRange.new(0.001, 0.001)
                    e.Brightness = 3
                    e.ZOffset = 1
                    e.Size = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0),
                        NumberSequenceKeypoint.new(0.508, 0.05, 0.05),
                        NumberSequenceKeypoint.new(1, 0),
                    })
                    e.Rate = 150
                    e.Texture = "rbxassetid://1084996976"
                    e.EmissionDirection = Enum.NormalId.Bottom
                    e.Color = ColorSequence.new(toolPfxColor)
                    e.Transparency = NumberSequence.new(0)
                    e.Parent = part
                end)
            end
        end

        local function toolPfxSpecks(tool)
            if not tool then return end
            for _, part in ipairs(toolPfxParts(tool)) do
                local existing = part:FindFirstChild(SPECKS_NAME)
                if existing then existing:Destroy() end
                pcall(function()
                    local e = Instance.new("ParticleEmitter")
                    e.Name = SPECKS_NAME
                    e.Lifetime = NumberRange.new(0.22, 0.22)
                    e.SpreadAngle = Vector2.new(90, 90)
                    e.Transparency = NumberSequence.new({
                        NumberSequenceKeypoint.new(0, 0.8),
                        NumberSequenceKeypoint.new(0.25, 0),
                        NumberSequenceKeypoint.new(1, 0.8),
                    })
                    e.LightEmission = 1
                    e.Color = ColorSequence.new(toolPfxColor)
                    e.Drag = 5
                    e.Squash = NumberSequence.new(0)
                    e.Speed = NumberRange.new(1, 1)
                    e.Brightness = 4.2
                    e.Size = NumberSequence.new(0.15)
                    e.Acceleration = Vector3.new(0, -15, 0)
                    e.RotSpeed = NumberRange.new(-45, 45)
                    e.Rate = 100
                    e.Texture = "rbxassetid://7216849703"
                    e.Parent = part
                end)
            end
        end

        local function toolPfxApply(tool)
            if not tool or not toolPfxOn then return end
            toolPfxStrip(tool)
            if toolPfxMode == "stars" then
                toolPfxStars(tool)
            else
                toolPfxSpecks(tool)
            end
        end

        local function toolPfxAll()
            local char = GetCharacter()
            if not char then return end
            for _, child in ipairs(char:GetChildren()) do
                if child:IsA("Tool") then
                    toolPfxTracked[child] = true
                    toolPfxApply(child)
                end
            end
        end

        local function toolPfxWatch(char)
            if toolPfxAddConn then toolPfxAddConn:Disconnect() end
            if toolPfxRemConn then toolPfxRemConn:Disconnect() end
            if not char then return end

            toolPfxAddConn = char.ChildAdded:Connect(function(child)
                if child:IsA("Tool") and toolPfxOn then
                    task.wait(0.1)
                    toolPfxTracked[child] = true
                    toolPfxApply(child)
                end
            end)

            toolPfxRemConn = char.ChildRemoved:Connect(function(child)
                if child:IsA("Tool") and toolPfxTracked[child] then
                    toolPfxStrip(child)
                    toolPfxTracked[child] = nil
                end
            end)
        end

        local function toolPfxClear()
            for tool in pairs(toolPfxTracked) do
                if tool and tool.Parent then toolPfxStrip(tool) end
            end
            toolPfxTracked = {}
        end

        Toggles.particles:OnChanged(function(val)
            toolPfxOn = val
            if val then
                toolPfxMode = (Options.particlestype and Options.particlestype.Value) or "stars"
                toolPfxColor = (Options.particlescolor and Options.particlescolor.Value) or toolPfxColor
                toolPfxAll()
                toolPfxWatch(GetCharacter())

                if toolPfxCharConn then toolPfxCharConn:Disconnect() end
                toolPfxCharConn = Player.CharacterAdded:Connect(function(newChar)
                    toolPfxTracked = {}
                    task.wait(0.5)
                    if toolPfxOn then
                        toolPfxAll()
                        toolPfxWatch(newChar)
                    end
                end)
            else
                if toolPfxCharConn then toolPfxCharConn:Disconnect() toolPfxCharConn = nil end
                if toolPfxAddConn then toolPfxAddConn:Disconnect() toolPfxAddConn = nil end
                if toolPfxRemConn then toolPfxRemConn:Disconnect() toolPfxRemConn = nil end
                toolPfxClear()
            end
        end)

        Options.particlestype:OnChanged(function(val)
            toolPfxMode = val or "stars"
            if toolPfxOn then
                for tool in pairs(toolPfxTracked) do
                    if tool and tool.Parent then toolPfxApply(tool) end
                end
            end
        end)

        Options.particlescolor:OnChanged(function(col)
            toolPfxColor = col
            if not toolPfxOn then return end
            local seq = ColorSequence.new(col)
            for tool in pairs(toolPfxTracked) do
                if tool and tool.Parent then
                    for _, part in ipairs(tool:GetDescendants()) do
                        if part:IsA("BasePart") then
                            local a = part:FindFirstChild(STARS_NAME)
                            local b = part:FindFirstChild(SPECKS_NAME)
                            if a then a.Color = seq end
                            if b then b.Color = seq end
                        end
                    end
                end
            end
        end)
    end


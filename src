    v.bandCount = function(radius)
        return math.clamp(math.floor(radius / 3), 24, 90)
    end

    v.paintCircleBands = function(pool, center, radius, bands, angle, phase, c1, c2, c3, alpha, visible)
        if not visible or alpha <= 0 or radius <= 0 then
            v.hideBandPool(pool, 1)
            return
        end
        local dx, dy = math.cos(angle), math.sin(angle)
        local nx, ny = -dy, dx
        local step = radius * 2 / bands
        for i = 1, bands do
            local d = -radius + (i - 0.5) * step
            local half = math.sqrt(math.max(radius * radius - d * d, 0))
            local ox, oy = nx * d, ny * d
            local line = v.getBandLine(pool, i)
            line.From = Vector2.new(center.X + ox - dx * half, center.Y + oy - dy * half)
            line.To = Vector2.new(center.X + ox + dx * half, center.Y + oy + dy * half)
            line.Thickness = step
            line.Color = v.FillPalette((d / radius + 1) * 0.5 + phase, c1, c2, c3)
            line.Transparency = alpha
            line.Visible = true
        end
        v.hideBandPool(pool, bands + 1)
    end

    v.paintShapeFill = function(pool, center, points, radius, angle, phase, c1, c2, c3, alpha, visible)
        local count = #points
        if count < 3 or not visible or alpha <= 0 or radius <= 0 then
            v.hideTriPool(pool, 1)
            return
        end
        local dx, dy = math.cos(angle), math.sin(angle)
        for i = 1, count do
            local a0 = points[i]
            local b0 = points[(i % count) + 1]
            local eps = 0
            local ax, ay = a0.X - center.X, a0.Y - center.Y
            local bx, by = b0.X - center.X, b0.Y - center.Y
            local ca, sa = math.cos(-eps), math.sin(-eps)
            local cb, sb = math.cos(eps), math.sin(eps)
            local a = Vector2.new(center.X + ax * ca - ay * sa, center.Y + ax * sa + ay * ca)
            local b = Vector2.new(center.X + bx * cb - by * sb, center.Y + bx * sb + by * cb)
            local rx = ((a.X - center.X) + (b.X - center.X)) / 3
            local ry = ((a.Y - center.Y) + (b.Y - center.Y)) / 3
            local d = -rx * dy + ry * dx
            local tri = v.getTriSegment(pool, i)
            tri.PointA = center
            tri.PointB = a
            tri.PointC = b
            tri.Color = v.FillPalette(math.clamp(d / radius * 0.5 + 0.5, 0, 1) + phase, c1, c2, c3)
            tri.Transparency = alpha
            tri.Visible = true
        end
        v.hideTriPool(pool, count + 1)
    end


    do
        local enabled, hooked, targetCf, realCf, hrp, oldIdx = false, false

        local function getRoot()
            local char = Player and Player.Character
            if not char then return nil end
            local hum = char:FindFirstChildOfClass("Humanoid")
            return (hum and hum.RootPart) or char:FindFirstChild("HumanoidRootPart")
        end

        v.DesyncApi = {}

        v.DesyncApi.install = function()
            if hooked then return true end
            if type(hookmetamethod) ~= 'function' or type(checkcaller) ~= 'function' then
                return false
            end

            local wrap = (type(newcclosure) == 'function') and newcclosure or function(f) return f end

            local ok = pcall(function()
                oldIdx = hookmetamethod(game, "__index", wrap(function(self, key)
                    if enabled and key == "CFrame" and realCf and self == hrp and not checkcaller() then
                        return realCf
                    end
                    return oldIdx(self, key)
                end))
            end)
            if not ok or oldIdx == nil then return false end

            hooked = true

            RunService.Heartbeat:Connect(function()
                if not enabled then return end
                hrp = getRoot()
                if not hrp then return end
                realCf = hrp.CFrame
                hrp.CFrame = targetCf or realCf
                RunService.RenderStepped:Wait()

                if hrp and hrp.Parent and realCf then
                    hrp.CFrame = realCf
                end
            end)

            return true
        end

        v.DesyncApi.start = function()
            if not v.DesyncApi.install() then return false end
            hrp = getRoot()
            if hrp then realCf = hrp.CFrame end
            enabled = true
            return true
        end

        v.DesyncApi.stop = function()
            enabled = false
            targetCf = nil

            local root = getRoot()
            if root and realCf then pcall(function() root.CFrame = realCf end) end
            realCf = nil
        end

        v.DesyncApi.running = function() return enabled end

        v.DesyncApi.move = function(pos)
            local t = typeof(pos)
            if t == "CFrame" then
                targetCf = pos
            elseif t == "Vector3" then
                targetCf = CFrame.new(pos)
            else
                return nil
            end
            return targetCf
        end

        v.DesyncApi.sync = function()
            targetCf = nil
            return hrp and hrp.CFrame
        end

        v.DesyncApi.desyncPos = function()
            return (targetCf and targetCf.Position) or (realCf and realCf.Position)
        end

		v.DesyncApi.desyncCFrame = function()
			return targetCf or realCf
		end

        v.DesyncApi.rawPos = function()
            return realCf and realCf.Position
        end

        v.DesyncApi.rawCf = function()
            return realCf
        end
    end

    v.desyncNum = function(flag, fallback)
        local o = Options[flag]
        local n = o and tonumber(o.Value)
        return n or fallback
    end

    v.desyncSpan = function(axis)
        local lo = v.desyncNum('desyncmin' .. axis, -10)
        local hi = v.desyncNum('desyncmax' .. axis, 10)
        if lo > hi then lo, hi = hi, lo end
        return lo + math.random() * (hi - lo)
    end

    v.voidSpamOn = function()
        local t = v.VoidSpamToggle or (Toggles and Toggles.voidspam)
        return (t and t.Value) == true
    end

    v.voidSpamHold = function(inVoid)
        local s = v.desyncNum(inVoid and 'voidspamin' or 'voidspamout', 0.1)
        if s ~= s or s < 0.01 then return 0.01 end
        return s
    end

    v.voidSpamPhase = function(now)
        if v.VoidSpamUntil == nil or now >= v.VoidSpamUntil then
            v.VoidSpamIn = not v.VoidSpamIn
            v.VoidSpamUntil = now + v.voidSpamHold(v.VoidSpamIn)
        end
        return v.VoidSpamIn == true
    end

    v.voidSpamReset = function()
        v.VoidSpamUntil = nil
        v.VoidSpamIn = nil
    end

    v.desyncLagSpan = function()
        local lo = v.desyncNum('desynclagmin', 1)
        local hi = v.desyncNum('desynclagmax', 2)

        if lo ~= lo then lo = 1 end
        if hi ~= hi then hi = 2 end
        if lo > hi then lo, hi = hi, lo end
        if lo < 0.05 then lo = 0.05 end
        if hi < lo then hi = lo end
        return lo + math.random() * (hi - lo)
    end

    v.desyncLagPhase = function(now)
        if v.DesyncLagUntil == nil or now >= v.DesyncLagUntil then
            v.DesyncLagHold = not v.DesyncLagHold
            if v.DesyncLagHold then

                v.DesyncLagUntil = now + v.desyncLagSpan()
                v.DesyncLagAt = nil
            else

                v.DesyncLagUntil = now + 0.05
            end
        end
        return v.DesyncLagHold == true
    end

    v.desyncLagPoint = function()
        local at = v.DesyncLagAt
        local raw = v.DesyncApi.rawPos()
        if at and raw and (raw - at.Position).Magnitude > 500 then
            at = nil
        end
        if at == nil then
            at = v.DesyncApi.rawCf()
            v.DesyncLagAt = at
        end
        return at
    end

    v.desyncLagReset = function()
        v.DesyncLagUntil = nil
        v.DesyncLagHold = nil
        v.DesyncLagAt = nil
    end

    v.desyncFinite = function(p)
        if p == nil then return false end
        if p.X ~= p.X or p.Y ~= p.Y or p.Z ~= p.Z then return false end
        return math.abs(p.X) < 1e9 and math.abs(p.Y) < 1e9 and math.abs(p.Z) < 1e9
    end

    v.desyncStep = function()
        if v.voidSpamOn() then
            if v.voidSpamPhase(os.clock()) then
                v.DesyncApi.move(Vector3.new(math.huge, math.huge, math.huge))
            else
                v.DesyncApi.sync()
            end
            return
        end

        local mode = v.DesyncMode and v.DesyncMode.Value

        if mode == 'nan' then
            v.DesyncApi.move(Vector3.new(math.huge, math.huge, math.huge))
        elseif mode == 'random' then
            v.DesyncApi.move(Vector3.new(
                math.random(-4000000, 4000000),
                math.random(-4000000, 4000000),
                math.random(-4000000, 4000000)
            ))
        elseif mode == 'offset' then
            local raw = v.DesyncApi.rawPos()
            if raw then
                v.DesyncApi.move(raw + Vector3.new(
                    v.desyncSpan('x'), v.desyncSpan('y'), v.desyncSpan('z')
                ))
            end
        elseif mode == 'fake lag' then
            if v.desyncLagPhase(os.clock()) then
                local at = v.desyncLagPoint()
                if at then v.DesyncApi.move(at) end
            else
                v.DesyncApi.sync()
            end
        end
    end


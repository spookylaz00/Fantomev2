    if getgenv().orbitEnabled then return end

    local target = v.SilentStates.Enabled and v.SilentStates.Target or nil
    local char = target and target.Character
    local targetPart = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso"))

    if not targetPart then
        if so.Active then v.stopSilentOrbit() end
        return
    end

    local myRoot = GetRootPart()
    if not myRoot then return end

    if not so.Active then
        so.Active = true
        so.OriginalPosition = myRoot.CFrame
        v.saveCamera()
    end

    v.orbitAngleSilent = v.orbitAngleSilent + (so.Speed or 1) * dt * 2
    local radius = so.Distance or 10
    local center = targetPart.Position
    local pos = center + Vector3.new(math.sin(v.orbitAngleSilent) * radius, so.Height or 0, math.cos(v.orbitAngleSilent) * radius)
    myRoot.CFrame = CFrame.new(pos, center)
end)


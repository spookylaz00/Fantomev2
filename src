local GUI_TEXT_FONT = Enum.Font.GothamMedium

local Canvas = {}
Canvas.__index = Canvas

local function newCanvas(kind, parent)
	local holder = nil
	if kind == "gui" then
		holder = Instance.new("Frame")
		holder.Name = "esp"
		holder.BackgroundTransparency = 1
		holder.Size = UDim2.fromScale(1, 1)
		holder.Visible = false
		holder.Parent = parent
	end
	return setmetatable({
		kind = kind, holder = holder,
		lines = {}, rects = {}, texts = {}, tris = {},
		nl = 0, nr = 0, nt = 0, ng = 0,
		pl = 0, pr = 0, pt = 0, pg = 0,
	}, Canvas)
end

function Canvas:begin()
	self.nl, self.nr, self.nt, self.ng = 0, 0, 0, 0
end

local function hideFrom(list, from, to, gui)
	for i = from, to do
		local e = list[i]
		if e and e.v then
			if gui then e.g.Visible = false else e.o.Visible = false end
			e.v = false
		end
	end
end

function Canvas:finish()
	local gui = self.kind == "gui"
	hideFrom(self.lines, self.nl + 1, self.pl, gui)
	hideFrom(self.rects, self.nr + 1, self.pr, gui)
	hideFrom(self.texts, self.nt + 1, self.pt, gui)
	hideFrom(self.tris, self.ng + 1, self.pg, gui)
	self.pl, self.pr, self.pt, self.pg = self.nl, self.nr, self.nt, self.ng
	if gui then
		local any = (self.nl + self.nr + self.nt) > 0
		if self.holder.Visible ~= any then self.holder.Visible = any end
	end
end

function Canvas:hide()
	self:begin()
	self:finish()
end

function Canvas:destroy()
	local gui = self.kind == "gui"
	for _, list in ipairs({ self.lines, self.rects, self.texts, self.tris }) do
		for i = 1, #list do
			local e = list[i]
			if gui then
				pcall(function() e.g:Destroy() end)
			else
				pcall(function() e.o:Remove() end)
			end
		end
		table.clear(list)
	end
	if self.holder then pcall(function() self.holder:Destroy() end) end
	self.pl, self.pr, self.pt, self.pg = 0, 0, 0, 0
end

function Canvas:line(x1, y1, x2, y2, col, thick, alpha, z)
	local i = self.nl + 1
	self.nl = i
	local e = self.lines[i]
	if self.kind == "drawing" then
		if not e then
			local d = Drawing.new("Line")
			d.Visible = false
			e = { o = d }
			self.lines[i] = e
		end
		local d = e.o
		d.From = Vector2.new(x1, y1)
		d.To = Vector2.new(x2, y2)
		if e.c ~= col then d.Color = col e.c = col end
		if e.t ~= thick then d.Thickness = thick e.t = thick end
		if e.a ~= alpha then d.Transparency = alpha e.a = alpha end
		if e.z ~= z then d.ZIndex = z e.z = z end
		if not e.v then d.Visible = true e.v = true end
	else
		if not e then
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.AnchorPoint = Vector2.new(0.5, 0.5)
			f.Visible = false
			f.Parent = self.holder
			e = { g = f }
			self.lines[i] = e
		end
		local f = e.g
		local dx, dy = x2 - x1, y2 - y1
		local len = math.sqrt(dx * dx + dy * dy)
		f.Position = UDim2.fromOffset((x1 + x2) * 0.5, (y1 + y2) * 0.5)
		f.Size = UDim2.fromOffset(len + thick * 0.5, thick)
		f.Rotation = math.deg(math.atan2(dy, dx))
		if e.c ~= col then f.BackgroundColor3 = col e.c = col end
		if e.a ~= alpha then f.BackgroundTransparency = 1 - alpha e.a = alpha end
		if e.z ~= z then f.ZIndex = z e.z = z end
		if not e.v then f.Visible = true e.v = true end
	end
end

function Canvas:rect(x, y, w, h, col, alpha, z)
	local i = self.nr + 1
	self.nr = i
	local e = self.rects[i]
	if self.kind == "drawing" then
		if not e then
			local d = Drawing.new("Square")
			d.Visible = false
			d.Filled = true
			d.Thickness = 1
			e = { o = d }
			self.rects[i] = e
		end
		local d = e.o
		d.Position = Vector2.new(x, y)
		d.Size = Vector2.new(w, h)
		if e.c ~= col then d.Color = col e.c = col end
		if e.a ~= alpha then d.Transparency = alpha e.a = alpha end
		if e.z ~= z then d.ZIndex = z e.z = z end
		if not e.v then d.Visible = true e.v = true end
	else
		if not e then
			local f = Instance.new("Frame")
			f.BorderSizePixel = 0
			f.Visible = false
			f.Parent = self.holder
			e = { g = f }
			self.rects[i] = e
		end
		local f = e.g
		f.Position = UDim2.fromOffset(x, y)
		f.Size = UDim2.fromOffset(w, h)
		if e.c ~= col then f.BackgroundColor3 = col e.c = col end
		if e.a ~= alpha then f.BackgroundTransparency = 1 - alpha e.a = alpha end
		if e.z ~= z then f.ZIndex = z e.z = z end
		if not e.v then f.Visible = true e.v = true end
	end
end

function Canvas:text(str, x, y, size, col, center, z)
	local i = self.nt + 1
	self.nt = i
	local e = self.texts[i]
	if self.kind == "drawing" then
		if not e then
			local d = Drawing.new("Text")
			d.Visible = false
			d.Outline = true
			d.Font = 2
			e = { o = d }
			self.texts[i] = e
		end
		local d = e.o
		if e.s ~= str then d.Text = str e.s = str end
		d.Position = Vector2.new(x, y)
		if e.sz ~= size then d.Size = size e.sz = size end
		if e.c ~= col then d.Color = col e.c = col end
		if e.ce ~= center then d.Center = center e.ce = center end
		if e.z ~= z then d.ZIndex = z e.z = z end
		if not e.v then d.Visible = true e.v = true end
	else
		if not e then
			local l = Instance.new("TextLabel")
			l.BackgroundTransparency = 1
			l.BorderSizePixel = 0
			l.Font = GUI_TEXT_FONT
			l.TextStrokeTransparency = 0.25
			l.TextStrokeColor3 = ESP_BLACK
			l.AutomaticSize = Enum.AutomaticSize.XY
			l.Size = UDim2.fromOffset(0, 0)
			l.RichText = true
			l.Visible = false
			l.Parent = self.holder
			e = { g = l }
			self.texts[i] = e
		end
		local l = e.g
		if e.s ~= str then l.Text = str e.s = str end
		l.Position = UDim2.fromOffset(x, y)
		if e.sz ~= size then l.TextSize = size e.sz = size end
		if e.c ~= col then l.TextColor3 = col e.c = col end
		if e.ce ~= center then l.AnchorPoint = center and Vector2.new(0.5, 0) or Vector2.new(0, 0) e.ce = center end
		if e.z ~= z then l.ZIndex = z e.z = z end
		if not e.v then l.Visible = true e.v = true end
	end
end

local function espHex(col)
	return string.format("#%02x%02x%02x", math.floor(col.R * 255 + 0.5), math.floor(col.G * 255 + 0.5), math.floor(col.B * 255 + 0.5))
end

local function espEscape(ch)
	if ch == "<" then return "&lt;" elseif ch == ">" then return "&gt;" elseif ch == "&" then return "&amp;" end
	return ch
end

function Canvas:gradText(str, x, y, size, c1, c2, c3, phase, z)
	local len = #str
	if len == 0 then return end
	local denom = math.max(1, len - 1)
	if self.kind == "gui" then
		local parts = {}
		for i = 1, len do
			local col
			if phase and phase ~= 0 then
				col = v.Grad3W((i - 1) / denom + phase, c1, c2, c3)
			else
				col = v.Grad3((i - 1) / denom, c1, c2, c3)
			end
			parts[i] = '<font color="' .. espHex(col) .. '">' .. espEscape(string.sub(str, i, i)) .. "</font>"
		end
		self:text(table.concat(parts), x, y, size, ESP_WHITE, true, z)
		return
	end
	local total = 0
	local widths = {}
	local start = self.nt
	for i = 1, len do
		self:text(string.sub(str, i, i), 0, 0, size, ESP_WHITE, false, z)
		local d = self.texts[self.nt].o
		local b = d.TextBounds
		local w = (b and b.X or 0)
		if w <= 0 then w = size * 0.5 end
		widths[i] = w
		total = total + w
	end
	local cx = x - total * 0.5
	for i = 1, len do
		local e = self.texts[start + i]
		local col
		if phase and phase ~= 0 then
			col = v.Grad3W((i - 1) / denom + phase, c1, c2, c3)
		else
			col = v.Grad3((i - 1) / denom, c1, c2, c3)
		end
		e.o.Position = Vector2.new(cx, y)
		if e.c ~= col then e.o.Color = col e.c = col end
		cx = cx + widths[i]
	end
end

function Canvas:tri(ax, ay, bx, by, cx, cy, col, alpha, z)
	if self.kind ~= "drawing" then return end
	local i = self.ng + 1
	self.ng = i
	local e = self.tris[i]
	if not e then
		local d = Drawing.new("Triangle")
		d.Visible = false
		d.Filled = true
		e = { o = d }
		self.tris[i] = e
	end
	local d = e.o
	d.PointA = Vector2.new(ax, ay)
	d.PointB = Vector2.new(bx, by)
	d.PointC = Vector2.new(cx, cy)
	if e.c ~= col then d.Color = col e.c = col end
	if e.a ~= alpha then d.Transparency = alpha e.a = alpha end
	if e.z ~= z then d.ZIndex = z e.z = z end
	if not e.v then d.Visible = true e.v = true end
end


    v.safeLookCF = function(pos, look)
        if look.Magnitude < 0.001 then look = Vector3.new(0, 0, -1) end
        look = look.Unit
        if math.abs(look.Y) > 0.99 then
            local flat = Vector3.new(look.X, 0, look.Z)
            if flat.Magnitude < 0.001 then flat = Vector3.new(0, 0, -1) end
            local sign = look.Y > 0 and 1 or -1
            look = (flat.Unit * 0.141 + Vector3.new(0, 0.99 * sign, 0)).Unit
        end
        return CFrame.new(pos, pos + look)
    end

    v.saveCamera = function()
        if not v.CameraRestoreCF then
            v.CameraRestoreCF = Camera.CFrame
        end
    end

    v.restoreCamera = function(duration)
        local saved = v.CameraRestoreCF
        v.CameraRestoreCF = nil

        if not saved then
            if v.cameraRestoreActive then return end
            Camera.CameraType = Enum.CameraType.Custom
            Camera.CameraSubject = GetHumanoid()
            return
        end

        v.cameraRestoreToken = v.cameraRestoreToken + 1
        local token = v.cameraRestoreToken

        task.spawn(function()
            v.cameraRestoreActive = true
            duration = 0
            Camera.CameraType = Enum.CameraType.Scriptable
            local startCF = Camera.CFrame
            local pos = startCF.Position
            local t = 0
            while t < duration do
                if token ~= v.cameraRestoreToken then
                    v.cameraRestoreActive = false
                    return
                end
                t = t + RunService.RenderStepped:Wait()
                local a = math.clamp(t / duration, 0, 1)
                a = 1 - (1 - a) ^ 3

                Camera.CFrame = v.safeLookCF(pos, startCF:Lerp(saved, a).LookVector)
            end
            Camera.CFrame = v.safeLookCF(pos, saved.LookVector)
            Camera.CameraType = Enum.CameraType.Custom
            Camera.CameraSubject = GetHumanoid()
            v.cameraRestoreActive = false
        end)
    end


    function v.charParts(char)
        if not char then return nil end
        local entry = v.PartCache[char]
        if entry then return entry.parts end

        local parts = {}
        local n = 0
        for _, d in ipairs(char:GetDescendants()) do
            if d:IsA("BasePart") then
                n = n + 1
                parts[n] = d
            end
        end

        entry = { parts = parts }
        entry.conn = char.DescendantAdded:Connect(function(d)
            if d:IsA("BasePart") then
                local list = entry.parts
                list[#list + 1] = d
            end
        end)
        v.PartCache[char] = entry
        return parts
    end

    function v.noCollide(char)
        local parts = v.charParts(char)
        if not parts then return end
        for i = 1, #parts do
            local pt = parts[i]
            if pt.Parent and pt.CanCollide then pt.CanCollide = false end
        end
    end


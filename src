                elseif not adorn or not adorn.Parent then

                    local size = Options.iyhitboxsize and Options.iyhitboxsize.Value or 10
                    v.IYHitboxAdornments[plr] = IYMakeAdornment(root, size)
                else
                    local col = IYHitboxColor()

local function espColors(c, sameTeam)
	if c.rainbow then
		local r = c.rainbowCol
		return r, r, r, r, r, r, r
	end
	local function O(flag) local o = Options[flag] return o and o.Value or ESP_WHITE end
	if sameTeam and c.teamCols then
		return O("teamboxcolor"), O("teamnamecolor"), O("teamdistancecolor"), O("teamtracercolor"),
			O("teamusernamecolor"), O("teamtoolcolor"), O("teamhealthbarcolor")
	elseif not sameTeam and c.enemyCols then
		return O("enemyboxcolor"), O("enemynamecolor"), O("enemydistancecolor"), O("enemytracercolor"),
			O("enemyusernamecolor"), O("enemytoolcolor"), O("enemyhealthbarcolor")
	end
	return O("boxcolor"), O("namecolor"), O("distancecolor"), O("tracercolor"),
		O("usernamecolor"), O("toolcolor"), (not c.healthGrad) and O("healthbarcolor") or nil
end

local function espPick(c, sameTeam, base, flag)
	if c.rainbow then return base end
	local pre
	if sameTeam and c.teamCols then pre = "team" elseif (not sameTeam) and c.enemyCols then pre = "enemy" end
	if pre then
		local o = Options[pre .. flag]
		if o and o.Value then return o.Value end
	end
	return base
end

local function espBoxSide(cv, ax, ay, bx, by, col, thick, c, t0, t1, g1, g2, g3)
	cv:line(ax, ay, bx, by, ESP_BLACK, thick + 2, 0.6, 1)
	if not c.boxGrad then
		cv:line(ax, ay, bx, by, col, thick, 1, 2)
		return
	end
	local length = math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2)
	local steps = math.clamp(math.floor(length / 10), 8, 24)
	for s = 1, steps do
		local f0, f1 = (s - 1) / steps, s / steps
		local tt = t0 + (t1 - t0) * ((f0 + f1) * 0.5)
		cv:line(ax + (bx - ax) * f0, ay + (by - ay) * f0, ax + (bx - ax) * f1, ay + (by - ay) * f1,
			v.Grad3W(tt + c.phase, g1, g2, g3), thick, 1, 2)
	end
end

local function espBones(o, char)
	if o.BoneChar == char and o.Bones then return o.Bones end
	local list = char:FindFirstChild("UpperTorso") and ESP_BONES_R15 or ESP_BONES_R6
	local cache = {}
	for i = 1, #list do
		cache[i] = { char:FindFirstChild(list[i][1]), char:FindFirstChild(list[i][2]) }
	end
	o.Bones = cache
	o.BoneChar = char
	return cache
end

local function espDrawTarget(cv, t, c)
	local proj = t.proj
	local root, head = t.root, t.head
	local rx, ry, _, on = proj(root.Position)
	if not on then return false end
	local _, ty = proj(head.Position + Vector3.new(0, 0.7, 0))
	local _, by = proj(root.Position - Vector3.new(0, 3, 0))
	local top = math.min(ty, by)
	local h = math.max(math.abs(by - ty), 4)
	local w = h * 0.62
	local x0 = math.floor(rx - w * 0.5 + 0.5)
	local y0 = math.floor(top + 0.5)
	w = math.floor(w + 0.5)
	h = math.floor(h + 0.5)

	local boxCol, nameCol, distCol, tracerCol, userCol, toolCol, hpCol = espColors(c, t.sameTeam)
	local ts = c.textSize

	if c.fill and c.fillAlpha > 0.01 then
		local fillA = espPick(c, t.sameTeam, c.fill1, "boxfillcolor")
		local fillB = espPick(c, t.sameTeam, c.fill2, "boxfillcolor2")
		local fillC = espPick(c, t.sameTeam, c.fill3, "boxfillcolor3")
		local bands = 40
		local direction = Vector2.new(math.cos(c.fillRotation), math.sin(c.fillRotation))
		local normal = Vector2.new(-direction.Y, direction.X)
		local center = Vector2.new(x0 + w * 0.5, y0 + h * 0.5)
		local reach = math.abs(normal.X) * w * 0.5 + math.abs(normal.Y) * h * 0.5
		local thickness = math.max(1, reach * 2 / bands)
		local function endpoints(offset)
			local point = center + normal * offset
			local hits = {}
			local function add(x, y)
				if x >= x0 - 0.01 and x <= x0 + w + 0.01 and y >= y0 - 0.01 and y <= y0 + h + 0.01 then
					local nextHit = Vector2.new(x, y)
					for _, hit in ipairs(hits) do if (hit - nextHit).Magnitude < 0.01 then return end end
					hits[#hits + 1] = nextHit
				end
			end
			if math.abs(direction.X) > 0.0001 then
				local left = (x0 - point.X) / direction.X
				local right = (x0 + w - point.X) / direction.X
				add(x0, point.Y + direction.Y * left)
				add(x0 + w, point.Y + direction.Y * right)
			end
			if math.abs(direction.Y) > 0.0001 then
				local top = (y0 - point.Y) / direction.Y
				local bottom = (y0 + h - point.Y) / direction.Y
				add(point.X + direction.X * top, y0)
				add(point.X + direction.X * bottom, y0 + h)
			end
			return hits[1], hits[2]
		end
		for i = 1, bands do
			local fraction = (i - 0.5) / bands
			local first, second = endpoints((fraction * 2 - 1) * reach)
			if first and second then
				local color = v.FillPalette(fraction + c.phase + os.clock() * c.fillSpeed, fillA, fillB, fillC)
				cv:line(first.X, first.Y, second.X, second.Y, color, thickness, c.fillAlpha, 0)
			end
		end
	end

	if c.box then
		local th = c.boxThick
		local x1, y1, x2, y2 = x0, y0, x0 + w, y0 + h
		local g1 = boxCol
		local g2 = espPick(c, t.sameTeam, c.box2 or boxCol, "boxcolor2")
		local g3 = espPick(c, t.sameTeam, c.box3 or boxCol, "boxcolor3")
		if c.boxStyle == "cornered" then
			local lx, ly = math.max(3, w * 0.3), math.max(3, h * 0.22)
			espBoxSide(cv, x1, y1, x1 + lx, y1, boxCol, th, c, 0, 0.1, g1, g2, g3)
			espBoxSide(cv, x2 - lx, y1, x2, y1, boxCol, th, c, 0.15, 0.25, g1, g2, g3)
			espBoxSide(cv, x2, y1, x2, y1 + ly, boxCol, th, c, 0.25, 0.35, g1, g2, g3)
			espBoxSide(cv, x2, y2 - ly, x2, y2, boxCol, th, c, 0.4, 0.5, g1, g2, g3)
			espBoxSide(cv, x2, y2, x2 - lx, y2, boxCol, th, c, 0.5, 0.6, g1, g2, g3)
			espBoxSide(cv, x1 + lx, y2, x1, y2, boxCol, th, c, 0.65, 0.75, g1, g2, g3)
			espBoxSide(cv, x1, y2, x1, y2 - ly, boxCol, th, c, 0.75, 0.85, g1, g2, g3)
			espBoxSide(cv, x1, y1 + ly, x1, y1, boxCol, th, c, 0.9, 1, g1, g2, g3)
		else
			espBoxSide(cv, x1, y1, x2, y1, boxCol, th, c, 0, 0.25, g1, g2, g3)
			espBoxSide(cv, x2, y1, x2, y2, boxCol, th, c, 0.25, 0.5, g1, g2, g3)
			espBoxSide(cv, x2, y2, x1, y2, boxCol, th, c, 0.5, 0.75, g1, g2, g3)
			espBoxSide(cv, x1, y2, x1, y1, boxCol, th, c, 0.75, 1, g1, g2, g3)
		end
	end

	local cx = x0 + w * 0.5
	local lineH = ts + 1
	local up = c.namePlace == "up"
	local aboveY = y0 - 3
	local belowY = y0 + h + 3

	local function put(str, col, isUp, grad)
		local y
		if isUp then
			aboveY = aboveY - lineH
			y = aboveY
		else
			y = belowY
			belowY = belowY + lineH
		end
		if grad then
			cv:gradText(str, cx, y, ts, col, espPick(c, t.sameTeam, c.tg2 or col, "textgradcolor2"), espPick(c, t.sameTeam, c.tg3 or col, "textgradcolor3"), c.phase, 4)
		else
			cv:text(str, cx, y, ts, col, true, 4)
		end
	end

	if up then
		if c.user then put("@" .. t.user, userCol, true, c.textGrad) end
		if c.name then put(t.name, nameCol, true, c.textGrad) end
	else
		if c.name then put(t.name, nameCol, false, c.textGrad) end
		if c.user then put("@" .. t.user, userCol, false, c.textGrad) end
	end
	if c.dist then put(string.format("%.0fm", t.dist), distCol, false, false) end
	if c.tool and t.tool then put(t.tool, toolCol, false, false) end

	if c.tracers then
		local ox, oy = t.ox, t.oy
		local tx, ty2 = cx, y0 + h
		if c.tracerMode ~= "Bottom" then tx, ty2 = rx, ry end
		if c.bend then
			local mx, my = (ox + tx) * 0.5, (oy + ty2) * 0.5
			local dx, dy = tx - ox, ty2 - oy
			local ctrlX, ctrlY = mx, my + math.sqrt(dx * dx + dy * dy) * c.bendAmt
			local px, py = ox, oy
			for i = 1, ESP_BEND_SEGS do
				local s = i / ESP_BEND_SEGS
				local u = 1 - s
				local qx = ox * u * u + ctrlX * 2 * u * s + tx * s * s
				local qy = oy * u * u + ctrlY * 2 * u * s + ty2 * s * s
				if c.tracerOut then cv:line(px, py, qx, qy, c.outlineCol, 3, 1, 1) end
				cv:line(px, py, qx, qy, tracerCol, 1, 1, 2)
				px, py = qx, qy
			end
		else
			if c.tracerOut then cv:line(ox, oy, tx, ty2, c.outlineCol, 3, 1, 1) end
			cv:line(ox, oy, tx, ty2, tracerCol, 1, 1, 2)
		end
	end

	if c.health then
		local hum = t.hum
		local maxHp = hum.MaxHealth
		if maxHp <= 0 then maxHp = 100 end
		local frac = math.clamp(hum.Health / maxHp, 0, 1)
		local barX = x0 - 6
		local fillH = math.floor(h * frac + 0.5)
		cv:rect(barX - 1, y0 - 1, 5, h + 2, ESP_BLACK, 0.75, 1)
		if hpCol then
			if fillH > 0 then cv:rect(barX, y0 + h - fillH, 3, fillH, hpCol, 1, 2) end
		else
			local count = 0
			if fillH >= 1 then count = math.clamp(math.floor(fillH / 4), 1, ESP_HEALTH_SEGS) end
			local fillTop = y0 + h - fillH
			local prevY = fillTop
			for i = 1, count do
				local nextY = (i == count) and (y0 + h) or math.floor(fillTop + fillH * i / count + 0.5)
				local mid = ((prevY + nextY) * 0.5 - y0) / h
				if nextY > prevY then
					cv:rect(barX, prevY, 3, nextY - prevY, espHealthGradient(mid, c.hp1, c.hp2, c.hp3, c.hp4), 1, 2)
				end
				prevY = nextY
			end
		end
		if frac < 0.999 then
			cv:text(tostring(math.floor(hum.Health + 0.5)), barX + 1, y0 + h - fillH - math.floor(ts * 0.5), math.max(ts - 2, 8), c.healthTextCol, true, 4)
		end
	end

	if c.skeleton and t.char then
		local bones = espBones(t.o, t.char)
		local col = c.rainbow and c.rainbowCol or espPick(c, t.sameTeam, c.skelCol, "skeletoncolor")
		local seen = t.projCache
		table.clear(seen)
		for i = 1, #bones do
			local pa, pb = bones[i][1], bones[i][2]
			if pa and pb and pa.Parent and pb.Parent then
				local a = seen[pa]
				if not a then
					local ax, ay = proj(pa.Position)
					a = { ax, ay }
					seen[pa] = a
				end
				local b = seen[pb]
				if not b then
					local bx2, by2 = proj(pb.Position)
					b = { bx2, by2 }
					seen[pb] = b
				end
				cv:line(a[1], a[2], b[1], b[2], col, 1, 1, 3)
			end
		end
	end

	if c.hat then
		local col = c.rainbow and c.rainbowCol or c.hatCol
		local base = head.Position + Vector3.new(0, 0.55, 0)
		local tipX, tipY = proj(base + Vector3.new(0, 0.75, 0))
		local full = math.pi * 2
		local px, py
		for i = 0, ESP_HAT_SIDES do
			local ang = (i / ESP_HAT_SIDES) * full
			local qx, qy = proj(base + Vector3.new(math.cos(ang) * 2, 0, math.sin(ang) * 2))
			if px then
				cv:tri(tipX, tipY, px, py, qx, qy, col, 0.35, 1)
				cv:line(px, py, qx, qy, col, 1, 1, 2)
			end
			px, py = qx, qy
		end
	end
	return true
end


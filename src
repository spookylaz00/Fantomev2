        cache[part] = { part.Material, part.Color, part:IsA("MeshPart") and part.TextureID or nil, part.Reflectance }
    end
    if part.Material ~= mat then part.Material = mat end
    if color and part.Color ~= color then part.Color = color end
    if refl and part.Reflectance ~= refl then part.Reflectance = refl end
    if part:IsA("MeshPart") and part.TextureID ~= "" then part.TextureID = "" end
end


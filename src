    local function GetShapePoints(centerX, centerY, radius, shape)
        local points = {}

        if shape == 'circle' then
            return nil
        elseif shape == 'pentagon' then
            for i = 1, 5 do
                local angle = (i / 5) * math.pi * 2 - math.pi / 2
                local x = centerX + math.cos(angle) * radius
                local y = centerY + math.sin(angle) * radius
                table.insert(points, Vector2.new(x, y))
            end
        elseif shape == 'heart' then
            for i = 0, 20 do
                local t = (i / 20) * math.pi * 2
                local x = 16 * math.sin(t)^3
                local y = -(13 * math.cos(t) - 5 * math.cos(2*t) - 2 * math.cos(3*t) - math.cos(4*t))
                local scale = radius / 17
                table.insert(points, Vector2.new(centerX + x * scale, centerY + y * scale))
            end
        elseif shape == 'star' then
            for i = 1, 10 do
                local angle = (i / 10) * math.pi * 2 - math.pi / 2
                local r = (i % 2 == 1) and radius or (radius * 0.4)
                local x = centerX + math.cos(angle) * r
                local y = centerY + math.sin(angle) * r
                table.insert(points, Vector2.new(x, y))
            end
        elseif shape == 'ds' then

            return "ds"
        end

        return points
    end

    local function UpdateFovShape()
        local targetPos = v.camlockAimCenter()
        local targetRadius = v.CamlockStates.FovSize

        local now = os.clock()
        local step = math.clamp(now - (v.FovLastTick or now), 0, 0.25)
        v.FovLastTick = now
        local lerpSpeed = math.clamp((Options.camlockFovLerp and Options.camlockFovLerp.Value) or 1, 0.01, 1)
        lerpSpeed = 1 - (1 - lerpSpeed) ^ math.clamp(step * 60, 0.1, 8)
        v.FovCurrentPos = v.FovCurrentPos:Lerp(targetPos, lerpSpeed)
        v.FovCurrentRadius = v.FovCurrentRadius + (targetRadius - v.FovCurrentRadius) * lerpSpeed

        local centerPos = v.FovCurrentPos
        local shape = v.CamlockStates.FovShape
        local radius = v.FovCurrentRadius
        local color = Options.fovcolor.Value
        local visible = v.CamlockStates.FovEnabled

        local gradient = v.CamlockStates.FovGradient == true
        local outlineOn = (Toggles.camlockfovoutline and Toggles.camlockfovoutline.Value) == true
        local o1 = (Options.camlockoutlinecolor1 and Options.camlockoutlinecolor1.Value) or Color3.new(1, 1, 1)
        local o2 = (Options.camlockoutlinecolor2 and Options.camlockoutlinecolor2.Value) or o1
        local o3 = (Options.camlockoutlinecolor3 and Options.camlockoutlinecolor3.Value) or o2
        local thickness = math.max(1, v.CamlockStates.FovThickness or 2)
        local sides = math.clamp(math.floor(v.CamlockStates.FovSegments or 64), 8, 128)

        local spin = os.clock() * (v.CamlockStates.FovSpin or 0) * 0.1
        local g1 = (Options.fovgrad1 and Options.fovgrad1.Value) or color
        local g2 = (Options.fovgrad2 and Options.fovgrad2.Value) or color
        local g3 = (Options.fovgrad3 and Options.fovgrad3.Value) or color

        local filled = v.CamlockStates.FovFilled == true
        local fillGradient = v.CamlockStates.FovFillGradient == true
		local fillAlpha = 1 - ((Options.camlockFillTransparency and Options.camlockFillTransparency.Value) or 75) / 100
        local f1 = (Options.fovfillgrad1 and Options.fovfillgrad1.Value) or Color3.new(1, 1, 1)
        local f2 = (Options.fovfillgrad2 and Options.fovfillgrad2.Value) or f1
        local f3 = (Options.fovfillgrad3 and Options.fovfillgrad3.Value) or f2
        local fillAngle = math.rad((Options.camlockFillRotation and Options.camlockFillRotation.Value) or 0)
        local fillPhase = os.clock() * ((Options.camlockFillSpeed and Options.camlockFillSpeed.Value) or 0)

        if shape == 'circle' then
            v.FovCircle.Position = centerPos
            v.FovCircle.Radius = radius
            v.FovCircle.NumSides = sides
            v.FovCircle.Thickness = thickness

            v.FovCircle.Filled = false
            v.FovCircle.Transparency = 1
            v.FovCircle.Color = color
            v.FovCircle.Visible = visible and not gradient
            v.FovFillCircle.Visible = false
            v.paintCircleBands("camlockband", centerPos, radius, v.bandCount(radius), fillAngle, fillPhase, f1, f2, f3, fillAlpha, visible and filled)
            v.hideTriPool("camlockfill", 1)
            v.hideTriPool("camlockfill2", 1)

            if gradient then
                v.FovCircleOutline.Visible = false
                local line1, line2, line3 = g1, g2, g3
                v.paintGradientLoop("camlock", v.circlePoints(centerPos, radius, sides), line1, line2, line3, thickness, spin, visible)
            else
                v.FovCircleOutline.Visible = visible
                v.FovCircleOutline.Position = centerPos
                v.FovCircleOutline.Radius = radius
                v.FovCircleOutline.Color = color
                v.FovCircleOutline.NumSides = sides
                v.FovCircleOutline.Thickness = thickness
                v.FovCircleOutline.Filled = false
                v.FovCircleOutline.Transparency = 1
                v.hideGradPool("camlock", 1)
            end

            if outlineOn then
                v.paintGradientLoop("camlockoutline", v.circlePoints(centerPos, radius, sides), o1, o2, o3, thickness, spin, visible)
            else
                v.hideGradPool("camlockoutline", 1)
            end
            for _, line in pairs(v.FovShapeLines) do
                line.Visible = false
            end
        else
            v.FovCircle.Visible = false
            v.FovCircleOutline.Visible = false
            v.FovFillCircle.Visible = false

            v.hideBandPool("camlockband", 1)
            v.hideGradPool("camlockoutline", 1)
            local points = GetShapePoints(centerPos.X, centerPos.Y, radius, shape)
            if points == "ds" then

                local tri1, tri2 = {}, {}
                for i = 0, 2 do
                    local a = math.rad(120 * i - 90)
                    tri1[i+1] = Vector2.new(centerPos.X + math.cos(a)*radius, centerPos.Y + math.sin(a)*radius)
                    local b = math.rad(120 * i + 90)
                    tri2[i+1] = Vector2.new(centerPos.X + math.cos(b)*radius, centerPos.Y + math.sin(b)*radius)
                end

                if filled then

                    v.paintShapeFill("camlockfill", centerPos, tri1, radius, fillAngle, fillPhase, f1, f2, f3, fillAlpha, visible)
                    v.paintShapeFill("camlockfill2", centerPos, tri2, radius, fillAngle, fillPhase, f1, f2, f3, fillAlpha, visible)
                else
                    v.hideTriPool("camlockfill", 1)
                    v.hideTriPool("camlockfill2", 1)
                end

                if gradient then

                    for i = 1, 3 do
                        local ni = (i % 3) + 1
                        local s1 = v.getGradSegment("camlock", i)
                        s1.From = tri1[i]
                        s1.To = tri1[ni]
                        s1.Thickness = thickness
                        s1.Color = v.grad3(g1, g2, g3, (i - 1) / 3 + spin)
                        s1.Transparency = 1
                        s1.Visible = visible

                        local s2 = v.getGradSegment("camlock", i + 3)
                        s2.From = tri2[i]
                        s2.To = tri2[ni]
                        s2.Thickness = thickness
                        s2.Color = v.grad3(g1, g2, g3, (i - 1) / 3 + spin + 0.5)
                        s2.Transparency = 1
                        s2.Visible = visible
                    end
                    v.hideGradPool("camlock", 7)
                    for i = 1, #v.FovShapeLines do v.FovShapeLines[i].Visible = false end
                else
                    v.hideGradPool("camlock", 1)
                    for i = 1, 3 do
                        local ni = (i % 3) + 1
                        v.FovShapeLines[i].From = tri1[i]; v.FovShapeLines[i].To = tri1[ni]
                        v.FovShapeLines[i].Color = color; v.FovShapeLines[i].Transparency = 1
                        v.FovShapeLines[i].Thickness = thickness
                        v.FovShapeLines[i].Visible = visible
                        v.FovShapeLines[i+3].From = tri2[i]; v.FovShapeLines[i+3].To = tri2[ni]
                        v.FovShapeLines[i+3].Color = color; v.FovShapeLines[i+3].Transparency = 1
                        v.FovShapeLines[i+3].Thickness = thickness
                        v.FovShapeLines[i+3].Visible = visible
                    end
                    for i = 7, #v.FovShapeLines do v.FovShapeLines[i].Visible = false end
                end
            elseif points then
                if outlineOn then
                    v.paintGradientLoop("camlockoutline", v.resampleLoop(points, sides), o1, o2, o3, thickness, spin, visible)
                else
                    v.hideGradPool("camlockoutline", 1)
                end
                if filled then
                    v.paintShapeFill("camlockfill", centerPos, v.resampleLoop(points, sides), radius, fillAngle, fillPhase, f1, f2, f3, fillAlpha, visible)
                else
                    v.hideTriPool("camlockfill", 1)
                end
                v.hideTriPool("camlockfill2", 1)

                if gradient then
                    for i = 1, #v.FovShapeLines do v.FovShapeLines[i].Visible = false end
                    v.paintGradientLoop("camlock", v.resampleLoop(points, sides), g1, g2, g3, thickness, spin, visible)
                else
                    v.hideGradPool("camlock", 1)
                    for i = 1, #points do
                        local line = v.FovShapeLines[i]
                        if line then
                            local nextIndex = (i % #points) + 1
                            line.From = points[i]
                            line.To = points[nextIndex]
                            line.Color = color
                            line.Transparency = 1
                            line.Thickness = thickness
                            line.Visible = visible
                        end
                    end

                    for i = #points + 1, #v.FovShapeLines do
                        v.FovShapeLines[i].Visible = false
                    end
                end
            end
        end
    end

    v.camlockCursorBias = Vector2.new(0, 0)
    v.camlockCursorSlack = Vector2.new(0, 0)
    v.camlockCursorWant = nil
    v.camlockCursorWantAt = nil

    v.camlockCursorReady = function()
        if type(isrbxactive) == "function" then
            local ok, active = pcall(isrbxactive)
            if ok and not active then return false end
        end

        local ok, behavior = pcall(function() return UserInputService.MouseBehavior end)
        if ok and behavior ~= nil and behavior ~= Enum.MouseBehavior.Default then
            return false
        end

        return true
    end

    v.camlockMoveMouse = function(destX, destY)
        if not v.camlockCursorReady() then
            v.camlockCursorWant = nil
            v.camlockCursorWantAt = nil
            v.camlockCursorSlack = Vector2.new(0, 0)
            return
        end

        local viewport = Camera.ViewportSize
        destX = math.clamp(destX, 1, math.max(1, viewport.X - 1))
        destY = math.clamp(destY, 1, math.max(1, viewport.Y - 1))

        if type(mousemoveabs) == "function" then

            local want = v.camlockCursorWant
            local wantAt = v.camlockCursorWantAt
            if want and wantAt and (os.clock() - wantAt) < 0.05 then
                local at = GetMousePosition()
                local ex = math.clamp(want.X - at.X, -600, 600)
                local ey = math.clamp(want.Y - at.Y, -600, 600)
                v.camlockCursorBias = Vector2.new(
                    math.clamp(v.camlockCursorBias.X + ex * 0.25, -4096, 4096),
                    math.clamp(v.camlockCursorBias.Y + ey * 0.25, -4096, 4096)
                )
            end

            v.camlockCursorWant = Vector2.new(destX, destY)
            v.camlockCursorWantAt = os.clock()
            v.camlockCursorSlack = Vector2.new(0, 0)
            pcall(mousemoveabs, destX + v.camlockCursorBias.X, destY + v.camlockCursorBias.Y)
            return
        end

        if type(mousemoverel) ~= "function" then return end

        v.camlockCursorWant = nil
        v.camlockCursorWantAt = nil
        local at = GetMousePosition()
        local dx = destX - at.X + v.camlockCursorSlack.X
        local dy = destY - at.Y + v.camlockCursorSlack.Y
        local ix, iy = math.floor(dx + 0.5), math.floor(dy + 0.5)
        v.camlockCursorSlack = Vector2.new(dx - ix, dy - iy)
        if ix == 0 and iy == 0 then return end
        pcall(mousemoverel, ix, iy)
    end

    local function IsInFov(player)
        if not v.CamlockStates.FovEnabled then return true end

        if not player.Character then return false end
        local targetPart = player.Character:FindFirstChild(v.CamlockStates.TargetPart) or player.Character:FindFirstChild("HumanoidRootPart")
        if not targetPart then return false end

        local screenPos, onScreen = GetScreenPosition(targetPart.Position)
        if not onScreen then return false end

        local centerPos = v.camlockAimCenter()
        local distance = (screenPos - centerPos).Magnitude

        return distance <= v.CamlockStates.FovSize
    end

    local function getNearestCamlockPlayer()
        local nearestPlayer = nil
        local shortestScore = math.huge
        local method = v.CamlockStates.TargetMethod or "near mouse"

        for _, player in pairs(Players:GetPlayers()) do
            if player ~= Player and player.Character then
                if IsCamlockWhitelisted(player) then continue end
                if v.CamlockStates.TeamCheck and IsSameTeam(player) then continue end
                if v.CamlockStates.VisibleCheck and not IsVisible(player) then continue end
                if not IsInFov(player) then continue end

                local score = math.huge

                local hum = player.Character:FindFirstChildOfClass("Humanoid")

                if method == "closest to crosshair" or method == "near mouse" then
                    score = GetDistanceFromMouse(player)
                elseif method == "closest to player" then
                    score = GetDistanceFromPlayer(player)
                elseif method == "lowest health" then
                    score = hum and hum.Health or math.huge
                elseif method == "random" then
                    score = math.random()
                else
                    if v.CamlockStates.Mode == 'near mouse' then
                        score = GetDistanceFromMouse(player)
                    else
                        score = GetDistanceFromPlayer(player)
                    end
                end

                if score < shortestScore then
                    shortestScore = score
                    nearestPlayer = player
                end
            end
        end

        return nearestPlayer
    end


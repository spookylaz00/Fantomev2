			end
			local searchH = search and 28 or 0
			local listH = math.min(math.max(shown, 1) * (ROW + 2), 190)
			list.Position = UDim2.fromOffset(4, 4 + searchH)
			list.Size = UDim2.new(1, -8, 0, listH)
			list.CanvasSize = UDim2.fromOffset(0, shown * (ROW + 2))
			drawerH = listH + searchH + 8
		end

		local function filter()
			local q = search and string.lower(search.Text) or ''
			for i = 1, #options do
				local o = options[i]
				o.btn.Visible = (q == '') or (string.find(string.lower(tostring(o.name)), q, 1, true) ~= nil)
			end
			layoutList()
			if isOpen then applyHeight(false) end
		end

		local function build()
			if not list then
				if useSearch or #obj.Values > 10 then
					search = new('TextBox', {
						Text = '',
						PlaceholderText = 'search',
						ClearTextOnFocus = false,
						TextSize = 12,
						TextXAlignment = Enum.TextXAlignment.Left,
						Position = UDim2.fromOffset(4, 4),
						Size = UDim2.new(1, -8, 0, 22),
						Parent = drawer,
					})
					paint(search, 'BackgroundColor3', 'Panel')
					paint(search, 'TextColor3', 'Text')
					paint(search, 'PlaceholderColor3', 'Dim')
					typeface(search)
					round(search)
					new('UIPadding', { PaddingLeft = UDim.new(0, 8), Parent = search })
					search:GetPropertyChangedSignal('Text'):Connect(filter)
				end
				list = new('ScrollingFrame', {
					BackgroundTransparency = 1,
					CanvasSize = UDim2.fromOffset(0, 0),
					ScrollBarThickness = 2,
					ScrollingDirection = Enum.ScrollingDirection.Y,
					Size = UDim2.new(1, -8, 0, 0),
					Parent = drawer,
				})
				paint(list, 'ScrollBarImageColor3', 'Accent')
				new('UIListLayout', { Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
			end

			for i = 1, #options do options[i].btn:Destroy() end
			table.clear(options)
			for i, name in ipairs(obj.Values) do
				local b = new('TextButton', {
					AutoButtonColor = false,
					Text = string.lower(tostring(name)),
					TextSize = 12,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextTruncate = Enum.TextTruncate.AtEnd,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, -4, 0, ROW),
					LayoutOrder = i,
					Parent = list,
				})
				local bc = Instance.new('UICorner')
				bc.CornerRadius = UDim.new(0, math.floor(T.Radius * 0.7 + 0.5))
				bc.Parent = b
				new('UIPadding', { PaddingLeft = UDim.new(0, 12), Parent = b })
				local mark = new('Frame', {
					BackgroundColor3 = Color3.new(1, 1, 1),
					AnchorPoint = Vector2.new(0, 0.5),
					Position = UDim2.new(0, -8, 0.5, 0),
					Size = UDim2.fromOffset(3, 12),
					Visible = false,
					ZIndex = 2,
					Parent = b,
				})
				gradient(mark, 90)
				round(mark, 0.3)
				local o = { btn = b, name = name, mark = mark, hover = false, grad = grad }
				b.MouseEnter:Connect(function() o.hover = true paintOption(o) end)
				b.MouseLeave:Connect(function() o.hover = false paintOption(o) end)
				b.MouseButton1Click:Connect(guardClick(function()
					if multi then
						local set = {}
						for k, on in pairs(obj.Value) do if on then set[k] = true end end
						if set[name] then set[name] = nil else set[name] = true end
						obj:SetValue(set)
					else
						if obj.Value == name and info.AllowNull then
							obj:SetValue(nil)
						else
							obj:SetValue(name)
						end
						me.close()
					end
				end))
				options[i] = o
			end
			built = true
			display()
		end

		local function reveal()
			task.delay(0.18, function()
				if not isOpen then return end
				local col = columnOf(holder)
				if not col then return end
				local s = (Library.WindowScale and Library.WindowScale.Scale) or 1
				local bottom = drawer.AbsolutePosition.Y + drawer.AbsoluteSize.Y
				local limit = col.AbsolutePosition.Y + col.AbsoluteSize.Y
				if bottom > limit then
					col.CanvasPosition = col.CanvasPosition + Vector2.new(0, (bottom - limit) / math.max(s, 0.1) + 8)
				end
			end)
		end

		function me.close()
			if not isOpen then return end
			isOpen = false
			if openDrop == me then openDrop = nil end
			boxStroke.Color = T.Stroke
			applyHeight(true)
			task.delay(0.17, function()
				if not isOpen then drawer.Visible = false end
			end)
		end

		function me.open()
			if isOpen then return end
			if openDrop and openDrop ~= me then openDrop.close() end
			closePopup()
			if not built then build() end
			if search then search.Text = '' end
			isOpen = true
			openDrop = me
			filter()
			drawer.Visible = true
			applyHeight(true)
			reveal()
		end
		me.frame = holder
		obj.Open, obj.Close = me.open, me.close

		function obj:SetValues(vals)
			if type(vals) == 'table' then self.Values = vals end
			built = false
			if isOpen then
				build()
				filter()
			else
				display()
			end
			return self
		end

		boxB.MouseButton1Click:Connect(guardClick(function()
			if isOpen then me.close() else me.open() end
		end))
		attachTip(boxB, info.Tooltip)
		return obj
	end

	function Groupbox:AddInput(flag, info)
		info = info or {}
		self.n = self.n + 1
		local obj = newFlag('Input', { Value = tostring(info.Default or '') })
		Options[flag] = obj

		local holder = new('Frame', {
			BackgroundTransparency = 1,
			Size = UDim2.new(1, 0, 0, 40),
			LayoutOrder = self.n,
			Parent = self.frame,
		})
		label({
			Text = string.lower(tostring(info.Text or flag)),
			Size = UDim2.new(1, 0, 0, 14),
			TextTruncate = Enum.TextTruncate.AtEnd,
			ColorKey = 'Dim',
			Parent = holder,
		})
		local box = new('TextBox', {
			Text = obj.Value,
			PlaceholderText = tostring(info.Placeholder or info.PlaceHolder or ''),
			ClearTextOnFocus = info.ClearTextOnFocus == true,
			TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Position = UDim2.fromOffset(0, 18),
			Size = UDim2.new(1, 0, 0, 22),
			Parent = holder,
		})
		paint(box, 'BackgroundColor3', 'Element')
		paint(box, 'TextColor3', 'Text')
		paint(box, 'PlaceholderColor3', 'Dim')
		typeface(box)
		round(box)
		local stroke = outline(box)
		stroke.Transparency = 1
		new('UIPadding', { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8), Parent = box })
		box.FocusLost:Connect(function() stroke.Transparency = 1 end)

		local writing = false

		local function commit(text)
			obj.Value = text
			if info.Callback then safeCall(info.Callback, text) end
			obj:_emit(text)
		end

		function obj:SetValue(text)
			text = tostring(text or '')
			writing = true
			box.Text = text
			writing = false
			commit(text)
			return self
		end

		box:GetPropertyChangedSignal('Text'):Connect(function()
			if writing then return end
			local text = box.Text
			if info.Numeric and text ~= '' and text ~= '-' and text ~= '.' and not tonumber(text) then
				writing = true
				box.Text = obj.Value
				writing = false
				return
			end
			if info.Finished then return end
			commit(text)
		end)

		box.FocusLost:Connect(function(enter)
			stroke.Color = T.Stroke
			if info.Finished and enter then commit(box.Text) end
		end)

		attachTip(box, info.Tooltip)
		obj.Holder = holder
		return obj
	end


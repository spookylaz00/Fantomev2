	local CONFIG_DIR = ROOT_DIR .. '/Configs'

	local ignoreFlags = { configname = true, configlist = true, uilanguage = true, themename = true, themelist = true, importjson = true, importname = true, themeimportjson = true, themeimportname = true, scriptname = true, scriptlist = true, songlist = true, imagelist = true }

	local function serialize()
		local data = { toggles = {}, options = {} }
		for flag, o in pairs(Toggles) do
			if not ignoreFlags[flag] then data.toggles[flag] = o.Value == true end
		end
		for flag, o in pairs(Options) do
			if not ignoreFlags[flag] then
				local kind = o.Type
				if kind == 'Slider' then
					data.options[flag] = { t = 's', v = o.Value }
				elseif kind == 'Dropdown' then
					if o.Multi then
						local arr = {}
						for name, on in pairs(o.Value or {}) do
							if on then arr[#arr + 1] = name end
						end
						data.options[flag] = { t = 'dm', v = arr }
					else
						data.options[flag] = { t = 'd', v = o.Value }
					end
				elseif kind == 'Input' then
					data.options[flag] = { t = 'i', v = o.Value }
				elseif kind == 'ColorPicker' then
					data.options[flag] = { t = 'c', v = o.Value:ToHex(), a = o.Transparency }
				elseif kind == 'KeyPicker' then
					data.options[flag] = { t = 'k', v = o.Value, m = o.Mode }
				end
			end
		end
		return httpService:JSONEncode(data)
	end

	local function applyConfig(json)
		local ok, data = pcall(function() return httpService:JSONDecode(json) end)
		if not ok or type(data) ~= 'table' then return false end
		for flag, val in pairs(data.toggles or {}) do
			local o = Toggles[flag]
			if o and not ignoreFlags[flag] and o.Value ~= val then o:SetValue(val) end
		end
		for flag, rec in pairs(data.options or {}) do
			local o = Options[flag]
			if o and not ignoreFlags[flag] and type(rec) == 'table' then
				if rec.t == 'c' then
					pcall(function() o:SetValueRGB(Color3.fromHex(rec.v), rec.a) end)
				elseif rec.t == 'k' then
					pcall(function()
						o._bind(rec.v or 'NONE')
						if rec.m then o._setMode(rec.m) end
					end)
				elseif rec.t == 'dm' then
					o:SetValue(rec.v or {})
				else
					o:SetValue(rec.v)
				end
			end
		end
		return true
	end


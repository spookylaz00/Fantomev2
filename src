
do
	local Players = game:GetService("Players")
	local RunService = game:GetService("RunService")
	local TweenService = game:GetService("TweenService")

	local gui = Instance.new("ScreenGui")
	gui.Name = "FantomeLoading"
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.DisplayOrder = 10000
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	pcall(function() if syn and syn.protect_gui then syn.protect_gui(gui) end end)
	local parented = pcall(function() gui.Parent = (gethui and gethui()) or game:GetService("CoreGui") end)
	if not parented or not gui.Parent then gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") end

	local hasBuilder = pcall(function() return Enum.Font.BuilderSansExtraBold end)
	local font = hasBuilder and Enum.Font.BuilderSansExtraBold or Enum.Font.GothamBold

	local dim = Instance.new("Frame")
	dim.Size = UDim2.fromScale(1, 1)
	dim.BackgroundColor3 = Color3.new(0, 0, 0)
	dim.BackgroundTransparency = 0.12
	dim.BorderSizePixel = 0
	dim.Active = true
	dim.Parent = gui

	local logo = Instance.new("ImageLabel")
	logo.BackgroundTransparency = 1
	logo.Image = "rbxassetid://89344647348790"
	logo.AnchorPoint = Vector2.new(0.5, 0.5)
	logo.Position = UDim2.new(0.5, 0, 0.5, -60)
	logo.Size = UDim2.fromOffset(120, 120)
	logo.ScaleType = Enum.ScaleType.Fit
	logo.Parent = dim

	local title = Instance.new("TextLabel")
	title.BackgroundTransparency = 1
	title.AnchorPoint = Vector2.new(0.5, 0.5)
	title.Position = UDim2.new(0.5, 0, 0.5, 40)
	title.Size = UDim2.fromOffset(420, 30)
	title.Font = font
	title.TextSize = 24
	title.TextColor3 = Color3.new(1, 1, 1)
	title.Text = "FANTOME V2 Loading"
	title.Parent = dim

	local status = Instance.new("TextLabel")
	status.BackgroundTransparency = 1
	status.AnchorPoint = Vector2.new(0.5, 0.5)
	status.Position = UDim2.new(0.5, 0, 0.5, 70)
	status.Size = UDim2.fromOffset(420, 18)
	status.Font = font
	status.TextSize = 14
	status.TextColor3 = Color3.fromRGB(170, 170, 180)
	status.Text = "starting"
	status.Parent = dim

	local track = Instance.new("Frame")
	track.AnchorPoint = Vector2.new(0.5, 0.5)
	track.Position = UDim2.new(0.5, 0, 0.5, 98)
	track.Size = UDim2.fromOffset(260, 4)
	track.BackgroundColor3 = Color3.fromRGB(45, 45, 52)
	track.BorderSizePixel = 0
	track.Parent = dim
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Color3.new(1, 1, 1)
	fill.BorderSizePixel = 0
	fill.Parent = track
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

	local t0 = os.clock()
	local finished = false
	local spin = RunService.Heartbeat:Connect(function()
		local t = os.clock() - t0
		local ac = math.abs(math.cos(t * 2.4))
		logo.Size = UDim2.fromOffset(math.max(2, 120 * ac), 120)
		local shade = 0.4 + 0.6 * ac
		logo.ImageColor3 = Color3.new(shade, shade, shade)
		title.Text = "FANTOME V2 Loading" .. string.rep(".", math.floor(t * 2.5) % 4)
	end)

	local FL = {}
	function FL.step(fraction, text)
		if finished then return end
		status.Text = tostring(text or "")
		TweenService:Create(fill, TweenInfo.new(0.25, Enum.EasingStyle.Quad), { Size = UDim2.fromScale(math.clamp(fraction, 0, 1), 1) }):Play()
	end
	function FL.finish()
		if finished then return end
		finished = true
		status.Text = "ready"
		TweenService:Create(fill, TweenInfo.new(0.2), { Size = UDim2.fromScale(1, 1) }):Play()
		task.delay(0.3, function()
			local out = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(dim, out, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(logo, out, { ImageTransparency = 1 }):Play()
			TweenService:Create(title, out, { TextTransparency = 1 }):Play()
			TweenService:Create(status, out, { TextTransparency = 1 }):Play()
			TweenService:Create(track, out, { BackgroundTransparency = 1 }):Play()
			TweenService:Create(fill, out, { BackgroundTransparency = 1 }):Play()
			task.delay(0.45, function()
				spin:Disconnect()
				gui:Destroy()
			end)
		end)
	end
	_G.__FL = FL

	-- safety net: if the script dies halfway the screen must not trap the player
	task.delay(45, function() FL.finish() end)
end


function CreateESP(player)
	if player == Player and not (Toggles.selfesp and Toggles.selfesp.Value) then return end
	if v.ESPObjects[player] then return end
	v.ESPObjects[player] = { Player = player, cv = nil, Bones = nil, BoneChar = nil }
end

function RemoveESP(player)
	local o = v.ESPObjects[player]
	if not o then return end
	if o.cv then pcall(function() o.cv:destroy() end) end
	v.ESPObjects[player] = nil
end

v.TeamSafe = {}
v.TeamEnemy = {}

function IsOnSameTeam(player)
	local t = player and player.Team
	if t then
		local n = t.Name
		if v.TeamEnemy[n] then return false end
		if v.TeamSafe[n] then return true end
	end
	if not Player.Team or not t then return false end
	return Player.Team == t
end

v.IsOnSameTeam = IsOnSameTeam

local function espNoteError(err)
	local msg = tostring(err):gsub("^.-:%d+: ", "")
	if espState.seen[msg] then return end
	espState.seen[msg] = true
	espState.shown = espState.shown + 1
	warn("[illusion] esp: " .. tostring(err))
	if espState.shown <= 2 then
		pcall(function() Library:Notify("esp hit an error: " .. msg:sub(1, 90), 6) end)
	end
end

local espTarget = { projCache = {} }
local espWl = {}

function UpdateESP()
	local objects = v.ESPObjects

	if not (Toggles.espenabled and Toggles.espenabled.Value) then
		for _, o in pairs(objects) do
			if o.cv then o.cv:hide() end
		end
		return
	end

	local want = (Options.esprenderer and Options.esprenderer.Value) or "auto"
	local backend
	if want == "gui" then
		backend = "gui"
	elseif want == "drawing" then
		backend = "drawing"
	else
		if espState.drawingOk == nil then espState.drawingOk = espDrawingWorks() end
		backend = (espState.drawingOk and not espState.forceGui) and "drawing" or "gui"
	end
	if backend ~= espState.backend then
		for _, o in pairs(objects) do
			if o.cv then pcall(function() o.cv:destroy() end) o.cv = nil end
		end
		espState.backend = backend
		espState.errorFrames = 0
	end
	local parent = backend == "gui" and espScreenGui() or nil

	local c = espReadCfg()
	local cam = workspace.CurrentCamera or Camera
	if parent then
		local as = espState.probe.AbsoluteSize
		local vps = cam.ViewportSize
		if as.X > 0 and as.Y > 0 then
			local ox, oy = (vps.X - as.X) * 0.5, vps.Y - as.Y
			if espState.ox ~= ox or espState.oy ~= oy then
				espState.ox, espState.oy = ox, oy
				parent.Position = UDim2.fromOffset(-ox, -oy)
			end
		end
	end
	local function proj(p)
		local s, on = cam:WorldToViewportPoint(p)
		return s.X, s.Y, s.Z, on
	end

	local vp = cam.ViewportSize
	local ox, oy = vp.X * 0.5, vp.Y
	if c.tracers then
		local m = c.tracerMode
		if m == "Mouse" then
			local ml = UserInputService:GetMouseLocation()
			ox, oy = ml.X, ml.Y
		elseif m == "Top" then
			oy = 0
		elseif m == "Center" then
			oy = vp.Y * 0.5
		end
	end

	local myRoot = GetRootPart()
	local myPos = myRoot and myRoot.Position

	if c.whitelist then
		table.clear(espWl)
		for _, name in pairs(v.ESPWhitelistedPlayers or {}) do espWl[name] = true end
	end

	local hadError = false
	local t = espTarget
	t.proj = proj
	t.ox, t.oy = ox, oy

	for _, plr in ipairs(Players:GetPlayers()) do
		local o = objects[plr]
		local drawn = false
		repeat
			if plr == Player and not c.selfesp then break end
			if c.whitelist and espWl[plr.Name] then break end
			local sameTeam = IsOnSameTeam(plr)
			if sameTeam and not c.teamesp then break end
			local char = plr.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local head = char and char:FindFirstChild("Head")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if not (root and head and hum and hum.Health > 0) then break end
			local distance = myPos and (myPos - root.Position).Magnitude or 0
			if c.distLimit and distance > c.maxDist then break end
			if not o then
				CreateESP(plr)
				o = objects[plr]
				if not o then break end
			end
			if not o.cv then o.cv = newCanvas(backend, parent) end
			t.o, t.char, t.root, t.head, t.hum = o, char, root, head, hum
			t.name, t.user, t.dist, t.sameTeam = plr.DisplayName, plr.Name, distance, sameTeam
			local held = c.tool and char:FindFirstChildOfClass("Tool") or nil
			t.tool = held and held.Name or nil
			local cv = o.cv
			cv:begin()
			local ok, err = pcall(espDrawTarget, cv, t, c)
			if not ok then
				hadError = true
				espNoteError(err)
			end
			cv:finish()
			drawn = true
		until true
		if not drawn and o and o.cv then o.cv:hide() end
	end

	if hadError then
		espState.errorFrames = espState.errorFrames + 1
		if backend == "drawing" and want == "auto" and espState.errorFrames >= 3 and not espState.forceGui then
			espState.forceGui = true
			pcall(function() Library:Notify("esp swapped to gui mode, ur drawing api is acting up", 6) end)
		end
	else
		espState.errorFrames = 0
	end
end


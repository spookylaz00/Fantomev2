	-- remember which rows each element created so it can be hidden/shown later
	for _, method in ipairs({ 'AddToggle', 'AddSlider', 'AddDropdown', 'AddInput', 'AddButton', 'AddInfo', 'AddLabel', 'AddColoredLabel', 'AddDivider' }) do
		local original = Groupbox[method]
		if original then
			Groupbox[method] = function(self, ...)
				local before = self.n
				local res = original(self, ...)
				if type(res) == 'table' then
					local rows = {}
					for _, ch in ipairs(self.frame:GetChildren()) do
						if ch:IsA('GuiObject') and ch.LayoutOrder > before and ch.LayoutOrder <= self.n then
							rows[#rows + 1] = ch
						end
					end
					res._rows = rows
				end
				return res
			end
		end
	end

	function Base:SetVisible(on)
		on = on and true or false
		for _, r in ipairs(self._rows or {}) do
			r:SetAttribute('FHidden', not on)
			local parent = r.Parent
			r.Visible = on and not (parent and parent:GetAttribute('Folded') == true)
		end
		return self
	end


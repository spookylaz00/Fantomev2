v.Grad3 = function(t, c1, c2, c3)
    t = math.clamp(t, 0, 1)
    if t < 0.5 then
        return c1:Lerp(c2, t * 2)
    end
    return c2:Lerp(c3, (t - 0.5) * 2)
end

v.Grad3W = function(t, c1, c2, c3)
    t = t % 1
    if t < 1 / 3 then
        return c1:Lerp(c2, t * 3)
    elseif t < 2 / 3 then
        return c2:Lerp(c3, (t - 1 / 3) * 3)
    end
    return c3:Lerp(c1, (t - 2 / 3) * 3)
end

v.FillPalette = function(t, c1, c2, c3)
    local f = t % 1
    if f < 0.5 then
        return c1:Lerp(c2, f * 2)
    end
    return c2:Lerp(c3, (f - 0.5) * 2)
end

v.GradPhase = function()
    if not (Toggles.espgradspin and Toggles.espgradspin.Value) then return 0 end
    local sp = (Options.espgradspinspeed and Options.espgradspinspeed.Value) or 90
    return (tick() * (sp / 360)) % 1
end

v.DrawGradText = function(pool, text, centerX, y, size, c1, c2, c3, phase)
    local len = #text
    if len > #pool then len = #pool end
    local widths, total = {}, 0
    for i = 1, len do
        local d = pool[i]
        d.Size = size
        d.Text = string.sub(text, i, i)
        local w = d.TextBounds and d.TextBounds.X or 0
        if w <= 0 then w = size * 0.5 end
        widths[i] = w
        total = total + w
    end
    local x = centerX - total * 0.5
    local denom = math.max(1, len - 1)
    for i = 1, len do
        local d = pool[i]
        d.Position = Vector2.new(x, y)

        if phase and phase ~= 0 then
            d.Color = v.Grad3W((i - 1) / denom + phase, c1, c2, c3)
        else
            d.Color = v.Grad3((i - 1) / denom, c1, c2, c3)
        end
        d.Visible = true
        x = x + widths[i]
    end
    for i = len + 1, #pool do
        pool[i].Visible = false
    end
end


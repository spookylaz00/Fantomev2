        "readfile", "loadfile", "dofile", "listfiles",
        "request", "http_request", "HttpGet", "HttpPost", "WebSocket",
        "setclipboard", "gethwid", "identifyexecutor", "saveinstance",
        "queue_on_teleport", "TeleportService", "Kick",
        "firesignal", "replicatesignal", "fireclickdetector", "firetouchinterest",

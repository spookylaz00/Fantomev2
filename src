    v.visualizerMove = function(position)
        local model = v.visualizerPart
        local sourceRoot = v.visualizerRoot
        if not (model and model.Parent and sourceRoot and sourceRoot.Parent) then return end
		local base = typeof(position) == "CFrame" and position or CFrame.new(position)
		local pos = base.Position

        if not v.desyncFinite(pos) then return end
		local cf = CFrame.new(pos) * base.Rotation
        v.visualizerFrame = cf
        for i = 1, #v.visualizerPairs do
            local pair = v.visualizerPairs[i]
            local source, copy = pair[1], pair[2]
            if source and source.Parent and copy and copy.Parent then
                copy.CFrame = cf * sourceRoot.CFrame:ToObjectSpace(source.CFrame)
            end
        end
    end


function Localization.getEntry(text)
	local caption = tostring(text or "")
	return Localization.entries[string.lower(caption)] or { en = caption }
end

function Localization.resolve(entry)
	return entry[Localization.code] or entry.en or ""
end

function Localization.bind(instance, entry, owner)
	local text = Localization.resolve(entry)
	Localization.bindings[instance] = { entry = entry, owner = owner, rendered = text }
	instance.Text = text
	if owner then owner.Text = text end
end

function Localization.setLanguage(code, persist)
	local found = false
	for _, locale in ipairs(Localization.locales) do
		if locale.code == code then found = true break end
	end
	if not found then return false end
	Localization.code = code
	for instance, binding in pairs(Localization.bindings) do
		if instance.Parent and (binding.owner or instance.Text == binding.rendered) then
			local text = Localization.resolve(binding.entry)
			instance.Text = text
			binding.rendered = text
			if binding.owner then binding.owner.Text = text end
		end
	end
	if persist and type(writefile) == "function" and type(makefolder) == "function" then
		pcall(function()
			if type(isfolder) ~= "function" or not isfolder(REATH_ROOT) then makefolder(REATH_ROOT) end
		if type(isfolder) ~= "function" or not isfolder(REATH_ROOT .. "/Other") then makefolder(REATH_ROOT .. "/Other") end
writefile(REATH_ROOT .. "/Other/language.txt", code)
		end)
	end
	return true
end

function Localization.load()
	if type(readfile) ~= "function" or type(isfile) ~= "function" then return end
	pcall(function()
		local path = REATH_ROOT .. "/Other/language.txt"
if not isfile(path) then path = REATH_ROOT .. "/language.txt" end
if not isfile(path) then path = "ReathZ/language.txt" end
if not isfile(path) then return end
local code = readfile(path):match("^%s*(.-)%s*$")
		Localization.setLanguage(code, false)
	end)
end

function Localization.buildSettings(tab, side)
	local box = (side == "left" and tab:AddLeftGroupbox("language") or tab:AddRightGroupbox("language"))
	local values, codesByLabel = {}, {}
	local selected = Localization.code
	local defaultLabel
	for _, locale in ipairs(Localization.locales) do
		local display = locale.label
		values[#values + 1] = display
		codesByLabel[display] = locale.code
		if locale.code == selected then defaultLabel = display end
	end
	box:AddDropdown("uilanguage", {
		Text = "language",
		Values = values,
		Default = defaultLabel,
		Multi = false,
		AllowNull = false,
		Searchable = true,
		Callback = function(display)
			selected = codesByLabel[display] or Localization.code
		end,
	})
	box:AddButton({
		Text = "select",
		Func = function()
			Localization.setLanguage(selected, true)
		end,
	})
end


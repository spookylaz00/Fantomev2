function v.npcIsRig(model)
    if typeof(model) ~= "Instance" or not model:IsA("Model") then return false end
    if Players:GetPlayerFromCharacter(model) then return false end
    if not model:FindFirstChildOfClass("Humanoid") then return false end
    return true
end

function v.npcRoot(model)
    if not model or not model.Parent then return nil end
    return model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("UpperTorso")
        or model.PrimaryPart
        or model:FindFirstChildWhichIsA("BasePart")
end

function v.npcHead(model, prefer)
    if not model then return nil end

    local function part(name)
        local found = name and model:FindFirstChild(name)
        if found and found:IsA("BasePart") then return found end
        return nil
    end

    return part(prefer) or part("Head") or v.npcRoot(model)
end

function v.npcAlive(model)
    local hum = model and model.Parent and model:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0
end

function v.npcLabel(model)
    if not model then return "" end
    return v.Npc.Renames[model] or model.Name
end

function v.npcPath(inst)
    if not inst then return "" end
    local ok, full = pcall(function() return inst:GetFullName() end)
    if ok and type(full) == "string" then return "game." .. full end
    return inst.Name
end

function v.npcScan(query)
    local out, n = {}, 0
    local q = tostring(query or ""):lower()

    for _, inst in ipairs(workspace:GetDescendants()) do
        if v.npcIsRig(inst) then
            local label = v.npcLabel(inst):lower()
            if q == "" or label:find(q, 1, true) or inst.Name:lower():find(q, 1, true) then
                n = n + 1
                out[n] = inst
            end
        end
    end

    local myRoot = GetRootPart()
    if myRoot then
        table.sort(out, function(a, b)
            local ra, rb = v.npcRoot(a), v.npcRoot(b)
            local da = ra and (ra.Position - myRoot.Position).Magnitude or math.huge
            local db = rb and (rb.Position - myRoot.Position).Magnitude or math.huge
            return da < db
        end)
    end

    return out
end

function v.npcNearestMouse(list)
    local best, bestDist = nil, math.huge
    local mp = UserInputService:GetMouseLocation()
    local cam = workspace.CurrentCamera or Camera

    for _, model in ipairs(list) do
        if v.npcAlive(model) then
            local root = v.npcRoot(model)
            if root then
                local sp, onScreen = cam:WorldToViewportPoint(root.Position)
                if onScreen and sp.Z > 0 then
                    local d = (Vector2.new(sp.X, sp.Y) - mp).Magnitude
                    if d < bestDist then bestDist = d best = model end
                end
            end
        end
    end

    return best
end

function v.npcNearestMe(list)
    local myRoot = GetRootPart()
    if not myRoot then return nil end

    local best, bestDist = nil, math.huge
    for _, model in ipairs(list) do
        if v.npcAlive(model) then
            local root = v.npcRoot(model)
            if root then
                local d = (root.Position - myRoot.Position).Magnitude
                if d < bestDist then bestDist = d best = model end
            end
        end
    end

    return best
end

function v.npcPick()
    local list = v.Npc.Matches
    if #list == 0 then return nil end
    if v.Npc.PickMode == "near me" then return v.npcNearestMe(list) end
    return v.npcNearestMouse(list) or v.npcNearestMe(list)
end

function v.npcTeleport()
    local model = v.Npc.Selected
    local dst = v.npcRoot(model)
    local src = GetRootPart()
    if not (dst and src) then return false end
    pcall(function()
        src.CFrame = dst.CFrame * CFrame.new(0, 0, 3)
        src.AssemblyLinearVelocity = Vector3.zero
    end)
    return true
end

function v.npcView(on)
    if v.Npc.ViewConn then
        v.Npc.ViewConn:Disconnect()
        v.Npc.ViewConn = nil
    end
    if not on then
        pcall(function() v.restoreCamera(0.35) end)
        return
    end

    local model = v.Npc.Selected
    if not model then return false end
    pcall(function() v.saveCamera() end)

    v.Npc.ViewConn = RunService.RenderStepped:Connect(function()
        local root = v.npcRoot(v.Npc.Selected)
        if not root then return end
        local cam = workspace.CurrentCamera or Camera
        cam.CameraSubject = root
    end)
    return true
end

function v.npcCopy(text)
    local fn = setclipboard or toclipboard or (syn and syn.write_clipboard)
    if not fn then return false end
    pcall(fn, tostring(text))
    return true
end

function v.npcOpt(mirror, tabKey, ownKey, fallback)
    if mirror then
        local o = Options[tabKey]
        if o ~= nil and o.Value ~= nil then return o.Value end
        local t = Toggles[tabKey]
        if t ~= nil and t.Value ~= nil then return t.Value end
        return fallback
    end
    local own = v.Npc.Set[ownKey]
    if own ~= nil then return own end
    return fallback
end


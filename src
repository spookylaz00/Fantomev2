    local function doFakeChat()
        local msg = Options.fakechatmsg and Options.fakechatmsg.Value or ""
        if msg == "" then
            Library:Notify('enter a message', 3)
            return false
        end

        if Toggles.fakechattargetall and Toggles.fakechattargetall.Value then
            local count = 0
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
                if plr ~= Player then
                    sendFakeForPlayer(plr, msg)
                    count += 1
                end
            end
        else
            local query = Options.fakechatuser and Options.fakechatuser.Value or ""
            if query == "" then
                Library:Notify('enter a target username', 3)
                return false
            end
            local target = nil
            local queryLower = query:lower()
            for _, plr in ipairs(game:GetService("Players"):GetPlayers()) do
